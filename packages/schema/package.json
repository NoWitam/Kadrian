{
  "name": "@kadrion/schema",
  "version": "0.8.0",
  "private": true,
  "description": "JSON Schema, TypeScript types, validation, migrations.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./template": {
      "types": "./dist/template.d.ts",
      "default": "./dist/template.js"
    },
    "./time-map": {
      "types": "./dist/time-map.d.ts",
      "default": "./dist/time-map.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "devDependencies": {
    "@kadrion/test-fixtures": "workspace:*",
    "ajv": "8.20.0"
  }
}
