[
  {
    "name": "describe_document",
    "description": "Describes the current document and changes nothing. Returns the canvas size in composition pixels, fps, and durationUs; every scene in the order they play, with its ID, its startUs in the composition (derived: the sum of the durations before it), its durationUs, its audio clips in scene time, and its nodes from the bottom layer to the top, each with its ID, type, parentId, layer (0 is the bottom), startUs and durationUs in integer microseconds of the time of its scene, its stored fields (position, scale, opacity, animations with their keyframes, text, colour, and so on; the html of a Custom HTML element is left out), and a group's children; and the declared assets and the composition's clips, in composition time, where a video or audio asset also states its sourceDurationUs, the length of its source in integer microseconds, when the host knows it, and a video its soundDurationUs, the length of its sound, or null when it has none. Call it before editing to learn the IDs that other tools take.\n\nExample arguments: {}",
    "inputSchema": {
      "type": "object",
      "description": "No arguments.",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_position",
    "description": "Moves one node to an absolute base position: x from the left edge, y from the top edge, of the canvas, or of its group for a node inside a group. Lengths and coordinates are composition pixels, rounded to integers. A position animation of the node adds its offsets on top of this base. Refused with unknown-node when no node has the ID, unsupported-node for a node without a position (the background), and invalid-result when the document cannot hold the position. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"position\":{\"x\":120,\"y\":240}}",
    "inputSchema": {
      "type": "object",
      "description": "Moves one node to an absolute base position.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node to move. A node without a position, such as the background, is refused.",
          "minLength": 1
        },
        "position": {
          "type": "object",
          "description": "The node's new base position, absolute, in composition pixels. A position animation adds its offsets on top of it.",
          "properties": {
            "x": {
              "type": "number",
              "description": "Distance from the left edge, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity (2.5 becomes 3, -2.5 becomes -2), and -0 becomes 0."
            },
            "y": {
              "type": "number",
              "description": "Distance from the top edge, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity (2.5 becomes 3, -2.5 becomes -2), and -0 becomes 0."
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "position"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_opacity",
    "description": "Sets one node's base opacity, from 0 (transparent) to 1 (opaque) inclusive. An opacity animation of the node multiplies it. Refused with invalid-argument outside 0 to 1, unknown-node when no node has the ID, and unsupported-node for a node without an opacity (the background). The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"opacity\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets one node's base opacity.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. A node without an opacity, such as the background, is refused.",
          "minLength": 1
        },
        "opacity": {
          "type": "number",
          "description": "The base opacity, from 0 (transparent) to 1 (opaque) inclusive; a fraction is kept as it is, and -0 becomes 0. An opacity animation multiplies it.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "nodeId",
        "opacity"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_content",
    "description": "Replaces the text of one text node, exactly as given: nothing is trimmed, and line breaks (\\n) are kept. Refused with unknown-node when no node has the ID and unsupported-node for a node that is not a text. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"text\":\"Hello\"}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces the text of one text node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a text node. Any other node is refused.",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "description": "The new text, exactly as given: nothing is trimmed or normalised, and line breaks are kept."
        }
      },
      "required": [
        "nodeId",
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_node",
    "description": "Inserts one complete node into a scene, or into a group, at a layer index: 0 is the bottom layer and the length of the list the top. The node is given exactly as the document stores it, with every field of its type (describe_document shows the stored fields of existing nodes): an ID unused in the document, its type (text, image, video, group, or custom-html), startUs and durationUs, position, scale, opacity, animations, and its own fields. A group takes text, image, and video nodes only. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. A video must sample inside its source. Refused with unknown-parent, unsupported-node when the parent takes no children, index-out-of-range, id-in-use with the IDs already taken, and invalid-result when the node is not one the document can hold; a video also with media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"parentId\":\"scene-main\",\"index\":4,\"node\":{\"id\":\"node-subtitle\",\"type\":\"text\",\"startUs\":1000000,\"durationUs\":4000000,\"position\":{\"x\":90,\"y\":400},\"scale\":{\"x\":1,\"y\":1},\"opacity\":1,\"animations\":[],\"text\":\"Made with Kadrion\",\"fontAssetId\":\"asset-font\",\"fontSize\":64,\"color\":\"#ffffff\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete node, with its animations and children, into a list.",
      "properties": {
        "parentId": {
          "type": "string",
          "description": "The ID of the scene, or of a group, whose list receives the node. A group takes image and text nodes only.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The node's index in that list after the insertion, from 0 (the bottom layer) to the list's length (the top).",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "node": {
          "type": "object",
          "description": "The complete node as the document stores it, with every ID of its subtree chosen by the caller and unused in the document, and its animations in its own `animations` array."
        }
      },
      "required": [
        "parentId",
        "index",
        "node"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_node",
    "description": "Removes one node together with its animations and, for a group, its children. Refused with unknown-node when no node has the ID and invalid-result when the document would no longer be valid without it. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-custom-html\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a node with its animations and, for a group, its children.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "duplicate_node",
    "description": "Copies one node, with its animations and children, into the same list directly above the original. The copy takes newNodeId; a child at index i of the copy becomes <newNodeId>-c<i>, an animation <newNodeId>-a-<property>. Refused with unknown-node, id-in-use when an ID of the copy is taken, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"newNodeId\":\"node-title-copy\"}",
    "inputSchema": {
      "type": "object",
      "description": "Copies a node, with its animations and children, directly above it.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node.",
          "minLength": 1
        },
        "newNodeId": {
          "type": "string",
          "description": "The ID of the copy, unused in the document. Every other ID of the copy derives from it: a child at index i becomes `<newNodeId>-c<i>`, an animation `<newNodeId>-a-<property>`, and an animation of that child `<newNodeId>-c<i>-a-<property>`.",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "nodeId",
        "newNodeId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "reorder_node",
    "description": "Moves one node to another index of its own list, which changes the layer order: 0 is the bottom layer and the length of the list minus 1 the top. It never moves a node into or out of a group. Refused with unknown-node and index-out-of-range. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"index\":1}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a node within its own list, which changes the layer order.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The node's index in its own list after the move, from 0 (the bottom layer) to the list's length minus 1 (the top).",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_scale",
    "description": "Sets one node's base scale about its top-left corner: 1 is the natural size, from 0 to 1000 on each axis. A scale animation of the node multiplies it. Refused with invalid-argument outside 0 to 1000, unknown-node, and unsupported-node for a node without a scale (the background). The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"scale\":{\"x\":1.5,\"y\":1.5}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets one node's base scale.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. A node without a scale, such as the background, is refused.",
          "minLength": 1
        },
        "scale": {
          "type": "object",
          "description": "The node's new base scale about its own origin. A scale animation multiplies it.",
          "properties": {
            "x": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive, kept as it is; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            },
            "y": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive, kept as it is; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "scale"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_size",
    "description": "Sets the width and height of an image, a video, or a Custom HTML element, from 1 to 1000000 each. Lengths and coordinates are composition pixels, rounded to integers. A text has no size; change its font size instead. Refused with invalid-argument for a size outside the range after rounding, unknown-node, and unsupported-node for any other node. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"width\":480,\"height\":270}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the size of an image, a video, or a Custom HTML element.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images, videos, and Custom HTML elements have a size.",
          "minLength": 1
        },
        "width": {
          "type": "number",
          "description": "The width, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity, and -0 becomes 0; the document takes 1 to 1 000 000, and a rounded value outside that range is refused."
        },
        "height": {
          "type": "number",
          "description": "The height, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity, and -0 becomes 0; the document takes 1 to 1 000 000, and a rounded value outside that range is refused."
        }
      },
      "required": [
        "nodeId",
        "width",
        "height"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_color",
    "description": "Sets the colour of a text or a background, as # and six hexadecimal digits (sRGB), stored in lower case. Refused with invalid-argument for short forms, names, or alpha, unknown-node, and unsupported-node for a node without a colour. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"color\":\"#ffcc00\"}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the colour of a text or a background.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only texts and backgrounds have a colour.",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "description": "An sRGB colour as `#` and six hexadecimal digits, in either case; it is stored in lower case. Short forms, names, and alpha are refused.",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "nodeId",
        "color"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_font_size",
    "description": "Sets the font size of a text, from 1 to 1000000. Lengths and coordinates are composition pixels, rounded to integers. Refused with invalid-argument outside the range after rounding, unknown-node, and unsupported-node for a node that is not a text. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"fontSize\":96}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the font size of a text.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only texts have a font size.",
          "minLength": 1
        },
        "fontSize": {
          "type": "number",
          "description": "The font size, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity, and -0 becomes 0; the document takes 1 to 1 000 000, and a rounded value outside that range is refused."
        }
      },
      "required": [
        "nodeId",
        "fontSize"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_font",
    "description": "Points a text at another font asset that the document declares (add one with add_asset first). Refused with unknown-node, unsupported-node for a node that is not a text, unknown-asset, and asset-type-mismatch when the asset is not a font. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"fontAssetId\":\"asset-font-bold\"}",
    "inputSchema": {
      "type": "object",
      "description": "Points a text at another font asset of the document.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only texts have a font.",
          "minLength": 1
        },
        "fontAssetId": {
          "type": "string",
          "description": "The ID of a font asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId",
        "fontAssetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_image_asset",
    "description": "Points an image node at another image asset that the document declares; the node keeps its size. Refused with unknown-node, unsupported-node for a node that is not an image, unknown-asset, and asset-type-mismatch when the asset is not an image. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"assetId\":\"asset-photo\"}",
    "inputSchema": {
      "type": "object",
      "description": "Points an image at another image asset of the document; its size stays.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images have an image asset.",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "description": "The ID of an image asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId",
        "assetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_asset",
    "description": "Declares an image, audio, font, or video asset at an index of the document's assets, under an unused ID and the SHA-256 of its exact bytes. Declare only assets whose bytes the host has: the host must supply them whenever the document is loaded, even while nothing uses the asset. Refused with id-in-use and index-out-of-range. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"asset\":{\"id\":\"asset-photo\",\"type\":\"image\",\"contentHash\":\"sha256:2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae\"},\"index\":3}",
    "inputSchema": {
      "type": "object",
      "description": "Declares an asset, pinned by the hash of its exact bytes. The host must then supply those bytes whenever the document is loaded, even while nothing uses the asset.",
      "properties": {
        "asset": {
          "type": "object",
          "description": "The asset as the document stores it.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The ID of the asset, unused in the document.",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "type": {
              "type": "string",
              "description": "The kind of the asset.",
              "enum": [
                "image",
                "audio",
                "font",
                "video"
              ]
            },
            "contentHash": {
              "type": "string",
              "description": "The algorithm, a colon, and the lower-case hex digest of the exact bytes.",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "type",
            "contentHash"
          ],
          "additionalProperties": false
        },
        "index": {
          "type": "integer",
          "description": "The asset's index in the document's assets after the insertion, from 0 to their number.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "asset",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_asset",
    "description": "Removes an asset that nothing uses. Refused with unknown-asset, and with asset-in-use, whose details list the IDs of its users: point them at another asset or remove them first. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"assetId\":\"asset-photo\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes an asset that nothing uses; an asset in use is refused with its users.",
      "properties": {
        "assetId": {
          "type": "string",
          "description": "The ID of an asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "assetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_animation",
    "description": "Adds one complete animation to a node, at an index of its animations: an ID unused in the document; the property (position, scale, or opacity), which the node must not animate yet; the interpolation (\"linear\"); and at least two keyframes in ascending time, each {timeUs, value}. A position value is an offset {x, y} in pixels added to the base position, a scale value factors {x, y} multiplied with the base scale, an opacity value a factor from 0 to 1. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with unknown-node, unsupported-node for a node without animations (the background), duplicate-animation-target, index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-custom-html\",\"index\":0,\"animation\":{\"id\":\"anim-html-opacity\",\"property\":\"opacity\",\"interpolation\":\"linear\",\"keyframes\":[{\"timeUs\":0,\"value\":0},{\"timeUs\":1000000,\"value\":1}]}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete animation into a node's animations.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. The background has no animations.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The animation's index in the node's animations after the insertion.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "animation": {
          "type": "object",
          "description": "The complete animation as the document stores it: its ID, unused in the document; its property, which the node must not animate already; its interpolation; and its keyframes."
        }
      },
      "required": [
        "nodeId",
        "index",
        "animation"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_animation",
    "description": "Removes one animation with all its keyframes; the node keeps its base values. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes one animation with all its keyframes.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        }
      },
      "required": [
        "animationId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_opacity_keyframe",
    "description": "Sets the opacity factor (0 to 1) of an opacity animation at a time: replaces the value of the keyframe at that time, or inserts one. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation and animation-property-mismatch when the animation does not animate opacity. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"timeUs\":5000000,\"opacity\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the keyframe at a time of an opacity animation, inserting it when none is there.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document. It must animate opacity.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "opacity": {
          "type": "number",
          "description": "The opacity factor, from 0 to 1 inclusive, kept as it is; -0 becomes 0.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "opacity"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_position_keyframe",
    "description": "Sets the offset {x, y} of a position animation at a time, added to the node's base position: replaces the value of the keyframe at that time, or inserts one. Lengths and coordinates are composition pixels, rounded to integers. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation and animation-property-mismatch when the animation does not animate position. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-group-position\",\"timeUs\":5000000,\"offset\":{\"x\":40,\"y\":200}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the keyframe at a time of a position animation, inserting it when none is there.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document. It must animate position.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "object",
          "description": "The offset added to the node's base position, in composition pixels; each coordinate is rounded to an integer, halves towards +Infinity, and -0 becomes 0.",
          "properties": {
            "x": {
              "type": "number",
              "description": "The horizontal offset."
            },
            "y": {
              "type": "number",
              "description": "The vertical offset."
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "offset"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_scale_keyframe",
    "description": "Sets the factors {x, y} of a scale animation at a time, from 0 to 1000, multiplied with the node's base scale: replaces the value of the keyframe at that time, or inserts one. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation and animation-property-mismatch when the animation does not animate scale. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-image-scale\",\"timeUs\":5000000,\"factor\":{\"x\":1.1,\"y\":1.1}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the keyframe at a time of a scale animation, inserting it when none is there.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document. It must animate scale.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "factor": {
          "type": "object",
          "description": "The factors multiplied with the node's base scale.",
          "properties": {
            "x": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            },
            "y": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "factor"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_keyframe",
    "description": "Inserts one keyframe given exactly as the document stores it, {timeUs, value}, into an animation, at the place its time gives it; the value must fit the animated property. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, keyframe-exists when the time is taken, and invalid-result for a value of the wrong form. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"keyframe\":{\"timeUs\":9000000,\"value\":0.5}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a keyframe given as exact data at the place its time gives it; its value is judged by the document.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        },
        "keyframe": {
          "type": "object",
          "description": "The keyframe as the document stores it: its time, which must be free, and its value.",
          "properties": {
            "timeUs": {
              "type": "integer",
              "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "timeUs"
          ]
        }
      },
      "required": [
        "animationId",
        "keyframe"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_keyframe",
    "description": "Removes the keyframe at a time from an animation. An animation keeps at least two keyframes; remove the whole animation instead. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, unknown-keyframe, and too-few-keyframes. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"timeUs\":5000000}",
    "inputSchema": {
      "type": "object",
      "description": "Removes the keyframe at a time; refused when the animation would keep fewer keyframes than the document allows.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "animationId",
        "timeUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_keyframe",
    "description": "Moves the keyframe at timeUs of an animation to toTimeUs, keeping its value. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, unknown-keyframe, and keyframe-exists when toTimeUs is taken. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"timeUs\":7500000,\"toTimeUs\":6000000}",
    "inputSchema": {
      "type": "object",
      "description": "Gives the keyframe at a time another time, which must be free.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toTimeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "toTimeUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_lifetime",
    "description": "Sets when a node is shown: from startUs, for durationUs (at least 1). Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. The part after the end of the composition is cut. It moves no keyframe: keyframe times stay composition times. A video keeps its sourceStartUs, so its lifetime must fit inside its source. Refused with unknown-node, invalid-result, and for a video media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"startUs\":1000000,\"durationUs\":5000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets when a node is shown: from startUs, for durationUs, in the time of its scene. It moves no keyframe of the node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Every node has a lifetime, the background included.",
          "minLength": 1
        },
        "startUs": {
          "type": "integer",
          "description": "The scene time from which the node is active, in integer microseconds from the start of its scene; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationUs": {
          "type": "integer",
          "description": "How long the node is active, in integer microseconds, at least 1; whatever lies past the end of its scene is cut, and it is never rounded.",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "startUs",
        "durationUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_fit",
    "description": "Sets how the picture of an image or a video meets the box of its node: fill stretches it to the box, contain shows all of it inside the box, cover fills the box and crops; contain and cover keep the aspect ratio and centre the picture. Refused with invalid-argument for another fit, unknown-node, and unsupported-node for a node that is neither an image nor a video. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"fit\":\"cover\"}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how the picture of an image or a video meets the box of its node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images and videos have a fit.",
          "minLength": 1
        },
        "fit": {
          "type": "string",
          "description": "fill stretches the picture to the box; contain shows all of it inside the box; cover fills the box and crops. contain and cover keep the aspect ratio and centre the picture.",
          "enum": [
            "fill",
            "contain",
            "cover"
          ]
        }
      },
      "required": [
        "nodeId",
        "fit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_video_asset",
    "description": "Points a video node at another video asset that the document declares (add one with add_asset first); its source start, size, and fit stay. The part of the source the node samples must lie inside the new video: describe_document reports a video's sourceDurationUs when the host knows it. Refused with unknown-node, unsupported-node for a node that is not a video, unknown-asset, asset-type-mismatch when the asset is not a video, media-facts-missing when the host does not know the video's duration, and source-range-exceeded when the node would sample past its end. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-video\",\"assetId\":\"asset-clip\"}",
    "inputSchema": {
      "type": "object",
      "description": "Points a video at another video asset of the document; its source start, size, and fit stay.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only videos have a video asset.",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "description": "The ID of a video asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId",
        "assetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_video_source",
    "description": "Sets the source time a video node shows at the start of its lifetime; it then plays at speed 1. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Source times count from the video's first frame. The node samples sourceStartUs up to sourceStartUs plus the part of its lifetime inside its scene, which must lie inside the video: describe_document reports its sourceDurationUs when the host knows it. To trim the start of a clip by d, add d to startUs and sourceStartUs and subtract it from durationUs in one transaction. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not a video, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-video\",\"sourceStartUs\":2000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the source time a video shows at the start of its lifetime; speed is 1.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only videos have a source.",
          "minLength": 1
        },
        "sourceStartUs": {
          "type": "integer",
          "description": "The source time shown at the start of the lifetime, in integer microseconds from the first frame of the video; it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "sourceStartUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_video_volume",
    "description": "Sets how loud the sound of a video node is heard: a linear factor of the amplitude from 0 (silent) to 1 (the source as it is); it never amplifies. A video above 0 is heard from the source time it shows, and its asset must then have exactly one audio stream that starts with its picture, long enough for what is heard: describe_document reports a video's soundDurationUs when the host knows it, null when it has no sound. Refused with invalid-argument outside 0 to 1, unknown-node, unsupported-node for a node that is not a video, media-facts-missing when the host does not know the video's sound, and source-range-exceeded when the node would hear past its end or the video has no sound. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-video\",\"volume\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how loud the sound of a video is heard; 0 is silent.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only videos have a volume.",
          "minLength": 1
        },
        "volume": {
          "type": "number",
          "description": "The linear factor of the amplitude, from 0 (silent) to 1 (the source as it is) inclusive; it never amplifies. A fraction is kept as it is, and -0 becomes 0.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "nodeId",
        "volume"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_audio_clip",
    "description": "Adds one complete audio clip at an index of the document's clips; every clip is heard, mixed by adding, whatever the order. The clip is given exactly as the document stores it: an ID unused in the document, type \"audio\", the ID of an audio asset the document declares (add one with add_asset first), startUs and durationUs (at least 1) in composition time, sourceStartUs (the source time heard at startUs; speed is 1), volume from 0 to 1, and fadeInUs and fadeOutUs, linear, which together take at most durationUs. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. The part after the end of the composition is cut; the source must be long enough for the part that is heard: describe_document reports an audio asset's sourceDurationUs when the host knows it. Refused with index-out-of-range, id-in-use, invalid-result, media-facts-missing when the host does not know the asset's duration, and source-range-exceeded when the clip would hear past its end. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":1,\"clip\":{\"id\":\"clip-voice\",\"type\":\"audio\",\"assetId\":\"asset-audio\",\"startUs\":2000000,\"durationUs\":3000000,\"sourceStartUs\":500000,\"volume\":0.8,\"fadeInUs\":250000,\"fadeOutUs\":1000000}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete audio clip into the document's clips.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The clip's index in the document's clips after the insertion, from 0 to their number. Clips are mixed whatever their order.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clip": {
          "type": "object",
          "description": "The complete clip as the document stores it: its ID, unused in the document; type audio; the ID of an audio asset; startUs and durationUs in composition time; sourceStartUs; volume; fadeInUs and fadeOutUs."
        }
      },
      "required": [
        "index",
        "clip"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_audio_clip",
    "description": "Removes one audio clip, of the composition's clips or of a scene's; its asset stays declared. Refused with unknown-clip. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes one audio clip.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        }
      },
      "required": [
        "clipId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_volume",
    "description": "Sets the volume of one audio clip: a linear factor of the amplitude from 0 (silent) to 1 (the source as it is); it never amplifies. Refused with invalid-argument outside 0 to 1 and unknown-clip. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"volume\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the volume of one audio clip; 0 is silent.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        },
        "volume": {
          "type": "number",
          "description": "The linear factor of the amplitude, from 0 (silent) to 1 (the source as it is) inclusive; it never amplifies. A fraction is kept as it is, and -0 becomes 0.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "clipId",
        "volume"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_fades",
    "description": "Sets the linear fade-in and fade-out of one audio clip: the clip rises from silence to its volume over the first fadeInUs of its lifetime and falls back to silence over the last fadeOutUs, counted in its whole lifetime even where its scene or the composition cuts it. 0 is no fade, and both together take at most the clip's durationUs. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, and invalid-result when the fades exceed the duration. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"fadeInUs\":500000,\"fadeOutUs\":2000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the linear fade-in and fade-out of one audio clip.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        },
        "fadeInUs": {
          "type": "integer",
          "description": "How long the clip rises from silence to its volume at its start, in integer microseconds of the lifetime of the clip, 0 for none; it is never rounded, and -0 becomes 0. Both fades together take at most the clip's durationUs.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fadeOutUs": {
          "type": "integer",
          "description": "How long the clip falls from its volume to silence at its end, in integer microseconds of the lifetime of the clip, 0 for none; it is never rounded, and -0 becomes 0. Both fades together take at most the clip's durationUs.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "fadeInUs",
        "fadeOutUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_source",
    "description": "Points one audio clip at an audio asset the document declares, which may be the one it has, and sets the source time heard at the clip's start; it then plays at speed 1 and keeps its lifetime. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Source times count from the first sample. To move a clip in time, run remove_audio_clip and add_audio_clip in one transaction. The part heard must lie inside the source: describe_document reports an audio asset's sourceDurationUs when the host knows it. Refused with invalid-argument, unknown-clip, unknown-asset, asset-type-mismatch when the asset is not audio, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"assetId\":\"asset-audio\",\"sourceStartUs\":1000000}",
    "inputSchema": {
      "type": "object",
      "description": "Points one audio clip at an audio asset and the source time it plays from; its lifetime stays.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "description": "The ID of an audio asset the document declares; it may be the one it has.",
          "minLength": 1
        },
        "sourceStartUs": {
          "type": "integer",
          "description": "The source time heard at the start of the clip, in integer microseconds from the first sample; it is never rounded, and -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "assetId",
        "sourceStartUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_scene",
    "description": "Inserts one complete scene at an index of the sequence. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, and the composition's durationUs is the sum of the scenes' durations, which every scene command keeps. The scene is given exactly as the document stores it: an ID unused in the document, durationUs (at least 1), its nodes from the bottom layer to the top (each as add_node takes one), and its audio clips (each as add_scene_audio_clip takes one), every ID unused in the document. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with index-out-of-range, id-in-use with the IDs already taken, and invalid-result when the scene is not one the document can hold; a scene with video or sound also with media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":1,\"scene\":{\"id\":\"scene-outro\",\"durationUs\":3000000,\"nodes\":[{\"id\":\"node-outro-background\",\"type\":\"background\",\"startUs\":0,\"durationUs\":3000000,\"color\":\"#000000\"}],\"clips\":[]}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete scene into the sequence; the composition's durationUs grows by the scene's.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The scene's index in the sequence after the insertion, from 0 (the first scene) to the number of scenes (after the last).",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scene": {
          "type": "object",
          "description": "The complete scene as the document stores it: its ID, durationUs, nodes, and clips, every ID of it chosen by the caller and unused in the document, every time in it scene time."
        }
      },
      "required": [
        "index",
        "scene"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_scene",
    "description": "Removes one scene with its nodes and clips; its assets stay declared. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, and the composition's durationUs is the sum of the scenes' durations, which every scene command keeps. Every later scene starts earlier by the removed scene's duration. Refused with unknown-scene, and last-scene for the only scene of the document. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-outro\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a scene with its nodes and clips; the composition's durationUs shrinks by the scene's. The last scene cannot be removed.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        }
      },
      "required": [
        "sceneId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "duplicate_scene",
    "description": "Copies one scene, with its nodes, animations, and clips, directly after it. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, and the composition's durationUs is the sum of the scenes' durations, which every scene command keeps. The copy's IDs derive from newSceneId: the node at index i becomes <newSceneId>-n<i>, its child at index j <newSceneId>-n<i>-c<j>, an animation <owner>-a-<property>, and the clip at index k <newSceneId>-k<k>. Refused with invalid-argument for an ID not of the document's form, unknown-scene, id-in-use with the derived IDs already taken, and invalid-result; a scene with video or sound also with media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-main\",\"newSceneId\":\"scene-again\"}",
    "inputSchema": {
      "type": "object",
      "description": "Copies a scene, with its nodes and clips, directly after it; the composition's durationUs grows by the scene's.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "newSceneId": {
          "type": "string",
          "description": "The ID of the copy, unused in the document. Every other ID of the copy derives from it: the node at index i becomes `<newSceneId>-n<i>`, its child at index j `<newSceneId>-n<i>-c<j>`, an animation `<owner>-a-<property>`, and the clip at index k `<newSceneId>-k<k>`.",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "sceneId",
        "newSceneId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "reorder_scene",
    "description": "Moves one scene to another index of the sequence: 0 is the first scene. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, and the composition's durationUs is the sum of the scenes' durations, which every scene command keeps. Nothing inside the scene moves, since its times are its own. Refused with unknown-scene and index-out-of-range. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-outro\",\"index\":0}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a scene to another place in the sequence; nothing inside it moves.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The scene's index in the sequence after the move, from 0 (the first) to the number of scenes minus 1 (the last).",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sceneId",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_scene_duration",
    "description": "Sets how long one scene lasts. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, and the composition's durationUs is the sum of the scenes' durations, which every scene command keeps. Every later scene starts earlier or later by the change, and whatever in the scene lies past its new end is cut; nothing moves inside it. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-scene, invalid-result when the composition would last too long, and, when a video or sound would then be heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-main\",\"durationUs\":8000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how long a scene lasts; the composition's durationUs changes by the same amount, and every later scene starts that much earlier or later.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "durationUs": {
          "type": "integer",
          "description": "The new duration of the scene, in integer microseconds, at least 1; never rounded. What lies past it in the scene is cut.",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sceneId",
        "durationUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_node_to_scene",
    "description": "Moves one node of a scene, with its animations and, for a group, its children, into the nodes of a scene at a layer index: 0 is the bottom layer. Its startUs, durationUs, and keyframe times stay the same scene times, so it plays at the same moment of its new scene. Within its own scene it acts as reorder_node. A child of a group moves only with its group. Refused with unknown-node, unsupported-node for a child of a group, unknown-scene, index-out-of-range, and, when a video would then be seen or heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"sceneId\":\"scene-outro\",\"index\":1}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a node of a scene's own list, with its animations and children, into the list of a scene; its times stay the same scene times.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a node of a scene, not a child of a group.",
          "minLength": 1
        },
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The node's index in the nodes of that scene after the move, from 0 (the bottom layer) to their number (the top), or their number minus 1 within its own scene.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "sceneId",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_scene_audio_clip",
    "description": "Adds one complete audio clip at an index of a scene's clips, in the time of that scene: it moves with its scene, which cuts it at its end. The clip is given as add_audio_clip takes one: an ID unused in the document, type \"audio\", the ID of an audio asset, startUs and durationUs in scene time, sourceStartUs, volume from 0 to 1, fadeInUs and fadeOutUs. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. The source must be long enough for the part that is heard: describe_document reports an audio asset's sourceDurationUs when the host knows it. Refused with unknown-scene, index-out-of-range, id-in-use, invalid-result, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-main\",\"index\":0,\"clip\":{\"id\":\"clip-scene-voice\",\"type\":\"audio\",\"assetId\":\"asset-audio\",\"startUs\":1000000,\"durationUs\":2000000,\"sourceStartUs\":0,\"volume\":1,\"fadeInUs\":0,\"fadeOutUs\":500000}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete audio clip into a scene's clips, in scene time.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The clip's index in the scene's clips after the insertion, from 0 to their number. Clips are mixed whatever their order.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clip": {
          "type": "object",
          "description": "The complete clip as the document stores it: its ID, unused in the document; type audio; the ID of an audio asset; startUs and durationUs in scene time; sourceStartUs; volume; fadeInUs and fadeOutUs."
        }
      },
      "required": [
        "sceneId",
        "index",
        "clip"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_clip",
    "description": "Moves one clip — a node of any type, or an audio clip — to a new start, keeping its duration and, for a video or an audio clip, its source: it plays the same, only earlier or later. A node's keyframes move with it, and a group's children with theirs, so its animation keeps its place in the clip; set_node_lifetime is the command that changes when a node is shown without moving keyframes. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, invalid-result when a keyframe or a child would leave the times of the document, and, when a video or sound would then be seen or heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"startUs\":1000000}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a clip to a new start, keeping its duration and its source; a node's keyframes, and a group's children with theirs, move by the same amount.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "startUs": {
          "type": "integer",
          "description": "The new start of the clip. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "startUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "trim_clip_start",
    "description": "Moves the start of one clip and keeps its end, as dragging the left edge on a timeline: startUs becomes the given time, durationUs changes by the opposite amount, and a video's or an audio clip's sourceStartUs moves by the same amount, so what remains plays exactly where it did. No keyframe moves, and an audio clip's fades stay at its edges. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, time-outside-clip when the start would reach the end, source-range-exceeded when the source would start before its first instant or run past its end, invalid-result when the fades no longer fit, and media-facts-missing. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"startUs\":2000000}",
    "inputSchema": {
      "type": "object",
      "description": "Moves the start of a clip and keeps its end; a video's or an audio clip's sourceStartUs moves by the same amount, so what remains plays where it did.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "startUs": {
          "type": "integer",
          "description": "The new start of the clip, before its end. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "startUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "trim_clip_end",
    "description": "Moves the end of one clip and keeps its start, as dragging the right edge on a timeline: durationUs becomes endUs minus startUs. No keyframe moves. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, time-outside-clip when the end would reach the start, invalid-result when an audio clip's fades no longer fit, and, when a video or sound would then be seen or heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"endUs\":6000000}",
    "inputSchema": {
      "type": "object",
      "description": "Moves the end of a clip and keeps its start.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "endUs": {
          "type": "integer",
          "description": "The new end of the clip, exclusive, after its start. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "endUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "split_clip",
    "description": "Cuts one clip at atUs into two that meet there, as a razor on a timeline: the first keeps its ID and ends at atUs, the second gets newClipId, starts at atUs, and is placed directly after the first (for a node, the layer right above it). A video or audio clip's second half continues its source where the first stops. Every animation is copied to the second half unchanged, as <newClipId>-a-<property>, so both halves look exactly like the whole. A group is not split. A clip that is heard (an audio clip, or a video above volume 0) is split only at a multiple of 125 microseconds from its start and outside its fades, so the halves sound exactly like the whole; the first half then has no fade-out and the second no fade-in. join_clips undoes it. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, unsupported-node for a group, time-outside-clip when atUs is not strictly inside the clip, split-not-exact, id-in-use with the IDs already taken, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"atUs\":5000000,\"newClipId\":\"node-title-tail\"}",
    "inputSchema": {
      "type": "object",
      "description": "Cuts a clip into two that meet at atUs; the second half is placed directly after the first.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "atUs": {
          "type": "integer",
          "description": "The time of the cut, strictly between the start and the end of the clip. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "newClipId": {
          "type": "string",
          "description": "The ID of the second half, unused in the document. Each copied animation becomes `<newClipId>-a-<property>`.",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "clipId",
        "atUs",
        "newClipId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "join_clips",
    "description": "Joins two halves of a split back into one clip: nextClipId must be directly after clipId in the same list, start where it ends, and be exactly what split_clip would make of the joined clip (same fields, its source continuing, its animations those of the first under its own ID). The joined clip keeps clipId and the second is removed. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. Refused with unknown-clip, unsupported-node for a group, clips-not-joinable, invalid-result, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"nextClipId\":\"node-title-tail\"}",
    "inputSchema": {
      "type": "object",
      "description": "Joins two halves of a split back into one clip.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of the first half.",
          "minLength": 1
        },
        "nextClipId": {
          "type": "string",
          "description": "The ID of the second half: directly after the first in the same list, exactly as split_clip made it.",
          "minLength": 1
        }
      },
      "required": [
        "clipId",
        "nextClipId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "run_transaction",
    "description": "Applies several edit tools in order as one step: all of them or none, and one undo reverts them all. Each call names an edit tool of this catalogue (not describe_document or run_transaction) and passes that tool's arguments; a later call sees the document the earlier ones produced. When one call is refused, nothing changes, and the error names the index of that call. Returns the edited document and the IDs the calls created.\n\nExample arguments: {\"calls\":[{\"name\":\"set_node_position\",\"arguments\":{\"nodeId\":\"node-title\",\"position\":{\"x\":120,\"y\":240}}},{\"name\":\"set_node_opacity\",\"arguments\":{\"nodeId\":\"node-title\",\"opacity\":0.5}}]}",
    "inputSchema": {
      "type": "object",
      "description": "The edit tool calls to apply as one step.",
      "properties": {
        "calls": {
          "type": "array",
          "description": "The calls, in the order they are applied; at least one.",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "One call of an edit tool.",
            "properties": {
              "name": {
                "type": "string",
                "description": "The name of an edit tool of this catalogue.",
                "enum": [
                  "set_node_position",
                  "set_node_opacity",
                  "set_text_content",
                  "add_node",
                  "remove_node",
                  "duplicate_node",
                  "reorder_node",
                  "set_node_scale",
                  "set_node_size",
                  "set_node_color",
                  "set_text_font_size",
                  "set_text_font",
                  "set_image_asset",
                  "add_asset",
                  "remove_asset",
                  "add_animation",
                  "remove_animation",
                  "set_opacity_keyframe",
                  "set_position_keyframe",
                  "set_scale_keyframe",
                  "add_keyframe",
                  "remove_keyframe",
                  "move_keyframe",
                  "set_node_lifetime",
                  "set_node_fit",
                  "set_video_asset",
                  "set_video_source",
                  "set_video_volume",
                  "add_audio_clip",
                  "remove_audio_clip",
                  "set_clip_volume",
                  "set_clip_fades",
                  "set_clip_source",
                  "add_scene",
                  "remove_scene",
                  "duplicate_scene",
                  "reorder_scene",
                  "set_scene_duration",
                  "move_node_to_scene",
                  "add_scene_audio_clip",
                  "move_clip",
                  "trim_clip_start",
                  "trim_clip_end",
                  "split_clip",
                  "join_clips"
                ]
              },
              "arguments": {
                "type": "object",
                "description": "The arguments of that tool, exactly as its own input schema states."
              }
            },
            "required": [
              "name",
              "arguments"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "calls"
      ],
      "additionalProperties": false
    }
  }
]
