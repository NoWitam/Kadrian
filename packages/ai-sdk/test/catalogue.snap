[
  {
    "name": "describe_document",
    "description": "Describes the current document and changes nothing. Returns the canvas size in composition pixels, fps, and durationUs; every scene in the order they play, with its ID, its startUs in the composition (derived: the sum of the durations before it, less the scene transitions between them), its durationUs, its audio clips in scene time, and its nodes from the bottom layer to the top, each with its ID, type, parentId, layer (0 is the bottom), startUs and durationUs in integer microseconds of the time of its scene, its stored fields (position, scale, opacity, animations with their keyframes, text, colour, the html, fonts, and parameters of a Custom HTML element, and so on), a group's children, and the clip transitions and effects of the scene; the transitions between scenes; the definitions that instance nodes place, with their nodes and templates; the template section; the safe area; and the declared assets and the composition's clips, in composition time, where a video or audio asset also states its sourceDurationUs, the length of its source in integer microseconds, when the host knows it, and a video its soundDurationUs, the length of its sound, or null when it has none. Call it before editing to learn the IDs that other tools take.\n\nExample arguments: {}",
    "inputSchema": {
      "type": "object",
      "description": "No arguments.",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_position",
    "description": "Moves one node to an absolute base position: x from the left edge, y from the top edge, of the canvas, or of its group for a node inside a group. Lengths and coordinates are composition pixels, rounded to integers. A position animation of the node adds its offsets on top of this base. Refused with unknown-node when no node has the ID, unsupported-node for a node without a position (the background), and invalid-result when the document cannot hold the position. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"position\":{\"x\":120,\"y\":240}}",
    "inputSchema": {
      "type": "object",
      "description": "Moves one node to an absolute base position.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node to move. A node without a position, such as the background, is refused.",
          "minLength": 1
        },
        "position": {
          "type": "object",
          "description": "The node's new base position, absolute, in composition pixels. A position animation adds its offsets on top of it.",
          "properties": {
            "x": {
              "type": "number",
              "description": "Distance from the left edge, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity (2.5 becomes 3, -2.5 becomes -2), and -0 becomes 0."
            },
            "y": {
              "type": "number",
              "description": "Distance from the top edge, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity (2.5 becomes 3, -2.5 becomes -2), and -0 becomes 0."
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "position"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_opacity",
    "description": "Sets one node's base opacity, from 0 (transparent) to 1 (opaque) inclusive. An opacity animation of the node multiplies it. Refused with invalid-argument outside 0 to 1, unknown-node when no node has the ID, and unsupported-node for a node without an opacity (the background). The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"opacity\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets one node's base opacity.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. A node without an opacity, such as the background, is refused.",
          "minLength": 1
        },
        "opacity": {
          "type": "number",
          "description": "The base opacity, from 0 (transparent) to 1 (opaque) inclusive; a fraction is kept as it is, and -0 becomes 0. An opacity animation multiplies it.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "nodeId",
        "opacity"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_content",
    "description": "Replaces the text of one text node, exactly as given: nothing is trimmed, and line breaks (\\n) are kept. Refused with unknown-node when no node has the ID and unsupported-node for a node that is not a text. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"text\":\"Hello\"}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces the text of one text node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a text node. Any other node is refused.",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "description": "The new text, exactly as given: nothing is trimmed or normalised, and line breaks are kept."
        }
      },
      "required": [
        "nodeId",
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_node",
    "description": "Inserts one complete node into a scene, or into a group, at a layer index: 0 is the bottom layer and the length of the list the top. The node is given exactly as the document stores it, with every field of its type (describe_document shows the stored fields of existing nodes): an ID unused in the document, its type (text, image, video, captions, shape, group, instance, or custom-html), startUs and durationUs, position, scale, rotation, origin, opacity, animations, and its own fields; an image, video, text, captions node, shape, group, or instance ends with its effects, [] for none (add_effect describes one), then mask {\"kind\":\"none\"}, matte {\"kind\":\"none\"}, and blendMode \"normal\" (set_node_mask, set_node_matte, and set_blend_mode describe each). A shape is {width, height, geometry, fill, stroke, trim, effects} after its animations, drawn in its box: set_shape_geometry, set_shape_fill, set_shape_stroke, and set_shape_trim describe each field. An instance places a definition (add_definition describes one) and is {definitionId, inputs, sourceStartUs, width, height, fit, effects} after its animations: inputs [] or the values of an Element's inputs as set_instance_input takes them, sorted by inputId; sourceStartUs the definition time shown at its startUs; fit \"fill\", \"contain\", or \"cover\" of the definition's canvas in its box. A video stores its time map after sourceStartUs: sourceStartRemainder 0, speed {\"num\":1,\"den\":1} (describe_document shows a speed as a multiplier such as \"x0.5\"; stored, it is the fraction {\"num\":1,\"den\":2}, from 1/4 to 4, or {\"num\":0,\"den\":1} for a freeze frame of the frame at sourceStartUs), and reverse false. A group takes text, image, video, and shape nodes only. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. A video must sample inside its source. Refused with unknown-parent, unsupported-node when the parent takes no children, index-out-of-range, id-in-use with the IDs already taken, and invalid-result when the node is not one the document can hold; a video also with media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"parentId\":\"scene-main\",\"index\":4,\"node\":{\"id\":\"node-subtitle\",\"type\":\"text\",\"startUs\":1000000,\"durationUs\":4000000,\"position\":{\"x\":90,\"y\":400},\"scale\":{\"x\":1,\"y\":1},\"rotation\":0,\"origin\":{\"x\":0,\"y\":0},\"opacity\":1,\"animations\":[],\"text\":\"Made with Kadrion\",\"fontAssetId\":\"asset-font\",\"fontSize\":64,\"frame\":{\"kind\":\"none\"},\"color\":\"#ffffff\",\"style\":{\"stroke\":{\"kind\":\"none\"},\"shadow\":{\"kind\":\"none\"},\"box\":{\"kind\":\"none\"},\"align\":\"left\",\"verticalAlign\":\"top\"},\"textAnimations\":[],\"effects\":[],\"mask\":{\"kind\":\"none\"},\"matte\":{\"kind\":\"none\"},\"blendMode\":\"normal\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete node, with its animations and children, into a list.",
      "properties": {
        "parentId": {
          "type": "string",
          "description": "The ID of the scene, or of a group, whose list receives the node. A group takes image, text, video, and shape nodes only.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The node's index in that list after the insertion, from 0 (the bottom layer) to the list's length (the top).",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "node": {
          "type": "object",
          "description": "The complete node as the document stores it, with every ID of its subtree chosen by the caller and unused in the document, and its animations in its own `animations` array."
        }
      },
      "required": [
        "parentId",
        "index",
        "node"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_node",
    "description": "Removes one node together with its animations and, for a group, its children. Refused with unknown-node when no node has the ID and invalid-result when the document would no longer be valid without it. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-custom-html\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a node with its animations and, for a group, its children.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "duplicate_node",
    "description": "Copies one node, with its animations and children, into the same list directly above the original. The copy takes newNodeId; a child at index i of the copy becomes <newNodeId>-c<i>, an animation <newNodeId>-a-<property>, a text animation at index t <newNodeId>-t<t>, an effect at index e <newNodeId>-e<e> and its animations <newNodeId>-e<e>-a-<parameter>. Refused with unknown-node, id-in-use when an ID of the copy is taken, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"newNodeId\":\"node-title-copy\"}",
    "inputSchema": {
      "type": "object",
      "description": "Copies a node, with its animations and children, directly above it.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node.",
          "minLength": 1
        },
        "newNodeId": {
          "type": "string",
          "description": "The ID of the copy, unused in the document. Every other ID of the copy derives from it: a child at index i becomes `<newNodeId>-c<i>`, an animation `<newNodeId>-a-<property>`, a text animation at index t `<newNodeId>-t<t>`, and an animation of that child `<newNodeId>-c<i>-a-<property>` (a text animation `<newNodeId>-c<i>-t<t>`).",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "nodeId",
        "newNodeId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "reorder_node",
    "description": "Moves one node to another index of its own list, which changes the layer order: 0 is the bottom layer and the length of the list minus 1 the top. It never moves a node into or out of a group. Refused with unknown-node and index-out-of-range. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"index\":1}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a node within its own list, which changes the layer order.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The node's index in its own list after the move, from 0 (the bottom layer) to the list's length minus 1 (the top).",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_scale",
    "description": "Sets one node's base scale about its origin point (the top-left corner unless set_node_origin moved it): 1 is the natural size, from 0 to 1000 on each axis. A scale animation of the node multiplies it. Refused with invalid-argument outside 0 to 1000, unknown-node, and unsupported-node for a node without a scale (the background). The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"scale\":{\"x\":1.5,\"y\":1.5}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets one node's base scale.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. A node without a scale, such as the background, is refused.",
          "minLength": 1
        },
        "scale": {
          "type": "object",
          "description": "The node's new base scale about its own origin. A scale animation multiplies it.",
          "properties": {
            "x": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive, kept as it is; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            },
            "y": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive, kept as it is; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "scale"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_size",
    "description": "Sets the width and height of an image, a video, a Custom HTML element, or an instance, from 1 to 1000000. Lengths and coordinates are composition pixels, rounded to integers. On a text it sets the frame its lines wrap to; null for both removes it. Refused with invalid-argument for one null or null on another node, invalid-result for a rounded size outside the range, unknown-node, and unsupported-node for any other node. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"width\":480,\"height\":270}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the size of a node or the frame of a text.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node.",
          "minLength": 1
        },
        "width": {
          "type": [
            "number",
            "null"
          ],
          "description": "The width, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity, and -0 becomes 0; the document takes 1 to 1 000 000, and a rounded value outside that range is refused."
        },
        "height": {
          "type": [
            "number",
            "null"
          ],
          "description": "The height, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity, and -0 becomes 0; the document takes 1 to 1 000 000, and a rounded value outside that range is refused."
        }
      },
      "required": [
        "nodeId",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        {
          "properties": {
            "width": {
              "const": null
            },
            "height": {
              "const": null
            }
          }
        }
      ]
    }
  },
  {
    "name": "set_node_color",
    "description": "Sets the colour of a text or a background, as # and six hexadecimal digits (sRGB), stored in lower case. A color animation of the node replaces it while the animation is sampled. Refused with invalid-argument for short forms, names, or alpha, unknown-node, and unsupported-node for a node without a colour. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"color\":\"#ffcc00\"}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the colour of a text or a background.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only texts and backgrounds have a colour.",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "description": "An sRGB colour as `#` and six hexadecimal digits, in either case; it is stored in lower case. Short forms, names, and alpha are refused.",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "nodeId",
        "color"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_font_size",
    "description": "Sets the font size of a text, from 1 to 1000000. Lengths and coordinates are composition pixels, rounded to integers. Refused with invalid-result outside the range after rounding, unknown-node, and unsupported-node for a node that is not a text. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"fontSize\":96}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the font size of a text.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only texts have a font size.",
          "minLength": 1
        },
        "fontSize": {
          "type": "number",
          "description": "The font size, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity, and -0 becomes 0; the document takes 1 to 1 000 000, and a rounded value outside that range is refused."
        }
      },
      "required": [
        "nodeId",
        "fontSize"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_font",
    "description": "Points a text or captions node at another font asset that the document declares (add one with add_asset first). Refused with unknown-node, unsupported-node for a node that is neither a text nor captions, unknown-asset, and asset-type-mismatch when the asset is not a font. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"fontAssetId\":\"asset-font-bold\"}",
    "inputSchema": {
      "type": "object",
      "description": "Points a text or captions at another font asset of the document.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only texts and captions have a font.",
          "minLength": 1
        },
        "fontAssetId": {
          "type": "string",
          "description": "The ID of a font asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId",
        "fontAssetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_image_asset",
    "description": "Points an image node at another image or SVG asset that the document declares; the node keeps its size, and an SVG asset is shown as an image. Refused with unknown-node, unsupported-node for a node that is not an image, unknown-asset, and asset-type-mismatch when the asset is neither an image nor an SVG. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"assetId\":\"asset-photo\"}",
    "inputSchema": {
      "type": "object",
      "description": "Points an image at another image asset of the document; its size stays.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images have an image asset.",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "description": "The ID of an image asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId",
        "assetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_asset",
    "description": "Declares an image, audio, font, video, or svg asset at an index of the document's assets, under an unused ID and the SHA-256 of its exact bytes. An svg asset is a drawing of a closed subset of SVG that an image node shows as an image; the host loads it only if the sanitiser accepts its bytes. Declare only assets whose bytes the host has: the host must supply them whenever the document is loaded, even while nothing uses the asset. Refused with id-in-use and index-out-of-range. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"asset\":{\"id\":\"asset-photo\",\"type\":\"image\",\"contentHash\":\"sha256:2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae\"},\"index\":3}",
    "inputSchema": {
      "type": "object",
      "description": "Declares an asset, pinned by the hash of its exact bytes. The host must then supply those bytes whenever the document is loaded, even while nothing uses the asset.",
      "properties": {
        "asset": {
          "type": "object",
          "description": "The asset as the document stores it.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The ID of the asset, unused in the document.",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "type": {
              "type": "string",
              "description": "The kind of the asset.",
              "enum": [
                "image",
                "audio",
                "font",
                "video",
                "svg"
              ]
            },
            "contentHash": {
              "type": "string",
              "description": "The algorithm, a colon, and the lower-case hex digest of the exact bytes.",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "type",
            "contentHash"
          ],
          "additionalProperties": false
        },
        "index": {
          "type": "integer",
          "description": "The asset's index in the document's assets after the insertion, from 0 to their number.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "asset",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_asset",
    "description": "Removes an asset that nothing uses. Refused with unknown-asset, and with asset-in-use, whose details list the IDs of its users: point them at another asset or remove them first. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"assetId\":\"asset-photo\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes an asset that nothing uses; an asset in use is refused with its users.",
      "properties": {
        "assetId": {
          "type": "string",
          "description": "The ID of an asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "assetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_animation",
    "description": "Adds one complete animation to a node, at an index of its animations: an ID unused in the document; the property, which the node must not animate yet (position, scale, opacity, rotation, or origin on every node but a background; size, crop, and cornerRadius on an image or a video; color on a text, captions, or a background, which has no other animation; size, fill (a solid fill only), stroke/color, stroke/width, trim/start, trim/end, and geometry on a shape); and at least two keyframes in ascending time, each {timeUs, value, easing}, where the easing says how the value moves from this keyframe to the next one ({\"kind\":\"linear\"} for a constant speed, or any easing set_keyframe_easing describes; the easing of the last keyframe is never read). A position value is an offset {x, y} in pixels added to the base position, a scale value factors {x, y} multiplied with the base scale, an opacity value a factor from 0 to 1. The value depends on the property of the animation: rotation, a number of degrees added to the node's rotation; origin, {\"x\":…,\"y\":…} integers in per mille (-1000 to 1000) added to the node's origin; size, {\"width\":…,\"height\":…} in composition pixels (rounded) that replaces the node's size; color, \"#rrggbb\" that replaces the node's colour; crop, {\"top\":…,\"right\":…,\"bottom\":…,\"left\":…} integers in per mille that replaces the node's crop; cornerRadius, composition pixels (rounded) that replace the node's corner radius; fill and stroke/color, \"#rrggbb\" that replaces the colour of a shape's solid fill or of its stroke; stroke/width, composition pixels (0 to 1000) that replace the width of its stroke; trim/start and trim/end, integers in per mille (0 to 1000) of the outline that replace where its drawn part starts or ends; geometry, a complete geometry of the structure of the shape's own (its kind, its number of points, its commands in the same order with the same arc flags) that replaces it, every number moving on its own, so that a path morphs. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with unknown-node, duplicate-animation-target, index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-custom-html\",\"index\":0,\"animation\":{\"id\":\"anim-html-opacity\",\"property\":\"opacity\",\"keyframes\":[{\"timeUs\":0,\"value\":0,\"easing\":{\"kind\":\"ease-out\"}},{\"timeUs\":1000000,\"value\":1,\"easing\":{\"kind\":\"linear\"}}]}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete animation into a node's animations.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. The background has no animations.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The animation's index in the node's animations after the insertion.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "animation": {
          "type": "object",
          "description": "The complete animation as the document stores it: its ID, unused in the document; its property, which the node must not animate already; and its keyframes, each with its time, its value, and its easing."
        }
      },
      "required": [
        "nodeId",
        "index",
        "animation"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_animation",
    "description": "Removes one animation with all its keyframes; the node keeps its base values. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes one animation with all its keyframes.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        }
      },
      "required": [
        "animationId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_opacity_keyframe",
    "description": "Sets the opacity factor (0 to 1) of an opacity animation at a time: replaces the value of the keyframe at that time, or inserts one. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation and animation-property-mismatch when the animation does not animate opacity. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"timeUs\":5000000,\"opacity\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the keyframe at a time of an opacity animation, inserting it when none is there.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document. It must animate opacity.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "opacity": {
          "type": "number",
          "description": "The opacity factor, from 0 to 1 inclusive, kept as it is; -0 becomes 0.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "opacity"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_position_keyframe",
    "description": "Sets the offset {x, y} of a position animation at a time, added to the node's base position: replaces the value of the keyframe at that time, or inserts one. Lengths and coordinates are composition pixels, rounded to integers. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation and animation-property-mismatch when the animation does not animate position. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-group-position\",\"timeUs\":5000000,\"offset\":{\"x\":40,\"y\":200}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the keyframe at a time of a position animation, inserting it when none is there.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document. It must animate position.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "object",
          "description": "The offset added to the node's base position, in composition pixels; each coordinate is rounded to an integer, halves towards +Infinity, and -0 becomes 0.",
          "properties": {
            "x": {
              "type": "number",
              "description": "The horizontal offset."
            },
            "y": {
              "type": "number",
              "description": "The vertical offset."
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "offset"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_scale_keyframe",
    "description": "Sets the factors {x, y} of a scale animation at a time, from 0 to 1000, multiplied with the node's base scale: replaces the value of the keyframe at that time, or inserts one. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation and animation-property-mismatch when the animation does not animate scale. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-image-scale\",\"timeUs\":5000000,\"factor\":{\"x\":1.1,\"y\":1.1}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the keyframe at a time of a scale animation, inserting it when none is there.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document. It must animate scale.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "factor": {
          "type": "object",
          "description": "The factors multiplied with the node's base scale.",
          "properties": {
            "x": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            },
            "y": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "factor"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_keyframe",
    "description": "Inserts one keyframe given exactly as the document stores it, {timeUs, value, easing}, into an animation, at the place its time gives it; the value must fit the animated property. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, keyframe-exists when the time is taken, and invalid-result for a value of the wrong form. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"keyframe\":{\"timeUs\":9000000,\"value\":0.5,\"easing\":{\"kind\":\"linear\"}}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a keyframe given as exact data at the place its time gives it; its value is judged by the document.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        },
        "keyframe": {
          "type": "object",
          "description": "The keyframe as the document stores it: its time, which must be free, its value, and its easing.",
          "properties": {
            "timeUs": {
              "type": "integer",
              "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "timeUs"
          ]
        }
      },
      "required": [
        "animationId",
        "keyframe"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_keyframe",
    "description": "Removes the keyframe at a time from an animation. An animation keeps at least two keyframes; remove the whole animation instead. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, unknown-keyframe, and too-few-keyframes. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"timeUs\":5000000}",
    "inputSchema": {
      "type": "object",
      "description": "Removes the keyframe at a time; refused when the animation would keep fewer keyframes than the document allows.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "animationId",
        "timeUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_keyframe",
    "description": "Moves the keyframe at timeUs of an animation to toTimeUs, keeping its value and its easing. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, unknown-keyframe, and keyframe-exists when toTimeUs is taken. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"timeUs\":7500000,\"toTimeUs\":6000000}",
    "inputSchema": {
      "type": "object",
      "description": "Gives the keyframe at a time another time, which must be free.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toTimeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "toTimeUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_keyframe_easing",
    "description": "Sets how the value of an animation moves from the keyframe at a time to the next keyframe; the value stays the same at every keyframe. An easing is an object with its kind: {\"kind\":\"linear\"} (a constant speed), {\"kind\":\"hold\"} (the value stays until the end of the interval, at the next keyframe or at the end of the transition, then jumps), {\"kind\":\"ease-in\"} (starts slowly), {\"kind\":\"ease-out\"} (slows down at the end), {\"kind\":\"ease-in-out\"} (both), {\"kind\":\"cubic-bezier\",\"x1\":0.34,\"y1\":1.56,\"x2\":0.64,\"y2\":1} (the curve of CSS cubic-bezier(); x1 and x2 from 0 to 1, y1 and y2 from -1 to 2, where a y outside 0 to 1 overshoots and the value is held within the range of its property), or {\"kind\":\"steps\",\"count\":4,\"position\":\"end\"} (count equal jumps, 1 to 1000, at the end or the start of each interval, as CSS steps()). A keyframe that set_opacity_keyframe, set_position_keyframe, or set_scale_keyframe inserts takes the easing of the keyframe before it, or linear; call this afterwards, in the same transaction, to change it. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, unknown-keyframe, and invalid-result for an easing the document cannot hold. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-group-position\",\"timeUs\":0,\"easing\":{\"kind\":\"cubic-bezier\",\"x1\":0.34,\"y1\":1.56,\"x2\":0.64,\"y2\":1}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces how the value moves from the keyframe at a time to the next one; the easing of the last keyframe is kept but never read.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "easing": {
          "type": "object",
          "description": "The complete new easing. An easing is an object with its kind: {\"kind\":\"linear\"} (a constant speed), {\"kind\":\"hold\"} (the value stays until the end of the interval, at the next keyframe or at the end of the transition, then jumps), {\"kind\":\"ease-in\"} (starts slowly), {\"kind\":\"ease-out\"} (slows down at the end), {\"kind\":\"ease-in-out\"} (both), {\"kind\":\"cubic-bezier\",\"x1\":0.34,\"y1\":1.56,\"x2\":0.64,\"y2\":1} (the curve of CSS cubic-bezier(); x1 and x2 from 0 to 1, y1 and y2 from -1 to 2, where a y outside 0 to 1 overshoots and the value is held within the range of its property), or {\"kind\":\"steps\",\"count\":4,\"position\":\"end\"} (count equal jumps, 1 to 1000, at the end or the start of each interval, as CSS steps())."
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "easing"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_keyframe_value",
    "description": "Sets the value of an animation of rotation, origin, size, color, crop, cornerRadius, or of a shape's fill, stroke/color, stroke/width, trim/start, trim/end, or geometry at a time: replaces the value of the keyframe at that time, or inserts one, eased as the keyframe before it. The value depends on the property of the animation: rotation, a number of degrees added to the node's rotation; origin, {\"x\":…,\"y\":…} integers in per mille (-1000 to 1000) added to the node's origin; size, {\"width\":…,\"height\":…} in composition pixels (rounded) that replaces the node's size; color, \"#rrggbb\" that replaces the node's colour; crop, {\"top\":…,\"right\":…,\"bottom\":…,\"left\":…} integers in per mille that replaces the node's crop; cornerRadius, composition pixels (rounded) that replace the node's corner radius; fill and stroke/color, \"#rrggbb\" that replaces the colour of a shape's solid fill or of its stroke; stroke/width, composition pixels (0 to 1000) that replace the width of its stroke; trim/start and trim/end, integers in per mille (0 to 1000) of the outline that replace where its drawn part starts or ends; geometry, a complete geometry of the structure of the shape's own (its kind, its number of points, its commands in the same order with the same arc flags) that replaces it, every number moving on its own, so that a path morphs. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, use-typed-command for an animation of opacity, position, or scale (use set_opacity_keyframe, set_position_keyframe, or set_scale_keyframe), invalid-argument for a value of the wrong form, and invalid-result for a value outside the range of the property. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-image-rotation\",\"timeUs\":1000000,\"value\":360}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the keyframe at a time of an animation of rotation, origin, size, color, crop, cornerRadius, fill, stroke/color, stroke/width, trim/start, trim/end, or geometry, inserting it when none is there.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document. Opacity, position, and scale have their own keyframe commands.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "value": {
          "description": "The keyframe value. The value depends on the property of the animation: rotation, a number of degrees added to the node's rotation; origin, {\"x\":…,\"y\":…} integers in per mille (-1000 to 1000) added to the node's origin; size, {\"width\":…,\"height\":…} in composition pixels (rounded) that replaces the node's size; color, \"#rrggbb\" that replaces the node's colour; crop, {\"top\":…,\"right\":…,\"bottom\":…,\"left\":…} integers in per mille that replaces the node's crop; cornerRadius, composition pixels (rounded) that replace the node's corner radius; fill and stroke/color, \"#rrggbb\" that replaces the colour of a shape's solid fill or of its stroke; stroke/width, composition pixels (0 to 1000) that replace the width of its stroke; trim/start and trim/end, integers in per mille (0 to 1000) of the outline that replace where its drawn part starts or ends; geometry, a complete geometry of the structure of the shape's own (its kind, its number of points, its commands in the same order with the same arc flags) that replaces it, every number moving on its own, so that a path morphs.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "value"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_lifetime",
    "description": "Sets when a node is shown: from startUs, for durationUs (at least 1). Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. The part after the end of the composition is cut. It moves no keyframe: keyframe times stay composition times. A video keeps its sourceStartUs, so its lifetime must fit inside its source. Refused with unknown-node, invalid-result, and for a video media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"startUs\":1000000,\"durationUs\":5000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets when a node is shown: from startUs, for durationUs, in the time of its scene. It moves no keyframe of the node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Every node has a lifetime, the background included.",
          "minLength": 1
        },
        "startUs": {
          "type": "integer",
          "description": "The scene time from which the node is active, in integer microseconds from the start of its scene; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationUs": {
          "type": "integer",
          "description": "How long the node is active, in integer microseconds, at least 1; whatever lies past the end of its scene is cut, and it is never rounded.",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "startUs",
        "durationUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_fit",
    "description": "Sets how the picture of an image or a video, or the canvas of an instance's definition, meets the box of its node: fill stretches it to the box, contain shows all of it inside the box, cover fills the box and crops; contain and cover keep the aspect ratio and place the picture by its focus (set_node_focus), the centre by default, and an instance's canvas at the centre. Refused with invalid-argument for another fit, unknown-node, and unsupported-node for a node that is neither an image, a video, nor an instance. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"fit\":\"cover\"}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how the picture of an image or a video meets the box of its node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images and videos have a fit.",
          "minLength": 1
        },
        "fit": {
          "type": "string",
          "description": "fill stretches the picture to the box; contain shows all of it inside the box; cover fills the box and crops. contain and cover keep the aspect ratio and place the picture by its focus, the centre unless set_node_focus moved it.",
          "enum": [
            "fill",
            "contain",
            "cover"
          ]
        }
      },
      "required": [
        "nodeId",
        "fit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_focus",
    "description": "Sets the focus point of an image or a video: the point of its picture that its fit keeps in place, as integers in per mille of the picture, x of its width from the left edge and y of its height from the top edge; 500, 500 is the centre. The point lies at the same fraction of the box, so under cover it chooses which part is cropped away and always stays in frame, under contain it moves the picture towards that side of its bars, and under fill, where the picture is the box, it changes nothing. It is not animated. Refused with invalid-argument for a coordinate that is not an integer from 0 to 1000, unknown-node, and unsupported-node for a node that is neither an image nor a video. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"focus\":{\"x\":500,\"y\":250}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets which point of the picture of an image or a video stays in its box.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images and videos have a focus.",
          "minLength": 1
        },
        "focus": {
          "type": "object",
          "description": "The focus point, in per mille of the picture: the point at x per mille of its width and y per mille of its height lies at the same fraction of the box. 500, 500 is the centre.",
          "properties": {
            "x": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the width of the picture, from its left edge.",
              "minimum": 0,
              "maximum": 1000
            },
            "y": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the height of the picture, from its top edge.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "focus"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_rotation",
    "description": "Sets a node's base rotation about its origin point, in degrees, positive clockwise, from -360000 to 360000: several turns are allowed for a spin, and a whole number of turns is no rotation. It is applied after the scale and before the position, and a rotation animation of the node adds to it. Refused with invalid-argument outside the range, unknown-node, and unsupported-node for a background. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"rotation\":15}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the rotation of a node about its origin point, in degrees.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Every node but a background has a rotation.",
          "minLength": 1
        },
        "rotation": {
          "type": "number",
          "description": "Degrees, positive clockwise, from -360000 to 360000; several turns are allowed, and a whole number of turns is no rotation. Never rounded; -0 becomes 0.",
          "minimum": -360000,
          "maximum": 360000
        }
      },
      "required": [
        "nodeId",
        "rotation"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_origin",
    "description": "Sets the point of a node's box that its scale and rotation are about, as integers in per mille of the box: 0, 0 is the top-left corner and 500, 500 the centre; a group's box is the canvas, a text's box the box of its lines. The position still places the top-left corner, so the node does not move while it is neither rotated nor scaled; to keep a rotated or scaled node in place, set its position in the same transaction. An origin animation of the node adds to it. Refused with invalid-argument for a coordinate that is not an integer from 0 to 1000, unknown-node, and unsupported-node for a background. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"origin\":{\"x\":500,\"y\":500}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the point of a node's box that its scale and rotation are about; the position stays that of the top-left corner.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Every node but a background has an origin; a group's box is the canvas.",
          "minLength": 1
        },
        "origin": {
          "type": "object",
          "description": "The origin, in per mille of the box: 0, 0 is the top-left corner and 500, 500 the centre.",
          "properties": {
            "x": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the width of the box, from its left edge.",
              "minimum": 0,
              "maximum": 1000
            },
            "y": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the height of the box, from its top edge.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "origin"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_crop",
    "description": "Sets what is cut away of the picture of an image or a video before it is fitted to its box, as integer insets in per mille of the sides of the picture from its top, right, bottom, and left edge; the rest is then fitted and focused as if it were the whole picture. Two opposite insets add up to at most 999. A crop animation of the node replaces it. Refused with invalid-argument for an inset that is not an integer from 0 to 1000, unknown-node, unsupported-node for a node that is neither an image nor a video, and invalid-result when two opposite insets leave nothing. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"crop\":{\"top\":100,\"right\":0,\"bottom\":100,\"left\":0}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets what is cut away of the picture of an image or a video before it is fitted to its box.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images and videos have a crop.",
          "minLength": 1
        },
        "crop": {
          "type": "object",
          "description": "Insets from each edge of the picture, in per mille of its sides; two opposite insets add up to at most 999.",
          "properties": {
            "top": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the height, from the top edge.",
              "minimum": 0,
              "maximum": 1000
            },
            "right": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the width, from the right edge.",
              "minimum": 0,
              "maximum": 1000
            },
            "bottom": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the height, from the bottom edge.",
              "minimum": 0,
              "maximum": 1000
            },
            "left": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the width, from the left edge.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "crop"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_corner_radius",
    "description": "Sets the radius of the four corners of an image or a video, in composition pixels; 0 is square, and a radius above half a side is reduced as CSS does. Lengths and coordinates are composition pixels, rounded to integers. A cornerRadius animation of the node replaces it. Refused with invalid-argument, unknown-node, unsupported-node for a node that is neither an image nor a video, and invalid-result outside 0 to 1000000 after rounding. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"cornerRadius\":24}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the radius of the corners of an image or a video.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images and videos have a corner radius.",
          "minLength": 1
        },
        "cornerRadius": {
          "type": "number",
          "description": "Composition pixels, rounded to an integer, halves towards +Infinity; 0 is square, and a radius above half a side is reduced as CSS does."
        }
      },
      "required": [
        "nodeId",
        "cornerRadius"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_video_asset",
    "description": "Points a video node at another video asset that the document declares (add one with add_asset first); its source start, size, and fit stay. The part of the source the node samples must lie inside the new video: describe_document reports a video's sourceDurationUs when the host knows it. Refused with unknown-node, unsupported-node for a node that is not a video, unknown-asset, asset-type-mismatch when the asset is not a video, media-facts-missing when the host does not know the video's duration, and source-range-exceeded when the node would sample past its end. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-video\",\"assetId\":\"asset-clip\"}",
    "inputSchema": {
      "type": "object",
      "description": "Points a video at another video asset of the document; its source start, size, and fit stay.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only videos have a video asset.",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "description": "The ID of a video asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId",
        "assetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_video_source",
    "description": "Sets the source time a video node shows at the start of its lifetime; it keeps its speed and its direction. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Source times count from the video's first frame. The node samples the source range describe_document states as its sampledSourceRange, from sourceStartUs at speed 1 forwards, which must lie inside the video: describe_document reports its sourceDurationUs when the host knows it. To trim the start of a clip, use trim_clip_start, which keeps every frame that remains at any speed. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not a video, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-video\",\"sourceStartUs\":2000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the source time a video shows at the start of its lifetime; its speed, its direction, and the remainder of its exact source start stay (D82.9).",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only videos have a source.",
          "minLength": 1
        },
        "sourceStartUs": {
          "type": "integer",
          "description": "The source time shown at the start of the lifetime, in integer microseconds from the first frame of the video; it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "sourceStartUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_video_volume",
    "description": "Sets how loud the sound of a video node is heard: a linear factor of the amplitude from 0 (silent) to 1 (the source as it is); it never amplifies. A video above 0 is heard from the source time it shows, and its asset must then have exactly one audio stream that starts with its picture, long enough for what is heard: describe_document reports a video's soundDurationUs when the host knows it, null when it has no sound. Refused with invalid-argument outside 0 to 1, unknown-node, unsupported-node for a node that is not a video, media-facts-missing when the host does not know the video's sound, and source-range-exceeded when the node would hear past its end or the video has no sound. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-video\",\"volume\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how loud the sound of a video is heard; 0 is silent.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only videos have a volume.",
          "minLength": 1
        },
        "volume": {
          "type": "number",
          "description": "The linear factor of the amplitude, from 0 (silent) to 1 (the source as it is) inclusive; it never amplifies. A fraction is kept as it is, and -0 becomes 0.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "nodeId",
        "volume"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_audio_clip",
    "description": "Adds one complete audio clip at an index of the document's clips; every clip is heard, mixed by adding, whatever the order. The clip is given exactly as the document stores it: an ID unused in the document, type \"audio\", the ID of an audio asset the document declares (add one with add_asset first), startUs and durationUs (at least 1) in composition time, sourceStartUs (the source time heard at startUs), sourceStartRemainder 0, speed {\"num\":1,\"den\":1} (the source's own speed; describe_document shows a speed as a multiplier such as \"x1.5\", stored as the fraction {\"num\":3,\"den\":2}, from 1/4 to 4, the pitch kept), reverse false (true plays the same source range backwards), volume from 0 to 1, and fadeInUs and fadeOutUs, linear, which together take at most durationUs. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. The part after the end of the composition is cut; the source must be long enough for the part that is heard: describe_document reports an audio asset's sourceDurationUs when the host knows it. Refused with index-out-of-range, id-in-use, invalid-result, media-facts-missing when the host does not know the asset's duration, and source-range-exceeded when the clip would hear past its end. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":1,\"clip\":{\"id\":\"clip-voice\",\"type\":\"audio\",\"assetId\":\"asset-audio\",\"startUs\":2000000,\"durationUs\":3000000,\"sourceStartUs\":500000,\"sourceStartRemainder\":0,\"speed\":{\"num\":1,\"den\":1},\"reverse\":false,\"volume\":0.8,\"fadeInUs\":250000,\"fadeOutUs\":1000000}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete audio clip into the document's clips.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The clip's index in the document's clips after the insertion, from 0 to their number. Clips are mixed whatever their order.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clip": {
          "type": "object",
          "description": "The complete clip as the document stores it: its ID, unused in the document; type audio; the ID of an audio asset; startUs and durationUs in composition time; sourceStartUs; sourceStartRemainder, speed, and reverse, its time map (D82.1); volume; fadeInUs and fadeOutUs."
        }
      },
      "required": [
        "index",
        "clip"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_audio_clip",
    "description": "Removes one audio clip, of the composition's clips or of a scene's; its asset stays declared. Refused with unknown-clip. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes one audio clip.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        }
      },
      "required": [
        "clipId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_volume",
    "description": "Sets the volume of one audio clip: a linear factor of the amplitude from 0 (silent) to 1 (the source as it is); it never amplifies. Refused with invalid-argument outside 0 to 1 and unknown-clip. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"volume\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the volume of one audio clip; 0 is silent.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        },
        "volume": {
          "type": "number",
          "description": "The linear factor of the amplitude, from 0 (silent) to 1 (the source as it is) inclusive; it never amplifies. A fraction is kept as it is, and -0 becomes 0.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "clipId",
        "volume"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_fades",
    "description": "Sets the linear fade-in and fade-out of one audio clip: the clip rises from silence to its volume over the first fadeInUs of its lifetime and falls back to silence over the last fadeOutUs, counted in its whole lifetime even where its scene or the composition cuts it. 0 is no fade, and both together take at most the clip's durationUs. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, and invalid-result when the fades exceed the duration. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"fadeInUs\":500000,\"fadeOutUs\":2000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the linear fade-in and fade-out of one audio clip.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        },
        "fadeInUs": {
          "type": "integer",
          "description": "How long the clip rises from silence to its volume at its start, in integer microseconds of the lifetime of the clip, 0 for none; it is never rounded, and -0 becomes 0. Both fades together take at most the clip's durationUs.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fadeOutUs": {
          "type": "integer",
          "description": "How long the clip falls from its volume to silence at its end, in integer microseconds of the lifetime of the clip, 0 for none; it is never rounded, and -0 becomes 0. Both fades together take at most the clip's durationUs.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "fadeInUs",
        "fadeOutUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_source",
    "description": "Points one audio clip at an audio asset the document declares, which may be the one it has, and sets the source time heard at the clip's start; it keeps its lifetime, its speed, and its direction. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Source times count from the first sample. To move a clip in time, run remove_audio_clip and add_audio_clip in one transaction. The part heard must lie inside the source: describe_document reports an audio asset's sourceDurationUs when the host knows it. Refused with invalid-argument, unknown-clip, unknown-asset, asset-type-mismatch when the asset is not audio, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"assetId\":\"asset-audio\",\"sourceStartUs\":1000000}",
    "inputSchema": {
      "type": "object",
      "description": "Points one audio clip at an audio asset and the source time it plays from; its lifetime and its time map but for its source start stay (D82.9).",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "description": "The ID of an audio asset the document declares; it may be the one it has.",
          "minLength": 1
        },
        "sourceStartUs": {
          "type": "integer",
          "description": "The source time heard at the start of the clip, in integer microseconds from the first sample; it is never rounded, and -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "assetId",
        "sourceStartUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_scene",
    "description": "Inserts one complete scene at an index of the sequence. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, less the duration of a transition between them, and the composition's durationUs is the sum of the scenes' durations less those of the scene transitions, which every scene command keeps. A command that would break a transition — remove or move one of its scenes or nodes, or shorten one so that it no longer fits — is refused with transition-in-use and the IDs of those transitions: remove them first, in the same transaction. The scene is given exactly as the document stores it: an ID unused in the document, durationUs (at least 1), its nodes from the bottom layer to the top (each as add_node takes one), its audio clips (each as add_scene_audio_clip takes one), its clip transitions, and its effects ([] for none; add_effect describes one), every ID unused in the document. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with index-out-of-range, id-in-use with the IDs already taken, and invalid-result when the scene is not one the document can hold; a scene with video or sound also with media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":1,\"scene\":{\"id\":\"scene-outro\",\"durationUs\":3000000,\"nodes\":[{\"id\":\"node-outro-background\",\"type\":\"background\",\"startUs\":0,\"durationUs\":3000000,\"color\":\"#000000\",\"animations\":[]}],\"clips\":[],\"transitions\":[],\"effects\":[]}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete scene into the sequence; the composition's durationUs grows by the scene's.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The scene's index in the sequence after the insertion, from 0 (the first scene) to the number of scenes (after the last).",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scene": {
          "type": "object",
          "description": "The complete scene as the document stores it: its ID, durationUs, nodes, and clips, every ID of it chosen by the caller and unused in the document, every time in it scene time."
        }
      },
      "required": [
        "index",
        "scene"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_scene",
    "description": "Removes one scene with its nodes and clips; its assets stay declared. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, less the duration of a transition between them, and the composition's durationUs is the sum of the scenes' durations less those of the scene transitions, which every scene command keeps. A command that would break a transition — remove or move one of its scenes or nodes, or shorten one so that it no longer fits — is refused with transition-in-use and the IDs of those transitions: remove them first, in the same transaction. Every later scene starts earlier by the removed scene's duration. Refused with unknown-scene, and last-scene for the only scene of the document. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-outro\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a scene with its nodes and clips; the composition's durationUs shrinks by the scene's. The last scene cannot be removed.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        }
      },
      "required": [
        "sceneId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "duplicate_scene",
    "description": "Copies one scene, with its nodes, animations, and clips, directly after it. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, less the duration of a transition between them, and the composition's durationUs is the sum of the scenes' durations less those of the scene transitions, which every scene command keeps. A command that would break a transition — remove or move one of its scenes or nodes, or shorten one so that it no longer fits — is refused with transition-in-use and the IDs of those transitions: remove them first, in the same transaction. The copy's IDs derive from newSceneId: the node at index i becomes <newSceneId>-n<i>, its child at index j <newSceneId>-n<i>-c<j>, an animation <owner>-a-<property>, an effect at index e of the scene or a node <owner>-e<e> with its animations <owner>-e<e>-a-<parameter>, and the clip at index k <newSceneId>-k<k>. Refused with invalid-argument for an ID not of the document's form, unknown-scene, id-in-use with the derived IDs already taken, and invalid-result; a scene with video or sound also with media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-main\",\"newSceneId\":\"scene-again\"}",
    "inputSchema": {
      "type": "object",
      "description": "Copies a scene, with its nodes and clips, directly after it; the composition's durationUs grows by the scene's.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "newSceneId": {
          "type": "string",
          "description": "The ID of the copy, unused in the document. Every other ID of the copy derives from it: the node at index i becomes `<newSceneId>-n<i>`, its child at index j `<newSceneId>-n<i>-c<j>`, an animation `<owner>-a-<property>`, a text animation at index t `<owner>-t<t>`, and the clip at index k `<newSceneId>-k<k>`.",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "sceneId",
        "newSceneId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "reorder_scene",
    "description": "Moves one scene to another index of the sequence: 0 is the first scene. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, less the duration of a transition between them, and the composition's durationUs is the sum of the scenes' durations less those of the scene transitions, which every scene command keeps. A command that would break a transition — remove or move one of its scenes or nodes, or shorten one so that it no longer fits — is refused with transition-in-use and the IDs of those transitions: remove them first, in the same transaction. Nothing inside the scene moves, since its times are its own. Refused with unknown-scene and index-out-of-range. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-outro\",\"index\":0}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a scene to another place in the sequence; nothing inside it moves.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The scene's index in the sequence after the move, from 0 (the first) to the number of scenes minus 1 (the last).",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sceneId",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_scene_duration",
    "description": "Sets how long one scene lasts. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, less the duration of a transition between them, and the composition's durationUs is the sum of the scenes' durations less those of the scene transitions, which every scene command keeps. A command that would break a transition — remove or move one of its scenes or nodes, or shorten one so that it no longer fits — is refused with transition-in-use and the IDs of those transitions: remove them first, in the same transaction. Every later scene starts earlier or later by the change, and whatever in the scene lies past its new end is cut; nothing moves inside it. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-scene, invalid-result when the composition would last too long, and, when a video or sound would then be heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-main\",\"durationUs\":8000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how long a scene lasts; the composition's durationUs changes by the same amount, and every later scene starts that much earlier or later.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "durationUs": {
          "type": "integer",
          "description": "The new duration of the scene, in integer microseconds, at least 1; never rounded. What lies past it in the scene is cut.",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sceneId",
        "durationUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_node_to_scene",
    "description": "Moves one node of a scene, with its animations and, for a group, its children, into the nodes of a scene at a layer index: 0 is the bottom layer. Its startUs, durationUs, and keyframe times stay the same scene times, so it plays at the same moment of its new scene. Within its own scene it acts as reorder_node. A child of a group moves only with its group. Refused with unknown-node, unsupported-node for a child of a group, unknown-scene, index-out-of-range, and, when a video would then be seen or heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"sceneId\":\"scene-outro\",\"index\":1}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a node of a scene's own list, with its animations and children, into the list of a scene; its times stay the same scene times.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a node of a scene, not a child of a group.",
          "minLength": 1
        },
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The node's index in the nodes of that scene after the move, from 0 (the bottom layer) to their number (the top), or their number minus 1 within its own scene.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "sceneId",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_scene_audio_clip",
    "description": "Adds one complete audio clip at an index of a scene's clips, in the time of that scene: it moves with its scene, which cuts it at its end. The clip is given as add_audio_clip takes one: an ID unused in the document, type \"audio\", the ID of an audio asset, startUs and durationUs in scene time, sourceStartUs, sourceStartRemainder, speed, reverse, volume from 0 to 1, fadeInUs and fadeOutUs. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. The source must be long enough for the part that is heard: describe_document reports an audio asset's sourceDurationUs when the host knows it. Refused with unknown-scene, index-out-of-range, id-in-use, invalid-result, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-main\",\"index\":0,\"clip\":{\"id\":\"clip-scene-voice\",\"type\":\"audio\",\"assetId\":\"asset-audio\",\"startUs\":1000000,\"durationUs\":2000000,\"sourceStartUs\":0,\"sourceStartRemainder\":0,\"speed\":{\"num\":1,\"den\":1},\"reverse\":false,\"volume\":1,\"fadeInUs\":0,\"fadeOutUs\":500000}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete audio clip into a scene's clips, in scene time.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The clip's index in the scene's clips after the insertion, from 0 to their number. Clips are mixed whatever their order.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clip": {
          "type": "object",
          "description": "The complete clip as the document stores it: its ID, unused in the document; type audio; the ID of an audio asset; startUs and durationUs in scene time; sourceStartUs; sourceStartRemainder, speed, and reverse, its time map (D82.1); volume; fadeInUs and fadeOutUs."
        }
      },
      "required": [
        "sceneId",
        "index",
        "clip"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_clip",
    "description": "Moves one clip — a node of any type, or an audio clip — to a new start, keeping its duration and, for a video or an audio clip, its source: it plays the same, only earlier or later. A node's keyframes and a captions node's words move with it, and a group's children with theirs, so its animation keeps its place in the clip; set_node_lifetime is the command that changes when a node is shown without moving keyframes. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, invalid-result when a keyframe or a child would leave the times of the document, and, when a video or sound would then be seen or heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"startUs\":1000000}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a clip to a new start, keeping its duration and its source; a node's keyframes, and a group's children with theirs, move by the same amount.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "startUs": {
          "type": "integer",
          "description": "The new start of the clip. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "startUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "trim_clip_start",
    "description": "Moves the start of one clip and keeps its end, as dragging the left edge on a timeline: startUs becomes the given time, durationUs changes by the opposite amount, and a video's or an audio clip's source moves by the same amount times its speed (a reversed clip's source stays), so what remains plays exactly where it did. No keyframe moves, and an audio clip's fades stay at its edges. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, time-outside-clip when the start would reach the end, source-range-exceeded when the source would start before its first instant or run past its end, invalid-result when the fades no longer fit, and media-facts-missing. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"startUs\":2000000}",
    "inputSchema": {
      "type": "object",
      "description": "Moves the start of a clip and keeps its end; a video's or an audio clip's source moves by the same amount times its speed, and a reversed one's stays, so what remains plays where it did (D82.2).",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "startUs": {
          "type": "integer",
          "description": "The new start of the clip, before its end. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "startUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "trim_clip_end",
    "description": "Moves the end of one clip and keeps its start, as dragging the right edge on a timeline: durationUs becomes endUs minus startUs. No keyframe moves. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, time-outside-clip when the end would reach the start, invalid-result when an audio clip's fades no longer fit, and, when a video or sound would then be seen or heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"endUs\":6000000}",
    "inputSchema": {
      "type": "object",
      "description": "Moves the end of a clip and keeps its start.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "endUs": {
          "type": "integer",
          "description": "The new end of the clip, exclusive, after its start. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "endUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "split_clip",
    "description": "Cuts one clip at atUs into two that meet there, as a razor on a timeline: the first keeps its ID and ends at atUs, the second gets newClipId, starts at atUs, and is placed directly after the first (for a node, the layer right above it). A video or audio clip's second half continues its source where the first stops, at its speed and in its direction, so each half shows exactly what the whole showed there. Every animation is copied to the second half unchanged, as <newClipId>-a-<property>, every effect as <newClipId>-e<e> with its animations as <newClipId>-e<e>-a-<parameter>, and every text animation as <newClipId>-t<t>, one of phase in as an accent at the start of the whole, so both halves look exactly like the whole; a text with a text animation of phase out is refused with split-not-exact. A group is not split. A clip that is heard (an audio clip, or a video above volume 0) is split only at a multiple of 125 microseconds from its start and outside its fades, so the halves sound exactly like the whole; the first half then has no fade-out and the second no fade-in. join_clips undoes it. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, unsupported-node for a group, time-outside-clip when atUs is not strictly inside the clip, split-not-exact, id-in-use with the IDs already taken, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"atUs\":5000000,\"newClipId\":\"node-title-tail\"}",
    "inputSchema": {
      "type": "object",
      "description": "Cuts a clip into two that meet at atUs; the second half is placed directly after the first.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "atUs": {
          "type": "integer",
          "description": "The time of the cut, strictly between the start and the end of the clip. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "newClipId": {
          "type": "string",
          "description": "The ID of the second half, unused in the document. Each copied animation becomes `<newClipId>-a-<property>`, and the text animation at index t `<newClipId>-t<t>`.",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "clipId",
        "atUs",
        "newClipId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "join_clips",
    "description": "Joins two halves of a split back into one clip: nextClipId must be directly after clipId in the same list, start where it ends, and be exactly what split_clip would make of the joined clip (same fields, its source continuing, its animations those of the first under its own ID). The joined clip keeps clipId and the second is removed. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Refused with unknown-clip, unsupported-node for a group, clips-not-joinable, invalid-result, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"nextClipId\":\"node-title-tail\"}",
    "inputSchema": {
      "type": "object",
      "description": "Joins two halves of a split back into one clip.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of the first half.",
          "minLength": 1
        },
        "nextClipId": {
          "type": "string",
          "description": "The ID of the second half: directly after the first in the same list, exactly as split_clip made it.",
          "minLength": 1
        }
      },
      "required": [
        "clipId",
        "nextClipId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_speed",
    "description": "Sets the speed of a video node or an audio clip: how fast it plays its source, picture and sound, the pitch kept. A speed is a multiplier: \"x0.25\", \"x0.5\" (half speed), \"x0.75\", \"x1\" (the source's own speed), \"x1.5\", \"x2\" (twice as fast), \"x4\", or a fraction such as \"x1/3\" or \"x2/3\"; a number such as 0.5 or 2, or {\"num\":1,\"den\":2}, means the same. Speeds go from x0.25 to x4, the pitch of the sound kept, and \"x0\" freezes a video on one frame. The document stores the exact fraction {\"num\":…,\"den\":…} and describe_document shows it as a multiplier. A multiplier that is no fraction with a denominator up to 1000, such as \"x0.3333\", is refused with speed-invalid, and the refusal names the nearest speed (\"x1/3\"): call again with it. \"x0\" is for a video only; freeze_frame holds the frame shown at a given time instead. The clip keeps its startUs, its sourceStartUs, and its direction, and plays the same part of its source by default: durationUs becomes the one given or, left out, the duration of that part at the new speed, rounded up (twice as long at \"x0.5\", half as long at \"x2\"; kept when either speed is \"x0\"). Nothing else moves: no keyframe, and no clip after it. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, speed-invalid for a speed outside x0.25 to x4 other than x0, not in the notation, or with no exact fraction (the message names the nearest one), x0 for an audio clip or a reversed clip, or a sourceStartRemainder not below the new denominator, unknown-clip, unsupported-node for a node that is neither a video nor an audio clip, invalid-result when an audio clip's fades no longer fit, transition-in-use, and, when the clip would then read more of its source, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"speed\":\"x0.5\"}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the speed of a video node or an audio clip; its start, its source start, and its direction stay (D82.9).",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a video node or an audio clip of the document.",
          "minLength": 1
        },
        "speed": {
          "description": "The new speed. A speed is a multiplier: \"x0.25\", \"x0.5\" (half speed), \"x0.75\", \"x1\" (the source's own speed), \"x1.5\", \"x2\" (twice as fast), \"x4\", or a fraction such as \"x1/3\" or \"x2/3\"; a number such as 0.5 or 2, or {\"num\":1,\"den\":2}, means the same. Speeds go from x0.25 to x4, the pitch of the sound kept, and \"x0\" freezes a video on one frame. The document stores the exact fraction {\"num\":…,\"den\":…} and describe_document shows it as a multiplier. A multiplier that is no fraction with a denominator up to 1000, such as \"x0.3333\", is refused with speed-invalid, and the refusal names the nearest speed (\"x1/3\"): call again with it.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "durationUs": {
          "type": "integer",
          "description": "Optional: the new duration of the clip, in integer microseconds, at least 1. Left out, it is the duration that plays the same part of the source, rounded up (twice as long at half the speed), and kept when either speed is x0.",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceStartRemainder": {
          "type": "integer",
          "description": "Optional, and rarely needed: the fraction of a microsecond of the exact source time at the clip's start, in units of 1/den of the new speed, below den. Left out, the clip's remainder is scaled to the new den, rounded down.",
          "minimum": 0,
          "maximum": 999
        }
      },
      "required": [
        "clipId",
        "speed"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_reverse",
    "description": "Plays a video node or an audio clip backwards (reverse true) or forwards again (false), picture and sound: it plays the same part of its source over the same lifetime, from the last instant of that part to the first, at its speed. Its lifetime, speed, and sourceStartUs stay, and no keyframe moves; describe_document states each clip's reverse and its sampledSourceRange. A freeze frame (speed x0) has no direction. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Refused with invalid-argument, unknown-clip, unsupported-node for a node that is neither a video nor an audio clip, speed-invalid for a freeze frame, invalid-result for a reversed clip that would read more than 600000000 microseconds (10 minutes) of its source, and, when its sound would then read other source, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"reverse\":true}",
    "inputSchema": {
      "type": "object",
      "description": "Plays a video node or an audio clip backwards or forwards; its lifetime and the part of its source it plays stay (D82.9).",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a video node or an audio clip of the document.",
          "minLength": 1
        },
        "reverse": {
          "type": "boolean",
          "description": "true plays the clip backwards, from the last instant of its part of the source to the first; false plays it forwards."
        }
      },
      "required": [
        "clipId",
        "reverse"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_scene_transition",
    "description": "Adds a transition on the boundary between a scene and the scene directly after it: during durationUs both play, the outgoing one in its last durationUs and the incoming one in its first, combined by the effect — crossfade, fade-through-color with a colour, slide, wipe, or push with a direction (left, right, up, down), zoom with a fromScale, iris with a center, or blur-dissolve with a radius. Every later scene starts durationUs earlier and the composition's durationUs shrinks by as much; no time inside a scene moves. A boundary takes at most one transition. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with index-out-of-range, id-in-use, and invalid-result when the scenes are not adjacent, the boundary has a transition already, or the transition does not fit its scenes. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":0,\"transition\":{\"id\":\"transition-outro\",\"fromSceneId\":\"scene-main\",\"toSceneId\":\"scene-outro\",\"durationUs\":500000,\"effect\":{\"kind\":\"crossfade\"},\"easing\":{\"kind\":\"linear\"}}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a transition on the boundary between two adjacent scenes: the incoming scene starts durationUs earlier and overlaps the end of the outgoing one, and the composition's durationUs shrinks by as much.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The transition's index in the composition's transitions after the insertion, from 0 to their number; their order has no meaning.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transition": {
          "type": "object",
          "description": "The complete transition as the document stores it: its ID, unused in the document; fromSceneId, the outgoing scene; toSceneId, the scene directly after it; durationUs, at most the duration of either scene; and effect. An effect is an object with its kind, the same for scene and clip transitions: {\"kind\":\"crossfade\"} (the incoming side fades in over the outgoing one), {\"kind\":\"fade-through-color\",\"color\":\"#rrggbb\"} (the outgoing side fades out to the colour, then the incoming one fades in from it), {\"kind\":\"slide\",\"direction\":\"left\"|\"right\"|\"up\"|\"down\"} (the incoming side slides in, moving in its direction), {\"kind\":\"wipe\",\"direction\":…} (an edge moving in its direction uncovers the incoming side), {\"kind\":\"push\",\"direction\":…} (the incoming side slides in and pushes the outgoing one out the other way), {\"kind\":\"zoom\",\"fromScale\":0.5} (the incoming side fades in while it scales from fromScale, 0 to 16, to its size about the centre of the frame), {\"kind\":\"iris\",\"center\":{\"x\":500,\"y\":500}} (a circle opens from a point given in per mille of the frame, integers 0 to 1000), or {\"kind\":\"blur-dissolve\",\"radius\":12} (the incoming side fades in and sharpens while the outgoing one blurs, radius the strongest blur in composition pixels, 0 to 1000). The frame of a clip transition is the canvas, in the space of the two nodes' parent; between clips, the colour of fade-through-color covers the frame directly below the lower clip, and when the outgoing clip lies above the incoming one, a slide moves it out, a wipe and an iris cut it away, and a crossfade and a zoom fade it out, so the incoming clip is uncovered."
        }
      },
      "required": [
        "index",
        "transition"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_clip_transition",
    "description": "Adds a transition between two clips of one layer of a scene — two children of one parent, neither a background — whose lifetimes already overlap by exactly durationUs: the outgoing node ends durationUs after the incoming one starts. During the overlap the effect combines them in the frame of the canvas — crossfade, fade-through-color, slide, wipe, push, zoom, iris, or blur-dissolve, as for scenes; nothing moves in time. Make the overlap first with move_clip, trim_clip_start, or trim_clip_end, or call add_clip_transition_at_cut for two clips that meet end to end. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with unknown-scene, index-out-of-range, id-in-use, and invalid-result when the nodes are not siblings of this scene, a background, or do not overlap by exactly durationUs. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-main\",\"index\":0,\"transition\":{\"id\":\"transition-title\",\"fromNodeId\":\"node-title\",\"toNodeId\":\"node-custom-html\",\"durationUs\":500000,\"effect\":{\"kind\":\"crossfade\"},\"easing\":{\"kind\":\"linear\"}}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a transition between two clips of one layer of a scene, two children of one parent whose lifetimes already overlap by exactly its durationUs; nothing moves.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The transition's index in the scene's transitions after the insertion, from 0 to their number; their order has no meaning.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transition": {
          "type": "object",
          "description": "The complete transition as the document stores it: its ID, unused in the document; fromNodeId, the outgoing node, which ends durationUs after the incoming one starts; toNodeId, the incoming node; durationUs; and effect. An effect is an object with its kind, the same for scene and clip transitions: {\"kind\":\"crossfade\"} (the incoming side fades in over the outgoing one), {\"kind\":\"fade-through-color\",\"color\":\"#rrggbb\"} (the outgoing side fades out to the colour, then the incoming one fades in from it), {\"kind\":\"slide\",\"direction\":\"left\"|\"right\"|\"up\"|\"down\"} (the incoming side slides in, moving in its direction), {\"kind\":\"wipe\",\"direction\":…} (an edge moving in its direction uncovers the incoming side), {\"kind\":\"push\",\"direction\":…} (the incoming side slides in and pushes the outgoing one out the other way), {\"kind\":\"zoom\",\"fromScale\":0.5} (the incoming side fades in while it scales from fromScale, 0 to 16, to its size about the centre of the frame), {\"kind\":\"iris\",\"center\":{\"x\":500,\"y\":500}} (a circle opens from a point given in per mille of the frame, integers 0 to 1000), or {\"kind\":\"blur-dissolve\",\"radius\":12} (the incoming side fades in and sharpens while the outgoing one blurs, radius the strongest blur in composition pixels, 0 to 1000). The frame of a clip transition is the canvas, in the space of the two nodes' parent; between clips, the colour of fade-through-color covers the frame directly below the lower clip, and when the outgoing clip lies above the incoming one, a slide moves it out, a wipe and an iris cut it away, and a crossfade and a zoom fade it out, so the incoming clip is uncovered."
        }
      },
      "required": [
        "sceneId",
        "index",
        "transition"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_transition",
    "description": "Removes a scene or clip transition. Without a scene transition the incoming scene starts where the outgoing one ends again: every later scene starts durationUs later and the composition grows by as much. Without a clip transition the two clips stay where they are and simply overlap. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Refused with unknown-transition. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"transitionId\":\"transition-outro\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a transition. A scene transition's duration is given back: the incoming scene starts that much later, and the composition's durationUs grows by as much. A clip transition's clips stay where they are.",
      "properties": {
        "transitionId": {
          "type": "string",
          "description": "The stable ID of a scene transition or a clip transition of the document.",
          "minLength": 1
        }
      },
      "required": [
        "transitionId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_transition_duration",
    "description": "Sets how long a transition lasts. A longer scene transition makes the incoming scene, and every later one, start earlier, and the composition shorter, by the change. A longer clip transition makes the outgoing clip last longer by the change, so that it still ends durationUs after the incoming one starts: a video then shows more of its source. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-transition, invalid-result when it would not fit its sides, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"transitionId\":\"transition-outro\",\"durationUs\":1000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how long a transition lasts. For a scene transition, the incoming scene and every later one start earlier or later by the change, and the composition's durationUs changes by the opposite amount. For a clip transition, the outgoing clip's durationUs changes by the same amount, so that it still ends durationUs after the incoming clip starts.",
      "properties": {
        "transitionId": {
          "type": "string",
          "description": "The stable ID of a scene transition or a clip transition of the document.",
          "minLength": 1
        },
        "durationUs": {
          "type": "integer",
          "description": "The new duration of the transition, in integer microseconds, at least 1; at most the duration of either side, and the transitions into and out of one side together at most its duration.",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "transitionId",
        "durationUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_transition_effect",
    "description": "Replaces how a transition combines its two sides with a complete effect: {\"kind\":\"crossfade\"}, {\"kind\":\"fade-through-color\",\"color\":\"#000000\"}, {\"kind\":\"slide\",\"direction\":\"left\"}, {\"kind\":\"wipe\",\"direction\":\"up\"}, {\"kind\":\"push\",\"direction\":\"right\"}, {\"kind\":\"zoom\",\"fromScale\":0.5}, {\"kind\":\"iris\",\"center\":{\"x\":500,\"y\":500}}, or {\"kind\":\"blur-dissolve\",\"radius\":12} (the outgoing side blurs and the incoming one sharpens while it fades in); directions are left, right, up, and down, the way the incoming side moves. Scene and clip transitions take the same effects. No time changes. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Refused with unknown-transition and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"transitionId\":\"transition-outro\",\"effect\":{\"kind\":\"wipe\",\"direction\":\"left\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces how a transition combines its two sides; no time changes.",
      "properties": {
        "transitionId": {
          "type": "string",
          "description": "The stable ID of a scene transition or a clip transition of the document.",
          "minLength": 1
        },
        "effect": {
          "type": "object",
          "description": "The complete new effect. An effect is an object with its kind, the same for scene and clip transitions: {\"kind\":\"crossfade\"} (the incoming side fades in over the outgoing one), {\"kind\":\"fade-through-color\",\"color\":\"#rrggbb\"} (the outgoing side fades out to the colour, then the incoming one fades in from it), {\"kind\":\"slide\",\"direction\":\"left\"|\"right\"|\"up\"|\"down\"} (the incoming side slides in, moving in its direction), {\"kind\":\"wipe\",\"direction\":…} (an edge moving in its direction uncovers the incoming side), {\"kind\":\"push\",\"direction\":…} (the incoming side slides in and pushes the outgoing one out the other way), {\"kind\":\"zoom\",\"fromScale\":0.5} (the incoming side fades in while it scales from fromScale, 0 to 16, to its size about the centre of the frame), {\"kind\":\"iris\",\"center\":{\"x\":500,\"y\":500}} (a circle opens from a point given in per mille of the frame, integers 0 to 1000), or {\"kind\":\"blur-dissolve\",\"radius\":12} (the incoming side fades in and sharpens while the outgoing one blurs, radius the strongest blur in composition pixels, 0 to 1000). The frame of a clip transition is the canvas, in the space of the two nodes' parent; between clips, the colour of fade-through-color covers the frame directly below the lower clip, and when the outgoing clip lies above the incoming one, a slide moves it out, a wipe and an iris cut it away, and a crossfade and a zoom fade it out, so the incoming clip is uncovered."
        }
      },
      "required": [
        "transitionId",
        "effect"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_transition_easing",
    "description": "Sets how the progress of a transition's effect moves through its overlap: ease-in-out, for example, starts and ends the effect gently; a curve that overshoots is held within the two ends of each motion, and fade-through-color eases each of its halves. An easing is an object with its kind: {\"kind\":\"linear\"} (a constant speed), {\"kind\":\"hold\"} (the value stays until the end of the interval, at the next keyframe or at the end of the transition, then jumps), {\"kind\":\"ease-in\"} (starts slowly), {\"kind\":\"ease-out\"} (slows down at the end), {\"kind\":\"ease-in-out\"} (both), {\"kind\":\"cubic-bezier\",\"x1\":0.34,\"y1\":1.56,\"x2\":0.64,\"y2\":1} (the curve of CSS cubic-bezier(); x1 and x2 from 0 to 1, y1 and y2 from -1 to 2, where a y outside 0 to 1 overshoots and the value is held within the range of its property), or {\"kind\":\"steps\",\"count\":4,\"position\":\"end\"} (count equal jumps, 1 to 1000, at the end or the start of each interval, as CSS steps()). No time changes. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Refused with unknown-transition and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"transitionId\":\"transition-outro\",\"easing\":{\"kind\":\"ease-in-out\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces how the progress of a transition moves through its overlap; no time changes.",
      "properties": {
        "transitionId": {
          "type": "string",
          "description": "The stable ID of a scene transition or a clip transition of the document.",
          "minLength": 1
        },
        "easing": {
          "type": "object",
          "description": "The complete new easing. An easing is an object with its kind: {\"kind\":\"linear\"} (a constant speed), {\"kind\":\"hold\"} (the value stays until the end of the interval, at the next keyframe or at the end of the transition, then jumps), {\"kind\":\"ease-in\"} (starts slowly), {\"kind\":\"ease-out\"} (slows down at the end), {\"kind\":\"ease-in-out\"} (both), {\"kind\":\"cubic-bezier\",\"x1\":0.34,\"y1\":1.56,\"x2\":0.64,\"y2\":1} (the curve of CSS cubic-bezier(); x1 and x2 from 0 to 1, y1 and y2 from -1 to 2, where a y outside 0 to 1 overshoots and the value is held within the range of its property), or {\"kind\":\"steps\",\"count\":4,\"position\":\"end\"} (count equal jumps, 1 to 1000, at the end or the start of each interval, as CSS steps())."
        }
      },
      "required": [
        "transitionId",
        "easing"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_caption_words",
    "description": "Replaces every word of a captions node with a new list, as for a new transcription: each word {text, startUs, durationUs}, in the order they are spoken, each starting no earlier than the one before it ends; text is at least one character and no white space. A captions node shows timed words in a style: the runtime breaks them into lines of at most maxLineLength characters and every maxLines lines into a page, from the document alone; a page is shown from its first word until the next page starts, and the word being spoken shows the highlight of the style. Words are in scene time, like keyframes. describe_document shows the words and the style; a word is addressed by its index in words, from 0. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not captions, and invalid-result when a word is not one the document can hold or two words overlap. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-captions\",\"words\":[{\"text\":\"Made\",\"startUs\":0,\"durationUs\":300000},{\"text\":\"with\",\"startUs\":300000,\"durationUs\":200000},{\"text\":\"Kadrion\",\"startUs\":500000,\"durationUs\":600000}]}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces every word of a captions node, as a new transcription.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a captions node.",
          "minLength": 1
        },
        "words": {
          "type": "array",
          "description": "Every word of the node, in the order they are spoken; an empty list shows nothing. A word is {text, startUs, durationUs}: text is at least one character and no white space; startUs is the scene time, in integer microseconds, at which it is spoken, and durationUs how long, at least 1. A word starts no earlier than the word before it ends. Words are in scene time, like keyframes: moving the node moves them, trimming it does not.",
          "items": {
            "type": "object",
            "description": "One word, as the document stores it."
          }
        }
      },
      "required": [
        "nodeId",
        "words"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_caption_word",
    "description": "Replaces one word of a captions node with a complete word {text, startUs, durationUs}: a corrected text, a new timing, or both; it must still start no earlier than the word before it ends and end no later than the next one starts. A captions node shows timed words in a style: the runtime breaks them into lines of at most maxLineLength characters and every maxLines lines into a page, from the document alone; a page is shown from its first word until the next page starts, and the word being spoken shows the highlight of the style. Words are in scene time, like keyframes. describe_document shows the words and the style; a word is addressed by its index in words, from 0. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not captions, index-out-of-range, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-captions\",\"index\":2,\"word\":{\"text\":\"Kadrion\",\"startUs\":500000,\"durationUs\":600000}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces one word of a captions node: its text, its timing, or both.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a captions node.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The index of the word in the node's words, from 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "word": {
          "type": "object",
          "description": "The complete new word. A word is {text, startUs, durationUs}: text is at least one character and no white space; startUs is the scene time, in integer microseconds, at which it is spoken, and durationUs how long, at least 1. A word starts no earlier than the word before it ends. Words are in scene time, like keyframes: moving the node moves them, trimming it does not."
        }
      },
      "required": [
        "nodeId",
        "index",
        "word"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_caption_style",
    "description": "Replaces the style of a captions node with a complete style {fontSize, lineHeight, color, highlight, align, verticalAlign, maxLineLength, maxLines, lineBreak, stroke, shadow, box, pageIn, pageOut}: its size and colours, what the word being spoken shows (as set_caption_highlight describes it), where its lines lie in its box, how many characters fit on a line and lines on a page, which changes how the words are grouped (lineBreak \"characters\", or \"width\" to also fit each line to the box's width), the outline, shadow, and box of its lines (as set_text_style describes them, the box lying behind every line of the page shown), and how a page enters and leaves (as set_caption_page_animation describes it). No word and no time changes. A captions node shows timed words in a style: the runtime breaks them into lines of at most maxLineLength characters and every maxLines lines into a page, from the document alone; a page is shown from its first word until the next page starts, and the word being spoken shows the highlight of the style. Words are in scene time, like keyframes. describe_document shows the words and the style; a word is addressed by its index in words, from 0. Lengths and coordinates are composition pixels, rounded to integers. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not captions, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-captions\",\"style\":{\"fontSize\":64,\"lineHeight\":80,\"color\":\"#ffffff\",\"highlight\":{\"color\":\"#ffd400\",\"scale\":1,\"tracks\":[],\"underline\":{\"kind\":\"none\"},\"box\":{\"kind\":\"none\"},\"stroke\":{\"kind\":\"none\"},\"shadow\":{\"kind\":\"none\"}},\"align\":\"center\",\"verticalAlign\":\"bottom\",\"maxLineLength\":24,\"maxLines\":2,\"lineBreak\":\"width\",\"stroke\":{\"kind\":\"outside\",\"color\":\"#000000\",\"width\":3},\"shadow\":{\"kind\":\"none\"},\"box\":{\"kind\":\"none\"},\"pageIn\":{\"kind\":\"none\"},\"pageOut\":{\"kind\":\"none\"}}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces how a captions node shows its words; no word and no time changes.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a captions node.",
          "minLength": 1
        },
        "style": {
          "type": "object",
          "description": "The complete new style: {fontSize, lineHeight, color, highlight, align, verticalAlign, maxLineLength, maxLines, lineBreak, stroke, shadow, box, pageIn, pageOut}. fontSize and lineHeight are integer composition pixels; color lowercase #rrggbb; highlight what the word being spoken shows (see set_caption_highlight); align is left, center, or right; verticalAlign top, middle, or bottom; maxLineLength the most characters of a line, 1 to 1000, a space between two words counting as one; maxLines the most lines of a page, 1 to 100; stroke, shadow, and box as the style of a text, the box lying behind every line; pageIn and pageOut how a page enters and leaves (see set_caption_page_animation)."
        }
      },
      "required": [
        "nodeId",
        "style"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_style",
    "description": "Replaces how a text node is drawn besides its font, size, and colour, with a complete style {stroke, shadow, box, align, verticalAlign}; the first three each {\"kind\":\"none\"} or: stroke {\"kind\":\"outside\", color, width}, an outline of width pixels (1 to 1000) drawn outside every glyph and under its fill; shadow {\"kind\":\"drop\", color, opacity, offset: {x, y}, blur}, a shadow of the glyphs and their outline moved by offset pixels (-1000 to 1000) and blurred by blur pixels (0 to 1000); box {\"kind\":\"solid\", color, opacity, padding, cornerRadius}, a filled box behind the text that reaches padding pixels beyond its lines on every side, with rounded corners, without moving the text. align (left, center, right) and verticalAlign (top, middle, bottom) place the lines in the frame. Colours are lowercase #rrggbb, opacities 0 to 1, lengths integers. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not a text, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"style\":{\"stroke\":{\"kind\":\"outside\",\"color\":\"#000000\",\"width\":4},\"shadow\":{\"kind\":\"drop\",\"color\":\"#000000\",\"opacity\":0.6,\"offset\":{\"x\":4,\"y\":4},\"blur\":8},\"box\":{\"kind\":\"none\"},\"align\":\"center\",\"verticalAlign\":\"middle\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces the style of a text node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a text node.",
          "minLength": 1
        },
        "style": {
          "type": "object",
          "description": "The complete style: {stroke, shadow, box, align, verticalAlign}, the first three each {kind: \"none\"} or: stroke {kind: \"outside\", color, width} for an outline of width pixels (1 to 1000) outside every glyph; shadow {kind: \"drop\", color, opacity, offset: {x, y}, blur} for a shadow moved by offset pixels (-1000 to 1000) and blurred by blur pixels (0 to 1000); box {kind: \"solid\", color, opacity, padding, cornerRadius} for a filled box behind the text, padding pixels beyond its lines on every side, with rounded corners. Colours are lowercase #rrggbb, opacities 0 to 1, and lengths integers."
        }
      },
      "required": [
        "nodeId",
        "style"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_shape_geometry",
    "description": "Replaces what a shape draws with a complete geometry, in composition pixels of its box: {\"kind\":\"rect\", cornerRadius} fills the box with its corners rounded by cornerRadius pixels (above half a side it is reduced to half), its outline starting on the top edge and running clockwise; {\"kind\":\"ellipse\"} fills the box, its outline starting at its rightmost point and running clockwise; {\"kind\":\"polygon\", points} is closed through 3 to 1000 points {x, y}; {\"kind\":\"path\", fillRule, commands} is 1 to 1000 absolute commands, the first a move: {\"kind\":\"move\", x, y} starts a subpath, {\"kind\":\"line\", x, y}, {\"kind\":\"cubic\", x1, y1, x2, y2, x, y}, {\"kind\":\"quadratic\", x1, y1, x, y}, {\"kind\":\"arc\", rx, ry, rotation, largeArc, sweep, x, y} as SVG path data A, and {\"kind\":\"close\"}; fillRule \"evenodd\" leaves holes where subpaths overlap, \"nonzero\" fills them. No relative or shorthand commands: convert SVG path data to absolute M, L, C, Q, A, and Z first. Coordinates are numbers from -1000000 to 1000000 and may leave the box; a rect and an ellipse follow a size animation, a polygon and a path do not. A geometry animation must keep the structure: replace it in the same transaction. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not a shape, and invalid-result, also when a path does not start with a move or a geometry animation no longer has its structure. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-shape\",\"geometry\":{\"kind\":\"path\",\"fillRule\":\"nonzero\",\"commands\":[{\"kind\":\"move\",\"x\":0,\"y\":100},{\"kind\":\"quadratic\",\"x1\":100,\"y1\":-60,\"x\":200,\"y\":100},{\"kind\":\"close\"}]}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces what a shape draws.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a shape node.",
          "minLength": 1
        },
        "geometry": {
          "type": "object",
          "description": "The complete geometry, in composition pixels of the node's box: {kind: \"rect\", cornerRadius} fills the box, its corners rounded by cornerRadius pixels; {kind: \"ellipse\"} fills the box; {kind: \"polygon\", points} is closed through 3 to 1000 points {x, y}; {kind: \"path\", fillRule, commands} is 1 to 1000 absolute commands, the first a move: {kind: \"move\", x, y}, {kind: \"line\", x, y}, {kind: \"cubic\", x1, y1, x2, y2, x, y}, {kind: \"quadratic\", x1, y1, x, y}, {kind: \"arc\", rx, ry, rotation, largeArc, sweep, x, y}, {kind: \"close\"}, with fillRule \"nonzero\" or \"evenodd\". Coordinates are numbers from -1000000 to 1000000 and may leave the box."
        }
      },
      "required": [
        "nodeId",
        "geometry"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_shape_fill",
    "description": "Replaces what the inside of a shape is painted with: {\"kind\":\"none\"}; {\"kind\":\"solid\", color}; {\"kind\":\"linear-gradient\", start: {x, y}, end: {x, y}, stops} from the point start to the point end; or {\"kind\":\"radial-gradient\", center: {x, y}, radius, stops} about center, points and radius (at least 1) in composition pixels of its box. stops are 2 to 16 {offset, color, opacity}: offset an integer per mille of the gradient (0 at its start, 1000 at its end) in ascending order, two may share one; opacity 0 to 1; before the first and after the last stop its colour holds. Colours are lowercase #rrggbb. Only a solid fill is animated (a fill animation replaces its colour); remove a fill animation in the same transaction before another kind. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not a shape, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-shape\",\"fill\":{\"kind\":\"linear-gradient\",\"start\":{\"x\":0,\"y\":0},\"end\":{\"x\":200,\"y\":0},\"stops\":[{\"offset\":0,\"color\":\"#7a5af8\",\"opacity\":1},{\"offset\":1000,\"color\":\"#ee46bc\",\"opacity\":1}]}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces what the inside of a shape is painted with.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a shape node.",
          "minLength": 1
        },
        "fill": {
          "type": "object",
          "description": "The complete fill: {kind: \"none\"}; {kind: \"solid\", color}; {kind: \"linear-gradient\", start: {x, y}, end: {x, y}, stops}; or {kind: \"radial-gradient\", center: {x, y}, radius, stops}, points and radius in composition pixels of the node's box; stops are 2 to 16 {offset, color, opacity}, offset an integer per mille of the gradient (0 to 1000) in ascending order, opacity 0 to 1. Colours are lowercase #rrggbb."
        }
      },
      "required": [
        "nodeId",
        "fill"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_shape_stroke",
    "description": "Replaces the outline of a shape with a complete stroke {color, width, dash, cap, join}: color lowercase #rrggbb; width in composition pixels from 0 to 1000, centred on the outline, 0 for none; dash an even list of at most 16 integers, the lengths of dashes and gaps in turn in per mille of the length of the whole outline (1 to 1000), repeated from its start, [] for a solid line; cap \"butt\", \"round\", or \"square\" for the ends of open paths and of dashes; join \"miter\" (limited to 4), \"round\", or \"bevel\" for its corners. The stroke is drawn over the fill and is not cut by the box; stroke/color and stroke/width animations replace its colour and width, and the trim (set_shape_trim) chooses the part drawn. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not a shape, and invalid-result, also for an odd number of dashes. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-shape\",\"stroke\":{\"color\":\"#ffffff\",\"width\":6,\"dash\":[],\"cap\":\"round\",\"join\":\"round\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces the outline of a shape.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a shape node.",
          "minLength": 1
        },
        "stroke": {
          "type": "object",
          "description": "The complete stroke: {color, width, dash, cap, join}: color lowercase #rrggbb; width in composition pixels (0 to 1000, 0 draws none) centred on the outline; dash an even list of integer lengths of dashes and gaps in turn (1 to 1000 per mille of the whole outline, at most 16), [] for a solid stroke; cap \"butt\", \"round\", or \"square\"; join \"miter\", \"round\", or \"bevel\"."
        }
      },
      "required": [
        "nodeId",
        "stroke"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_shape_trim",
    "description": "Sets the part of the outline of a shape that its stroke draws, as integers in per mille of the length of the outline from where it starts: start 0 and end 1000 draw it all, and an end at or before the start draws none of it, caps included. The browser measures the outline; nothing about its length need be known. To draw a stroke on, animate trim/end from 0 to 1000 with add_animation; to run a segment along it, animate trim/start and trim/end together. The fill is not trimmed: set the fill to {\"kind\":\"none\"} for a line alone. Refused with invalid-argument for a value that is not an integer from 0 to 1000, unknown-node, and unsupported-node for a node that is not a shape. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-shape\",\"trim\":{\"start\":0,\"end\":500}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the part of the outline of a shape that its stroke draws.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a shape node.",
          "minLength": 1
        },
        "trim": {
          "type": "object",
          "description": "The drawn part of the outline: from start to end; 0 and 1000 is the whole outline, and an end at or before the start draws none of it. The fill is not trimmed.",
          "properties": {
            "start": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the length of the outline from where it starts, where the drawn part begins.",
              "minimum": 0,
              "maximum": 1000
            },
            "end": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the length of the outline from where it starts, where the drawn part ends.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "trim"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_blend_mode",
    "description": "Sets how an image, video, text, captions, shape, group, or instance node blends with what lies below it in its scene or group: \"normal\" lays it over; \"multiply\" darkens (white leaves what lies below, black makes black); \"screen\" lightens (black leaves it, white makes white); \"overlay\", \"soft-light\", and \"hard-light\" raise contrast; \"darken\" and \"lighten\" keep the darker or lighter channel; \"color-dodge\" and \"color-burn\" brighten or darken what lies below by the node; \"difference\" and \"exclusion\" subtract; \"hue\", \"saturation\", \"color\", and \"luminosity\" take that part of the node and the rest from what lies below. A scene or group holding a node that blends is composited on its own, so a node never blends with another scene or with what lies outside its group. The blend mode applies last, after the mask, matte, opacity, and transform. Refused with invalid-argument, unknown-node, and unsupported-node for a background or a Custom HTML node. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"blendMode\":\"screen\"}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how a node blends with what lies below it in its scene or group.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "ID of an image, video, text, captions, shape, or group node; only these blend, take a mask, and take a matte.",
          "minLength": 1
        },
        "blendMode": {
          "type": "string",
          "description": "normal lays the node over what lies below; multiply, screen, overlay, darken, lighten, color-dodge, color-burn, hard-light, soft-light, difference, and exclusion blend each colour channel; hue, saturation, color, and luminosity take that part of the node and the rest of what lies below. A scene or group holding a node that blends is composited on its own.",
          "enum": [
            "normal",
            "multiply",
            "screen",
            "overlay",
            "darken",
            "lighten",
            "color-dodge",
            "color-burn",
            "hard-light",
            "soft-light",
            "difference",
            "exclusion",
            "hue",
            "saturation",
            "color",
            "luminosity"
          ]
        }
      },
      "required": [
        "nodeId",
        "blendMode"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_mask",
    "description": "Replaces what masks an image, video, text, captions, shape, group, or instance node, applied after its effects and moving, scaling, and turning with it: {\"kind\":\"none\"}; {\"kind\":\"shape\", x, y, width, height, geometry, inverted, feather, animations} shows the node only inside a geometry ({\"kind\":\"rect\", cornerRadius} and {\"kind\":\"ellipse\"} fill the box; polygon and path as set_shape_geometry describes, in pixels of the box) drawn in the box x, y, width, height, integers in pixels from the top-left corner of the node's own box (a group's box is the canvas); {\"kind\":\"image\", assetId, x, y, width, height, mode, inverted, feather, animations} shows the node through an image asset stretched over that box, by its opacity (mode \"alpha\") or its brightness times its opacity (mode \"luminance\"), nothing outside the box. inverted true shows the node where the mask does not cover it. feather softens the edge by a blur of that many composition pixels (0 to 1000). animations are [] or at most one each of {id, property: \"geometry\", keyframes} (shape masks; every keyframe a geometry of the same structure, morphed number by number) and {id, property: \"feather\", keyframes}, keyframes {timeUs, value, easing} in scene time. Refused with invalid-argument, unknown-node, unsupported-node for a background or a Custom HTML node, and invalid-result (an unknown or non-image asset, a path that does not start with a move, a geometry keyframe of another structure). The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"mask\":{\"kind\":\"shape\",\"x\":0,\"y\":0,\"width\":400,\"height\":400,\"geometry\":{\"kind\":\"ellipse\"},\"inverted\":false,\"feather\":12,\"animations\":[]}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces what masks a node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "ID of an image, video, text, captions, shape, or group node; only these blend, take a mask, and take a matte.",
          "minLength": 1
        },
        "mask": {
          "type": "object",
          "description": "The complete mask: {kind: \"none\"}; {kind: \"shape\", x, y, width, height, geometry, inverted, feather, animations}, a geometry as a shape's (rect, ellipse, polygon, or path) drawn in the box x, y, width, height in pixels of the node's own box; or {kind: \"image\", assetId, x, y, width, height, mode, inverted, feather, animations}, an image asset stretched over that box, mode \"alpha\" or \"luminance\". inverted shows the node where the mask does not cover it; feather is the softness of the edge in composition pixels (0 to 1000). animations are [] or {id, property: \"geometry\" | \"feather\", keyframes} (geometry for a shape mask only, every keyframe of the mask's geometry structure)."
        }
      },
      "required": [
        "nodeId",
        "mask"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_matte",
    "description": "Replaces which sibling shape node mattes an image, video, text, captions, shape, group, or instance node, as a track matte: {\"kind\":\"none\"}, or {\"kind\":\"node\", nodeId, mode}. The matte is a shape node of the same scene or group (not the node itself) with no mask, no matte, the normal blend mode, and no clip transition of its own; it keeps its own transform, lifetime, opacity, effects, and animations, is drawn only into the mask of the nodes it mattes, and covers nothing while it is not active. mode \"alpha\" shows the node where the matte is opaque, \"luminance\" where it is bright and opaque, \"alpha-inverted\" and \"luminance-inverted\" the opposite. The matte lies in the space of the parent: moving the node moves it under the matte, while a mask (set_node_mask) moves with the node. A node that mattes another cannot be removed or given a matte of its own until the matte is set to none, in the same transaction. Refused with invalid-argument, unknown-node, unsupported-node for a background or a Custom HTML node, and invalid-result (no such sibling, not a shape, or a matte that is not plain). The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"matte\":{\"kind\":\"node\",\"nodeId\":\"node-shape\",\"mode\":\"alpha\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces which sibling shape mattes a node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "ID of an image, video, text, captions, shape, or group node; only these blend, take a mask, and take a matte.",
          "minLength": 1
        },
        "matte": {
          "type": "object",
          "description": "The complete matte: {kind: \"none\"}; or {kind: \"node\", nodeId, mode}, nodeId a shape node of the same scene or group that has no mask, matte, or blend mode of its own and is no side of a clip transition, mode \"alpha\", \"alpha-inverted\", \"luminance\", or \"luminance-inverted\"."
        }
      },
      "required": [
        "nodeId",
        "matte"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_text_animation",
    "description": "Animates the letters, words, or lines of a text node one after another, at an index of its text animations: {id, unit, phase, staggerUs, order, tracks}. unit is \"letter\" (a character as a reader sees it, an emoji or an accented letter included; white space is no letter), \"word\" (a run without white space), or \"line\" (a line of the text as written that holds a word). Every fragment runs the same tracks in its own time, which starts staggerUs (integer microseconds) after the fragment before it in the order: phase {\"kind\":\"in\"} starts the first fragment at the node's startUs, {\"kind\":\"out\"} ends the last fragment's last keyframe at the node's end, {\"kind\":\"accent\", startUs} starts the first at that scene time, which moves with the node. order is {\"kind\":\"forward\"}, {\"kind\":\"backward\"}, {\"kind\":\"center\"} (from the middle outwards), {\"kind\":\"edges\"} (from both ends inwards), or {\"kind\":\"random\", seed} (an unsigned 32-bit integer; the same seed gives the same order). tracks are at least one, at most one per property: {property, keyframes} with property \"opacity\" (factor 0 to 1), \"offset\" ({x, y} integer pixels from the fragment's place), \"scale\" ({x, y} factors about its centre), \"rotation\" (degrees about its centre), or \"color\" (#rrggbb that replaces the text's colour), and at least two keyframes {timeUs, value, easing} in ascending time, timeUs in the fragment's own time from 0. Before its first keyframe a fragment holds the first value, after its last the last, so an entrance usually starts at opacity 0. Several text animations combine in their order: opacities and scales multiply, offsets and rotations add, the last colour wins. A text with a text animation is drawn in fragments for its whole lifetime, without kerning between them. Refused with unknown-node, unsupported-node for a node that is not a text, index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"index\":0,\"animation\":{\"id\":\"text-title-in\",\"unit\":\"letter\",\"phase\":{\"kind\":\"in\"},\"staggerUs\":50000,\"order\":{\"kind\":\"forward\"},\"tracks\":[{\"property\":\"opacity\",\"keyframes\":[{\"timeUs\":0,\"value\":0,\"easing\":{\"kind\":\"ease-out\"}},{\"timeUs\":300000,\"value\":1,\"easing\":{\"kind\":\"linear\"}}]},{\"property\":\"offset\",\"keyframes\":[{\"timeUs\":0,\"value\":{\"x\":0,\"y\":40},\"easing\":{\"kind\":\"ease-out\"}},{\"timeUs\":300000,\"value\":{\"x\":0,\"y\":0},\"easing\":{\"kind\":\"linear\"}}]}]}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete text animation into a text node's text animations.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a text node.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The text animation's index in the node's text animations after the insertion.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "animation": {
          "type": "object",
          "description": "The complete text animation, its ID unused in the document. A text animation is {id, unit, phase, staggerUs, order, tracks}: unit \"letter\", \"word\", or \"line\"; phase {kind: \"in\"} (the first fragment starts at the node's start), {kind: \"out\"} (the last fragment ends at the node's end), or {kind: \"accent\", startUs} (the first fragment starts at that scene time); staggerUs the integer microseconds between two fragments that follow each other; order {kind: \"forward\"}, {kind: \"backward\"}, {kind: \"center\"}, {kind: \"edges\"}, or {kind: \"random\", seed} with an unsigned 32-bit integer seed; tracks at least one, at most one per property, each {property, keyframes} with property \"opacity\" (a factor 0 to 1), \"offset\" ({x, y} integer pixels added), \"scale\" ({x, y} factors about the fragment's centre), \"rotation\" (degrees added, about its centre), or \"color\" (#rrggbb that replaces the text's colour), and at least two keyframes {timeUs, value, easing} in ascending time, timeUs in the fragment's own time from 0."
        }
      },
      "required": [
        "nodeId",
        "index",
        "animation"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_text_animation",
    "description": "Removes one text animation of a text node with all its tracks; a text left without text animations is drawn in one piece again. Refused with unknown-animation when no text animation has the ID and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"textAnimationId\":\"text-title-in\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes one text animation with all its tracks.",
      "properties": {
        "textAnimationId": {
          "type": "string",
          "description": "The ID of a text animation of the document.",
          "minLength": 1
        }
      },
      "required": [
        "textAnimationId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_animation",
    "description": "Replaces a text animation with a complete new one of the same ID, as add_text_animation describes it: its unit, phase, staggerUs, order, and tracks. Refused with unknown-animation when no text animation has its id, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animation\":{\"id\":\"text-title-in\",\"unit\":\"word\",\"phase\":{\"kind\":\"in\"},\"staggerUs\":120000,\"order\":{\"kind\":\"center\"},\"tracks\":[{\"property\":\"scale\",\"keyframes\":[{\"timeUs\":0,\"value\":{\"x\":0,\"y\":0},\"easing\":{\"kind\":\"ease-out\"}},{\"timeUs\":400000,\"value\":{\"x\":1,\"y\":1},\"easing\":{\"kind\":\"linear\"}}]}]}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces the text animation with the same ID.",
      "properties": {
        "animation": {
          "type": "object",
          "description": "The complete new text animation; its id names the text animation it replaces. A text animation is {id, unit, phase, staggerUs, order, tracks}: unit \"letter\", \"word\", or \"line\"; phase {kind: \"in\"} (the first fragment starts at the node's start), {kind: \"out\"} (the last fragment ends at the node's end), or {kind: \"accent\", startUs} (the first fragment starts at that scene time); staggerUs the integer microseconds between two fragments that follow each other; order {kind: \"forward\"}, {kind: \"backward\"}, {kind: \"center\"}, {kind: \"edges\"}, or {kind: \"random\", seed} with an unsigned 32-bit integer seed; tracks at least one, at most one per property, each {property, keyframes} with property \"opacity\" (a factor 0 to 1), \"offset\" ({x, y} integer pixels added), \"scale\" ({x, y} factors about the fragment's centre), \"rotation\" (degrees added, about its centre), or \"color\" (#rrggbb that replaces the text's colour), and at least two keyframes {timeUs, value, easing} in ascending time, timeUs in the fragment's own time from 0."
        }
      },
      "required": [
        "animation"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_caption_highlight",
    "description": "Replaces what the word being spoken shows in a captions node, from its startUs for its durationUs and at no other time, with a complete highlight {color, scale, tracks, underline, box, stroke, shadow}: color its colour (lowercase #rrggbb); scale a factor of its size about its centre on both axes (1 for none, 1.2 to make it grow); tracks, at most one per property, {property, keyframes} as the tracks of add_text_animation (opacity, offset, scale, rotation, color) in the word's own time from 0 at its startUs, for a bounce or a pop, [] for none; underline {\"kind\":\"none\"} or {\"kind\":\"solid\", color, thickness, offset}, a bar as wide as the word, thickness pixels (1 to 1000) tall, its bottom edge offset pixels (-1000 to 1000) below the bottom of the word's line; box {\"kind\":\"none\"} or {\"kind\":\"solid\", color, opacity, padding, cornerRadius}, a filled box behind the word; stroke and shadow as set_text_style's, on the spoken word. A scaled or moving word never pushes its neighbours: lines and pages stay as they are. Any scale, track, underline, or box draws the node in pieces (an element per line and per word) for its whole lifetime. A captions node shows timed words in a style: the runtime breaks them into lines of at most maxLineLength characters and every maxLines lines into a page, from the document alone; a page is shown from its first word until the next page starts, and the word being spoken shows the highlight of the style. Words are in scene time, like keyframes. describe_document shows the words and the style; a word is addressed by its index in words, from 0. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not captions, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-captions\",\"highlight\":{\"color\":\"#ffd400\",\"scale\":1.15,\"tracks\":[{\"property\":\"offset\",\"keyframes\":[{\"timeUs\":0,\"value\":{\"x\":0,\"y\":0},\"easing\":{\"kind\":\"ease-out\"}},{\"timeUs\":100000,\"value\":{\"x\":0,\"y\":-12},\"easing\":{\"kind\":\"ease-in\"}},{\"timeUs\":200000,\"value\":{\"x\":0,\"y\":0},\"easing\":{\"kind\":\"linear\"}}]}],\"underline\":{\"kind\":\"solid\",\"color\":\"#ffd400\",\"thickness\":4,\"offset\":2},\"box\":{\"kind\":\"none\"},\"stroke\":{\"kind\":\"outside\",\"color\":\"#000000\",\"width\":3},\"shadow\":{\"kind\":\"none\"}}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces what the word being spoken shows in a captions node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a captions node.",
          "minLength": 1
        },
        "highlight": {
          "type": "object",
          "description": "The complete highlight: {color, scale, tracks, underline, box, stroke, shadow}, shown on the word being spoken from its startUs for its durationUs and at no other time. color is lowercase #rrggbb; scale a factor of its size about its centre on both axes, 1 for none; tracks a list, at most one per property, of {property, keyframes} as the tracks of a text animation, in the word's own time from 0 at its startUs (a bounce, a pop), [] for none; underline {kind: \"none\"} or {kind: \"solid\", color, thickness, offset}, a bar as wide as the word, thickness pixels (1 to 1000) tall, its bottom edge offset pixels (-1000 to 1000) below the bottom of the word's line; box {kind: \"none\"} or {kind: \"solid\", color, opacity, padding, cornerRadius} behind the word. A scaled or moving word never pushes its neighbours: lines and pages stay as they are."
        }
      },
      "required": [
        "nodeId",
        "highlight"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_caption_page_animation",
    "description": "Replaces how every page of a captions node enters (phase \"in\") or leaves (phase \"out\") with a complete page animation: {\"kind\":\"none\"} for at once, or {\"kind\":\"animate\", unit, staggerUs, order, tracks}: unit \"word\" or \"line\" of the page; every fragment runs the same tracks in its own time, which starts staggerUs (integer microseconds) after the fragment before it in the order; order and tracks as for add_text_animation. An entrance starts the first fragment's own time at the start of the page's first word; an exit ends the last fragment's last keyframe at the start of the next page, or on the last page at the end of the last word, so an exit usually ends at opacity 0. The page shown, and the words and lines on it, stay those of the style. An animated page draws the node in pieces for its whole lifetime. A captions node shows timed words in a style: the runtime breaks them into lines of at most maxLineLength characters and every maxLines lines into a page, from the document alone; a page is shown from its first word until the next page starts, and the word being spoken shows the highlight of the style. Words are in scene time, like keyframes. describe_document shows the words and the style; a word is addressed by its index in words, from 0. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not captions, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-captions\",\"phase\":\"in\",\"animation\":{\"kind\":\"animate\",\"unit\":\"word\",\"staggerUs\":60000,\"order\":{\"kind\":\"forward\"},\"tracks\":[{\"property\":\"opacity\",\"keyframes\":[{\"timeUs\":0,\"value\":0,\"easing\":{\"kind\":\"linear\"}},{\"timeUs\":200000,\"value\":1,\"easing\":{\"kind\":\"linear\"}}]},{\"property\":\"offset\",\"keyframes\":[{\"timeUs\":0,\"value\":{\"x\":0,\"y\":24},\"easing\":{\"kind\":\"ease-out\"}},{\"timeUs\":200000,\"value\":{\"x\":0,\"y\":0},\"easing\":{\"kind\":\"linear\"}}]}]}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces how every page of a captions node enters or leaves.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a captions node.",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "description": "in for how a page enters, out for how it leaves.",
          "enum": [
            "in",
            "out"
          ]
        },
        "animation": {
          "type": "object",
          "description": "The complete page animation: {kind: \"none\"}, or {kind: \"animate\", unit, staggerUs, order, tracks} with unit \"word\" or \"line\" of the page, staggerUs the integer microseconds between two fragments that follow each other, order as for a text animation, and tracks as for a text animation, in each fragment's own time. An entrance starts the first fragment at the start of the page's first word; an exit ends the last fragment's last keyframe at the start of the next page, or on the last page at the end of the last word."
        }
      },
      "required": [
        "nodeId",
        "phase",
        "animation"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_effect",
    "description": "Adds an effect to an image, video, text, captions node, group, or instance, or to a whole scene, at an index of its effects: effects apply in their order, the first to the content itself, after the corner radius and before the opacity and the transform, so a blur or a shadow turns and scales with the node; a group's or a scene's effects apply to everything in it composited together, and a scene transition then acts on the result. The effect is {id, kind, ...parameters, animations}: \"blur\" {radius} blurs by a Gaussian of that standard deviation in composition pixels (0 to 1000) and spills beyond the box; \"brightness\", \"contrast\", and \"saturate\" {amount} scale by a factor from 0 to 10 (1 changes nothing; brightness 0 is black, contrast and saturate 0 grey); \"grayscale\", \"invert\", and \"sepia\" {amount} apply from 0 (nothing) to 1 (all grey, the negative, all sepia); \"hue-rotate\" {angle} turns every hue by degrees; \"drop-shadow\" {color, opacity, offset {x, y}, blur} casts the shape's shadow (lowercase #rrggbb, 0 to 1, pixels -1000 to 1000, a blur radius 0 to 1000). Drawn by SVG filters in sRGB: \"curves\" {red, green, blue, amount} maps each channel through a table of 2 to 32 output levels from 0 to 1 at evenly spaced inputs ([0, 1] changes nothing, [1, 0] inverts) and mixes the result in by amount 0 to 1 (only amount animates); \"color-grade\" {lift, gamma, gain, temperature, tint} is a primary grade: white balance first (temperature -1 to 1 warms above 0, tint -1 to 1 goes magenta above 0), then black to lift (-1 to 1) and white to gain (0 to 10), then gamma 0.1 to 10 brightens the mid-tones above 1 (0, 1, 1, 0, 0 change nothing); \"glow\" {color, opacity, radius} draws the shape blurred by radius (0 to 1000, it spills beyond the box) and filled with the colour under it; \"vignette\" {amount, size} darkens the box towards its edges, amount 0 to 1, size 0.05 to 10 (small is tight, 0.5 typical); \"chroma-key\" {key, tolerance, softness, spill} makes a green or blue screen transparent by channel difference: a pixel goes transparent as its key channel exceeds the mean of the other two by tolerance (0 to 1, about 0.1) over softness (0.01 to 1, about 0.1), and spill 0 to 1 pulls the key colour out of what remains; it keys a channel, not any colour. animations animate parameters: at most one per parameter, {id, property, keyframes} with property the parameter's name (radius, amount, angle, color, opacity, offset, blur, lift, gamma, gain, temperature, tint, size, tolerance, softness, spill) and at least two keyframes {timeUs, value, easing} in ascending scene time, like a node's keyframes; a sampled value replaces the parameter, and before the first and after the last keyframe the nearest value holds; [] for none. An easing is an object with its kind: {\"kind\":\"linear\"} (a constant speed), {\"kind\":\"hold\"} (the value stays until the end of the interval, at the next keyframe or at the end of the transition, then jumps), {\"kind\":\"ease-in\"} (starts slowly), {\"kind\":\"ease-out\"} (slows down at the end), {\"kind\":\"ease-in-out\"} (both), {\"kind\":\"cubic-bezier\",\"x1\":0.34,\"y1\":1.56,\"x2\":0.64,\"y2\":1} (the curve of CSS cubic-bezier(); x1 and x2 from 0 to 1, y1 and y2 from -1 to 2, where a y outside 0 to 1 overshoots and the value is held within the range of its property), or {\"kind\":\"steps\",\"count\":4,\"position\":\"end\"} (count equal jumps, 1 to 1000, at the end or the start of each interval, as CSS steps()). An effect whose values change nothing still draws its holder in a pass of its own, a few levels from none; remove_effect for none. Refused with unknown-node when ownerId names no node or scene, unsupported-node for a background or Custom HTML, index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"ownerId\":\"node-image\",\"index\":0,\"effect\":{\"id\":\"effect-image-blur\",\"kind\":\"blur\",\"radius\":0,\"animations\":[{\"id\":\"effect-image-blur-a-radius\",\"property\":\"radius\",\"keyframes\":[{\"timeUs\":0,\"value\":12,\"easing\":{\"kind\":\"ease-out\"}},{\"timeUs\":600000,\"value\":0,\"easing\":{\"kind\":\"linear\"}}]}]}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete effect into the effects of a node or a scene.",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "The stable ID of an image, video, text, captions node, or group, or of a scene, which takes the effect.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The effect's index in its owner's effects after the edit: 0 applies first.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effect": {
          "type": "object",
          "description": "The complete effect, its ID and those of its animations unused in the document. An effect is {id, kind, ...parameters, animations}: kind \"blur\" {radius} (the standard deviation in composition pixels, 0 to 1000; the blur spills beyond the box), \"brightness\", \"contrast\", or \"saturate\" {amount} (a factor 0 to 10, 1 changes nothing), \"grayscale\", \"invert\", or \"sepia\" {amount} (0 changes nothing to 1 for all of it), \"hue-rotate\" {angle} (degrees), or \"drop-shadow\" {color, opacity, offset {x, y}, blur} (lowercase #rrggbb, 0 to 1, pixels -1000 to 1000, a blur radius 0 to 1000); or, as SVG filters, \"curves\" {red, green, blue, amount} (2 to 32 output levels 0 to 1 per channel, [0, 1] changes nothing; amount 0 to 1 mixes them in), \"color-grade\" {lift, gamma, gain, temperature, tint} (-1 to 1, 0.1 to 10, 0 to 10, -1 to 1, -1 to 1; 0, 1, 1, 0, 0 change nothing), \"glow\" {color, opacity, radius} (a blurred copy of the shape in the colour, drawn under it), \"vignette\" {amount, size} (0 to 1 darkness of the edges; 0.05 to 10, small is tight), or \"chroma-key\" {key, tolerance, softness, spill} (key \"green\" or \"blue\"; 0 to 1, 0.01 to 1, 0 to 1). animations is a list, at most one per parameter, of {id, property, keyframes} with property the parameter's name and at least two keyframes {timeUs, value, easing} in ascending scene time; a sampled value replaces the parameter; [] for none."
        }
      },
      "required": [
        "ownerId",
        "index",
        "effect"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_effect",
    "description": "Removes one effect of a node or a scene with its animations; a node or a scene left without effects is drawn without a filter again, exactly as before it had one. Refused with unknown-effect when no effect has the ID. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"effectId\":\"effect-image-blur\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes one effect with its animations.",
      "properties": {
        "effectId": {
          "type": "string",
          "description": "The stable ID of an effect of a node or a scene of the document.",
          "minLength": 1
        }
      },
      "required": [
        "effectId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "reorder_effect",
    "description": "Moves one effect to another index of its owner's effects: 0 applies first, to the content itself. The order matters: a blur before a drop shadow blurs the shape whose shadow is cast, after it blurs the shadow too. Refused with unknown-effect and index-out-of-range. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"effectId\":\"effect-image-blur\",\"index\":1}",
    "inputSchema": {
      "type": "object",
      "description": "Moves one effect to another place in the order of its owner's effects.",
      "properties": {
        "effectId": {
          "type": "string",
          "description": "The stable ID of an effect of a node or a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The effect's index in its owner's effects after the edit: 0 applies first.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "effectId",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_effect",
    "description": "Replaces an effect with a complete new one of the same ID, as add_effect describes it: its kind, its parameters, and its animations, whose new IDs are unused in the document. To change one keyframe, send the whole effect with that keyframe changed. Refused with unknown-effect when no effect has its id, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"effect\":{\"id\":\"effect-image-blur\",\"kind\":\"drop-shadow\",\"color\":\"#000000\",\"opacity\":0.5,\"offset\":{\"x\":0,\"y\":8},\"blur\":16,\"animations\":[]}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces the effect with the same ID.",
      "properties": {
        "effect": {
          "type": "object",
          "description": "The complete new effect; its id names the effect it replaces, and the IDs of new animations are unused in the document. An effect is {id, kind, ...parameters, animations}: kind \"blur\" {radius} (the standard deviation in composition pixels, 0 to 1000; the blur spills beyond the box), \"brightness\", \"contrast\", or \"saturate\" {amount} (a factor 0 to 10, 1 changes nothing), \"grayscale\", \"invert\", or \"sepia\" {amount} (0 changes nothing to 1 for all of it), \"hue-rotate\" {angle} (degrees), or \"drop-shadow\" {color, opacity, offset {x, y}, blur} (lowercase #rrggbb, 0 to 1, pixels -1000 to 1000, a blur radius 0 to 1000); or, as SVG filters, \"curves\" {red, green, blue, amount} (2 to 32 output levels 0 to 1 per channel, [0, 1] changes nothing; amount 0 to 1 mixes them in), \"color-grade\" {lift, gamma, gain, temperature, tint} (-1 to 1, 0.1 to 10, 0 to 10, -1 to 1, -1 to 1; 0, 1, 1, 0, 0 change nothing), \"glow\" {color, opacity, radius} (a blurred copy of the shape in the colour, drawn under it), \"vignette\" {amount, size} (0 to 1 darkness of the edges; 0.05 to 10, small is tight), or \"chroma-key\" {key, tolerance, softness, spill} (key \"green\" or \"blue\"; 0 to 1, 0.01 to 1, 0 to 1). animations is a list, at most one per parameter, of {id, property, keyframes} with property the parameter's name and at least two keyframes {timeUs, value, easing} in ascending scene time; a sampled value replaces the parameter; [] for none."
        }
      },
      "required": [
        "effect"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_safe_area",
    "description": "Replaces the safe area of the composition, {fromTop, fromRight, fromBottom, fromLeft}: integer composition pixels from each edge of the canvas to the part of the frame where captions and other text that must be read belong, clear of what a platform draws over the video; two opposite insets leave at least 1 pixel, and all zero is the whole canvas. It is a frame of reference, not a clip: it cuts and moves nothing, and nothing outside it is hidden. Keep captions inside it by placing their box with set_node_position and set_node_size. describe_document shows it. Refused with invalid-argument and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"safeArea\":{\"fromTop\":160,\"fromRight\":64,\"fromBottom\":320,\"fromLeft\":64}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces the safe area of the composition.",
      "properties": {
        "safeArea": {
          "type": "object",
          "description": "The complete safe area: {fromTop, fromRight, fromBottom, fromLeft}, integer composition pixels from each edge of the canvas; two opposite insets leave at least 1 pixel, and all zero is the whole canvas."
        }
      },
      "required": [
        "safeArea"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_template_input",
    "description": "Inserts an input into the template: {id, type, ...constraints, default}, with an ID unused in the document. A text has minLength and maxLength in code points, a number minimum and maximum, a boolean, a color (lowercase #rrggbb), an image, video, or audio only a default content hash, and a list minItems, maxItems, fields ({key, type, ...constraints}, no list among them), and a default whose items each list one {key, type, value} per field in their order; the default meets the constraints. Nothing reads a new input until a binding does; a boolean or a list is read by no binding yet. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into a parameter of a Custom HTML element (an input of the type of the parameter), into the {{inputId}} placeholders of the text of a text node, into the words of a captions node (a list whose fields are text, startUs, and durationUs), or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with index-out-of-range, id-in-use, and invalid-result when the input is not one the document can hold. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":0,\"input\":{\"id\":\"headline\",\"type\":\"text\",\"minLength\":1,\"maxLength\":40,\"default\":\"Kadrion\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts an input into the template section of the document.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The input's index in the template's inputs after the insertion, from 0 to their number.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input": {
          "type": "object",
          "description": "The complete input as the document stores it, with an ID unused in the document. An input is {id, type, ...constraints, default}: a text {minLength, maxLength} in code points, a number {minimum, maximum}, a boolean, a color (lowercase #rrggbb), an image, video, or audio (the default a content hash, sha256: and 64 hex digits), or a list {minItems, maxItems, fields, default}: each field {key, type, ...constraints} of a type other than list, and each item of the default a list with one {key, type, value} for each field, in their order. The default meets the constraints."
        }
      },
      "required": [
        "index",
        "input"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_template_input",
    "description": "Removes an input of the template. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into a parameter of a Custom HTML element (an input of the type of the parameter), into the {{inputId}} placeholders of the text of a text node, into the words of a captions node (a list whose fields are text, startUs, and durationUs), or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with unknown-input, and input-in-use with the IDs of the bindings that still use it, a placeholder included: remove them first, in the same transaction. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"inputId\":\"headline\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes an input that no binding and no placeholder uses.",
      "properties": {
        "inputId": {
          "type": "string",
          "description": "The stable ID of an input of the template.",
          "minLength": 1
        }
      },
      "required": [
        "inputId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_template_input",
    "description": "Replaces an input with a complete new one of the same ID — new constraints, a new default, or both — and writes its default into every property and asset bound to it, so that the preview shows it. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into a parameter of a Custom HTML element (an input of the type of the parameter), into the {{inputId}} placeholders of the text of a text node, into the words of a captions node (a list whose fields are text, startUs, and durationUs), or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with invalid-argument when input.id is not inputId, unknown-input, and invalid-result when the input is not one the document can hold or no longer fits its bindings. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"inputId\":\"headline\",\"input\":{\"id\":\"headline\",\"type\":\"text\",\"minLength\":1,\"maxLength\":40,\"default\":\"Launch day\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces an input with a complete new one of the same ID, and writes its default into every property and asset bound to it.",
      "properties": {
        "inputId": {
          "type": "string",
          "description": "The stable ID of an input of the template.",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "description": "The complete new input, with the same ID. An input is {id, type, ...constraints, default}: a text {minLength, maxLength} in code points, a number {minimum, maximum}, a boolean, a color (lowercase #rrggbb), an image, video, or audio (the default a content hash, sha256: and 64 hex digits), or a list {minItems, maxItems, fields, default}: each field {key, type, ...constraints} of a type other than list, and each item of the default a list with one {key, type, value} for each field, in their order. The default meets the constraints."
        }
      },
      "required": [
        "inputId",
        "input"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_template_binding",
    "description": "Inserts a binding: {id, kind: \"property\", nodeId, property: \"text\" or \"color\", inputId}, {id, kind: \"placeholders\", nodeId}, {id, kind: \"asset\", assetId, inputId}, {id, kind: \"item-property\", nodeId, property, inputId, key}, or {id, kind: \"item-asset\", assetId, inputId, key}, with an ID unused in the document. The target of an input binding must already hold the input's default (set it first, in the same transaction); a text with placeholders names text or number inputs, or {{list.key}} text or number fields of a list that repeats the node; an item binding reads a field of a list whose repeat holds its node, or every use of its asset; and at most one binding writes a target. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into a parameter of a Custom HTML element (an input of the type of the parameter), into the {{inputId}} placeholders of the text of a text node, into the words of a captions node (a list whose fields are text, startUs, and durationUs), or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":0,\"binding\":{\"id\":\"bind-headline\",\"kind\":\"property\",\"nodeId\":\"node-title\",\"property\":\"text\",\"inputId\":\"headline\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a binding from an input to a property, the placeholders of a text, or an asset.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The binding's index in the template's bindings after the insertion, from 0 to their number; their order has no meaning.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "binding": {
          "type": "object",
          "description": "The complete binding as the document stores it, with an ID unused in the document. A binding is {id, kind: \"property\", nodeId, property, inputId} — the text of a text node takes a text input, the color of a text or a background a color input —, {id, kind: \"placeholders\", nodeId} — every {{inputId}} in the text of a text node stands for a text or number input, and inside a repeat over a list every {{list.key}} for a text or number field of the item —, {id, kind: \"asset\", assetId, inputId} — an image, video, or audio asset takes the content hash of an input of its type —, {id, kind: \"item-property\", nodeId, property, inputId, key} — inside a repeat over the list inputId, the text or color of the node takes the field key of the item of its copy —, or {id, kind: \"item-asset\", assetId, inputId, key} — an asset used only inside a repeat over the list becomes one asset per item, with the content hash of the field key. A property or asset bound to an input holds its default; at most one binding writes a target."
        }
      },
      "required": [
        "index",
        "binding"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_template_binding",
    "description": "Removes a binding; its property, text, or asset keeps the value it holds. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into a parameter of a Custom HTML element (an input of the type of the parameter), into the {{inputId}} placeholders of the text of a text node, into the words of a captions node (a list whose fields are text, startUs, and durationUs), or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with unknown-binding. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"bindingId\":\"bind-headline\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a binding; its target keeps the value it holds.",
      "properties": {
        "bindingId": {
          "type": "string",
          "description": "The stable ID of a binding of the template.",
          "minLength": 1
        }
      },
      "required": [
        "bindingId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_template_condition",
    "description": "Inserts a condition: {id, test: \"empty\" or \"not-empty\", targetId, inputId} for a text or list input, {id, test: \"true\" or \"false\", targetId, inputId} for a boolean, {id, test: \"equal-text\", targetId, inputId, value} for a text, or {id, test: \"equal-number\", targetId, inputId, value} for a number, with an ID unused in the document; targetId names a scene or a node. The template shows the target as it stands; an instantiation removes it, with everything in it and every transition that names it, when the test does not hold. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into a parameter of a Custom HTML element (an input of the type of the parameter), into the {{inputId}} placeholders of the text of a text node, into the words of a captions node (a list whose fields are text, startUs, and durationUs), or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":0,\"condition\":{\"id\":\"when-title\",\"test\":\"true\",\"targetId\":\"node-title\",\"inputId\":\"show-title\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a condition: its scene or node is kept only while its test of an input holds.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The condition's index in the template's conditions after the insertion, from 0 to their number; their order has no meaning.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "condition": {
          "type": "object",
          "description": "The complete condition as the document stores it, with an ID unused in the document. A condition is {id, test, targetId, inputId} with test \"empty\" or \"not-empty\" (a text or list input), \"true\" or \"false\" (a boolean input), or {id, test: \"equal-text\", targetId, inputId, value: a text} or {id, test: \"equal-number\", targetId, inputId, value: a number}; targetId names a scene or a node. When a test does not hold, instantiation removes the target with everything in it and every transition that names it; every condition of a target must hold."
        }
      },
      "required": [
        "index",
        "condition"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_template_condition",
    "description": "Removes a condition; its target is kept whatever the inputs. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into a parameter of a Custom HTML element (an input of the type of the parameter), into the {{inputId}} placeholders of the text of a text node, into the words of a captions node (a list whose fields are text, startUs, and durationUs), or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with unknown-condition. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"conditionId\":\"when-title\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a condition; its target is kept whatever the inputs.",
      "properties": {
        "conditionId": {
          "type": "string",
          "description": "The stable ID of a condition of the template.",
          "minLength": 1
        }
      },
      "required": [
        "conditionId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_template_repeat",
    "description": "Inserts a repeat: {id, duration: \"target\", targetId, inputId}, every copy as long as the target, or {id, duration: \"field\", targetId, inputId, key}, every copy as long as the number field key of its item names in microseconds, with an ID unused in the document; inputId names a list input and targetId a scene or a node. An instantiation replaces the target by one copy per item, in their order and one after the other, with IDs <id>--<index>: a scene copy follows the scene before it, a node copy starts where the one before it ends, its keyframes and words moved with it; transitions into a repeated scene meet its first copy and those out of it its last. A target is repeated once at most and never inside another repeated one, a repeated node is no side of a clip transition, and no ID of the document may have the form of a copy's. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into a parameter of a Custom HTML element (an input of the type of the parameter), into the {{inputId}} placeholders of the text of a text node, into the words of a captions node (a list whose fields are text, startUs, and durationUs), or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":0,\"repeat\":{\"id\":\"each-title\",\"duration\":\"target\",\"targetId\":\"node-title\",\"inputId\":\"people\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a repeat: its scene or node is copied once for each item of a list.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The repeat's index in the template's repeats after the insertion, from 0 to their number; their order has no meaning.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repeat": {
          "type": "object",
          "description": "The complete repeat as the document stores it, with an ID unused in the document. A repeat is {id, duration: \"target\", targetId, inputId} — every copy lasts the durationUs of the target — or {id, duration: \"field\", targetId, inputId, key} — every copy lasts the microseconds a number field of its item names; inputId names a list input, targetId a scene or a node. Instantiation replaces the target by one copy for each item, one after the other, with IDs <id>--<index>; a target is repeated once at most, never inside another repeated one, and a repeated node is no side of a clip transition."
        }
      },
      "required": [
        "index",
        "repeat"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_template_repeat",
    "description": "Removes a repeat; its target is shown once, as it stands. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into a parameter of a Custom HTML element (an input of the type of the parameter), into the {{inputId}} placeholders of the text of a text node, into the words of a captions node (a list whose fields are text, startUs, and durationUs), or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with unknown-repeat, and invalid-result while an item binding or a {{list.key}} placeholder still needs it: remove those first, in the same transaction. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"repeatId\":\"each-title\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a repeat; its target is shown once, as it stands.",
      "properties": {
        "repeatId": {
          "type": "string",
          "description": "The stable ID of a repeat of the template.",
          "minLength": 1
        }
      },
      "required": [
        "repeatId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_definition",
    "description": "Inserts one complete definition at an index of the definitions. A definition is a composition built once, with its own canvas (width, height), durationUs, nodes, clips, and clip transitions, and no video or Custom HTML; an instance node places it as one layer: at scene time t it shows the definition at sourceStartUs + (t - startUs), its canvas fitted to the instance's box. Every node, clip, and transition command works inside a definition as in a scene, by the IDs of its nodes, and a definition's ID is a parentId of add_node and a sceneId of add_scene_audio_clip and add_clip_transition; an edit inside a definition changes every instance of it. A definition with a template is an element: an instance gives values to its inputs (set_instance_input, clear_instance_input), and shows the definition instantiated with them, the inputs it gives no value taking their defaults; an element's inputs hold no assets, and its template is edited by replace_definition only. describe_document shows the definitions with their templates, and the values of each instance. The definition is given exactly as the document stores it: an ID unused in the document, a sourceHash ('' or the host's sha256: label of the source it was made from, never checked), width and height in pixels, durationUs (at least 1), its nodes from the bottom layer to the top (each as add_node takes one), its audio clips, its clip transitions, and its template (inputs, bindings, conditions, repeats; all empty for a definition that is no element), every ID unused in the document, every time in definition time. Place it with add_node and an instance node. Refused with index-out-of-range, id-in-use with the IDs already taken, and invalid-result when the definition is not one the document can hold. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":0,\"definition\":{\"id\":\"definition-badge\",\"sourceHash\":\"\",\"width\":200,\"height\":200,\"durationUs\":1000000,\"nodes\":[{\"id\":\"node-badge-background\",\"type\":\"background\",\"startUs\":0,\"durationUs\":1000000,\"color\":\"#000000\",\"animations\":[]}],\"clips\":[],\"transitions\":[],\"template\":{\"inputs\":[],\"bindings\":[],\"conditions\":[],\"repeats\":[]}}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete definition, a nested composition with its own canvas and time that instance nodes place.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The index in the definitions after the insertion, from 0 to the number of definitions; the order means nothing for the picture.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "definition": {
          "type": "object",
          "description": "The complete definition as the document stores it: its ID, width, height, durationUs, nodes, clips, and transitions, every ID of it unused in the document, every time in it definition time."
        }
      },
      "required": [
        "index",
        "definition"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_definition",
    "description": "Removes one definition with its nodes and clips; its assets stay declared. A definition is a composition built once, with its own canvas (width, height), durationUs, nodes, clips, and clip transitions, and no video or Custom HTML; an instance node places it as one layer: at scene time t it shows the definition at sourceStartUs + (t - startUs), its canvas fitted to the instance's box. Every node, clip, and transition command works inside a definition as in a scene, by the IDs of its nodes, and a definition's ID is a parentId of add_node and a sceneId of add_scene_audio_clip and add_clip_transition; an edit inside a definition changes every instance of it. A definition with a template is an element: an instance gives values to its inputs (set_instance_input, clear_instance_input), and shows the definition instantiated with them, the inputs it gives no value taking their defaults; an element's inputs hold no assets, and its template is edited by replace_definition only. describe_document shows the definitions with their templates, and the values of each instance. Refused with unknown-definition, and definition-in-use with the IDs of the instances that place it: remove or expand them first, in the same transaction. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"definitionId\":\"definition-badge\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a definition with everything in it; no instance may place it.",
      "properties": {
        "definitionId": {
          "type": "string",
          "description": "The stable ID of a definition of the document.",
          "minLength": 1
        }
      },
      "required": [
        "definitionId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "convert_to_definition",
    "description": "Moves a run of sibling nodes, from fromNodeId up to toNodeId in layer order, out of a scene or a definition into a new definition with the canvas and duration of that holder, and puts one instance of it in their place, showing them as before: from time 0 over the whole holder, filling the canvas, untransformed. The nodes keep their IDs and times. A definition is a composition built once, with its own canvas (width, height), durationUs, nodes, clips, and clip transitions, and no video or Custom HTML; an instance node places it as one layer: at scene time t it shows the definition at sourceStartUs + (t - startUs), its canvas fitted to the instance's box. Every node, clip, and transition command works inside a definition as in a scene, by the IDs of its nodes, and a definition's ID is a parentId of add_node and a sceneId of add_scene_audio_clip and add_clip_transition; an edit inside a definition changes every instance of it. A definition with a template is an element: an instance gives values to its inputs (set_instance_input, clear_instance_input), and shows the definition instantiated with them, the inputs it gives no value taking their defaults; an element's inputs hold no assets, and its template is edited by replace_definition only. describe_document shows the definitions with their templates, and the values of each instance. The instance composites its nodes as one layer, so a blend mode inside it blends with the nodes of the definition only. Refused with unknown-node, unsupported-node for a child of a group or when toNodeId is not a sibling at or above fromNodeId, invalid-argument when a new ID is not of the document's form or the two new IDs are equal, index-out-of-range, id-in-use, transition-in-use and matte-in-use while a transition or a matte joins a moved and a staying node (remove them first, in the same transaction), and invalid-result when a moved node cannot be in a definition (a video or Custom HTML node). The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"fromNodeId\":\"node-group\",\"toNodeId\":\"node-group\",\"definitionId\":\"definition-group\",\"instanceId\":\"node-group-instance\",\"index\":0}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a run of sibling nodes of a scene or a definition into a new definition of the holder's canvas and duration, and places one instance of it, showing it unchanged, at the run's place.",
      "properties": {
        "fromNodeId": {
          "type": "string",
          "description": "The lowest layer of the run: a node of a scene or a definition, not a child of a group.",
          "minLength": 1
        },
        "toNodeId": {
          "type": "string",
          "description": "The highest layer of the run, a sibling at or above fromNodeId; equal to fromNodeId for one node.",
          "minLength": 1
        },
        "definitionId": {
          "type": "string",
          "description": "The ID of the new definition, unused in the document.",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "instanceId": {
          "type": "string",
          "description": "The ID of the new instance node, unused in the document.",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "index": {
          "type": "integer",
          "description": "The new definition's index in the definitions, from 0 to their number.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "fromNodeId",
        "toNodeId",
        "definitionId",
        "instanceId",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "expand_instance",
    "description": "Puts the nodes of an instance's definition in the instance's place, with their IDs and times, and removes the definition: the inverse of convert_to_definition. A definition is a composition built once, with its own canvas (width, height), durationUs, nodes, clips, and clip transitions, and no video or Custom HTML; an instance node places it as one layer: at scene time t it shows the definition at sourceStartUs + (t - startUs), its canvas fitted to the instance's box. Every node, clip, and transition command works inside a definition as in a scene, by the IDs of its nodes, and a definition's ID is a parentId of add_node and a sceneId of add_scene_audio_clip and add_clip_transition; an edit inside a definition changes every instance of it. A definition with a template is an element: an instance gives values to its inputs (set_instance_input, clear_instance_input), and shows the definition instantiated with them, the inputs it gives no value taking their defaults; an element's inputs hold no assets, and its template is edited by replace_definition only. describe_document shows the definitions with their templates, and the values of each instance. Refused with unknown-node, unsupported-node when the node is not an instance, and instance-not-expandable unless the instance shows its definition exactly as its nodes placed directly would (from time 0 over the whole holder, filling the holder's canvas, untransformed, without effects, mask, matte, blend mode, or input values, the definition of the holder's canvas and duration with nodes and without clips, transitions, source hash, or template) and no other instance places the definition. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"instanceId\":\"node-group-instance\"}",
    "inputSchema": {
      "type": "object",
      "description": "Puts the nodes of an instance's definition in the instance's place and removes the definition; the inverse of ConvertToDefinition.",
      "properties": {
        "instanceId": {
          "type": "string",
          "description": "The stable ID of an instance node.",
          "minLength": 1
        }
      },
      "required": [
        "instanceId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_instance_input",
    "description": "Gives one input of an element instance a value, replacing the instance's value of that input; the instance shows its definition instantiated with its values at once. A definition is a composition built once, with its own canvas (width, height), durationUs, nodes, clips, and clip transitions, and no video or Custom HTML; an instance node places it as one layer: at scene time t it shows the definition at sourceStartUs + (t - startUs), its canvas fitted to the instance's box. Every node, clip, and transition command works inside a definition as in a scene, by the IDs of its nodes, and a definition's ID is a parentId of add_node and a sceneId of add_scene_audio_clip and add_clip_transition; an edit inside a definition changes every instance of it. A definition with a template is an element: an instance gives values to its inputs (set_instance_input, clear_instance_input), and shows the definition instantiated with them, the inputs it gives no value taking their defaults; an element's inputs hold no assets, and its template is edited by replace_definition only. describe_document shows the definitions with their templates, and the values of each instance. The value is given as the instance stores it: { inputId, type, value }, with the input's ID and type (text, number, boolean, color, or list) and a value within the input's constraints; a list value is an array of items, each an array of { key, type, value } in the order of the list's fields. Refused with unknown-node, unsupported-node when the node is not an instance, unknown-input when its definition has no such input, and invalid-result when the value does not fit the input or the definition instantiated with it is not one the document can hold. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"instanceId\":\"node-lower-third\",\"input\":{\"inputId\":\"title\",\"type\":\"text\",\"value\":\"Ada Lovelace\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Gives one input of an element instance a value, replacing the instance's value of that input.",
      "properties": {
        "instanceId": {
          "type": "string",
          "description": "The stable ID of an instance node.",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "description": "The value as the instance stores it: { inputId, type, value }, the inputId and type of an input of the instance's definition; a list value is an array of items, each an array of { key, type, value } in the order of the list's fields."
        }
      },
      "required": [
        "instanceId",
        "input"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "clear_instance_input",
    "description": "Removes an instance's value of one input, which then takes its default; nothing changes when the instance gives it no value. A definition is a composition built once, with its own canvas (width, height), durationUs, nodes, clips, and clip transitions, and no video or Custom HTML; an instance node places it as one layer: at scene time t it shows the definition at sourceStartUs + (t - startUs), its canvas fitted to the instance's box. Every node, clip, and transition command works inside a definition as in a scene, by the IDs of its nodes, and a definition's ID is a parentId of add_node and a sceneId of add_scene_audio_clip and add_clip_transition; an edit inside a definition changes every instance of it. A definition with a template is an element: an instance gives values to its inputs (set_instance_input, clear_instance_input), and shows the definition instantiated with them, the inputs it gives no value taking their defaults; an element's inputs hold no assets, and its template is edited by replace_definition only. describe_document shows the definitions with their templates, and the values of each instance. Refused with unknown-node, unsupported-node when the node is not an instance, unknown-input when its definition has no such input, and invalid-result when the definition instantiated with the defaults is not one the document can hold. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"instanceId\":\"node-lower-third\",\"inputId\":\"title\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes an instance's value of an input, which then takes its default.",
      "properties": {
        "instanceId": {
          "type": "string",
          "description": "The stable ID of an instance node.",
          "minLength": 1
        },
        "inputId": {
          "type": "string",
          "description": "The ID of an input of the instance's definition.",
          "minLength": 1
        }
      },
      "required": [
        "instanceId",
        "inputId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "replace_definition",
    "description": "Replaces one definition whole, keeping its ID and its place among the definitions: its sourceHash, canvas, duration, nodes, clips, transitions, and template, given exactly as the document stores them (see add_definition). It is how an element's template, its inputs, bindings, conditions, and repeats, is edited, and how a host brings an element up to a new version of its source. A definition is a composition built once, with its own canvas (width, height), durationUs, nodes, clips, and clip transitions, and no video or Custom HTML; an instance node places it as one layer: at scene time t it shows the definition at sourceStartUs + (t - startUs), its canvas fitted to the instance's box. Every node, clip, and transition command works inside a definition as in a scene, by the IDs of its nodes, and a definition's ID is a parentId of add_node and a sceneId of add_scene_audio_clip and add_clip_transition; an edit inside a definition changes every instance of it. A definition with a template is an element: an instance gives values to its inputs (set_instance_input, clear_instance_input), and shows the definition instantiated with them, the inputs it gives no value taking their defaults; an element's inputs hold no assets, and its template is edited by replace_definition only. describe_document shows the definitions with their templates, and the values of each instance. Refused with unknown-definition, invalid-result when definition.id is not definitionId or the definition is not one the document can hold, id-in-use with the IDs it would add that the document already uses, and instance-inputs-mismatch with the IDs of the instances whose values would no longer fit it: set or clear them first, in the same transaction. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"definitionId\":\"definition-badge\",\"definition\":{\"id\":\"definition-badge\",\"sourceHash\":\"\",\"width\":200,\"height\":200,\"durationUs\":1000000,\"nodes\":[{\"id\":\"node-badge-background\",\"type\":\"background\",\"startUs\":0,\"durationUs\":1000000,\"color\":\"#ffffff\",\"animations\":[]}],\"clips\":[],\"transitions\":[],\"template\":{\"inputs\":[],\"bindings\":[],\"conditions\":[],\"repeats\":[]}}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces a definition whole, with its nodes, clips, transitions, and template, keeping its ID and its place.",
      "properties": {
        "definitionId": {
          "type": "string",
          "description": "The stable ID of a definition of the document.",
          "minLength": 1
        },
        "definition": {
          "type": "object",
          "description": "The complete new definition as the document stores it, with the same ID: its sourceHash, width, height, durationUs, nodes, clips, transitions, and template; every ID it adds unused in the document."
        }
      },
      "required": [
        "definitionId",
        "definition"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_custom_html",
    "description": "Replaces the html, the fonts, and the parameters of a Custom HTML element at once. A Custom HTML element is a sandboxed page of width x height pixels with no network: inline HTML, CSS, and scripts only, fonts from font assets alone (font-family is the asset's ID), and no storage. Its clock is the time of its scene, from the node's startUs: CSS animations and transitions, the Web Animations API, requestAnimationFrame (called once per frame, with the time in milliseconds), Date.now, new Date(), and performance.now all read that time, every frame is rendered as if the page had run from time 0, and Math.random restarts from the same seed at every frame, so plain CSS @keyframes animate deterministically without any script. setTimeout and setInterval do not follow it: do not use them. Parameters are read in a script as kadrion.parameters.<key>, and a number or colour also in CSS as var(--<key>); a template binds a parameter to an input of its type. An element that listens to message events speaks the time protocol itself and must answer every kadrion:time message. check_custom_html renders the element at sampled times twice and reports what fails or differs. Refused with invalid-argument when html is longer than 262144 characters, unknown-node, unsupported-node when the node is not Custom HTML, binding-in-use when a template binds a parameter whose value changes, and invalid-result when a font is no font asset of the document or listed twice, or the parameters are not sorted by key. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-custom-html\",\"html\":\"<style>html,body{margin:0;height:100%}#dot{width:40px;height:40px;border-radius:50%;background:var(--accent);animation:move 2s linear infinite alternate}@keyframes move{to{transform:translateX(200px)}}</style><div id=\\\"dot\\\"></div>\",\"fontAssetIds\":[],\"parameters\":[{\"key\":\"accent\",\"type\":\"color\",\"value\":\"#f79009\"}]}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces the html, the fonts, and the parameters of a Custom HTML element at once.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a Custom HTML node.",
          "minLength": 1
        },
        "html": {
          "type": "string",
          "description": "The inline document of the element: HTML with its CSS and scripts inline, nothing loaded from anywhere.",
          "maxLength": 262144
        },
        "fontAssetIds": {
          "type": "array",
          "description": "The IDs of the font assets the element uses, each once; in its CSS the family of a font is its asset ID.",
          "items": {
            "type": "string",
            "description": "The ID of a font asset of the document."
          }
        },
        "parameters": {
          "type": "array",
          "description": "The parameters of the element, sorted by key, each {key, type, value} with type text, number, boolean, or color (lowercase #rrggbb); an empty list for none.",
          "items": {
            "type": "object",
            "description": "One parameter, as the document stores it."
          }
        }
      },
      "required": [
        "nodeId",
        "html",
        "fontAssetIds",
        "parameters"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_clip_transition_at_cut",
    "description": "Adds a transition between two clips of one layer that meet end to end — the outgoing clip ends exactly where the incoming one starts — and makes their overlap in the same step. The transition is complete, as add_clip_transition takes it: its ID, fromNodeId, toNodeId, durationUs, effect, and easing. alignment start lets the outgoing clip last durationUs longer, end lets the incoming clip start durationUs earlier, and center does half of each (the incoming clip starts half of durationUs earlier, rounded down). A video or audio then shows more of its source; no keyframe moves. It is one step: all or nothing, and one undo reverts it. Refused with invalid-argument, unknown-node, not-a-cut when the clips do not meet in one scene, no-room-at-cut when the incoming clip would start before its scene, source-range-exceeded and media-facts-missing when a video lacks source at the cut, and whatever add_clip_transition, trim_clip_start, or trim_clip_end refuse; the error of a refused step names the index of its call. Returns the edited document and the IDs it created.\n\nExample arguments: {\"transition\":{\"id\":\"transition-cut\",\"fromNodeId\":\"node-title\",\"toNodeId\":\"node-custom-html\",\"durationUs\":500000,\"effect\":{\"kind\":\"push\",\"direction\":\"left\"},\"easing\":{\"kind\":\"linear\"}},\"alignment\":\"center\"}",
    "inputSchema": {
      "type": "object",
      "description": "Adds a transition between two clips of one layer that meet end to end, and makes their overlap in the same step.",
      "properties": {
        "transition": {
          "type": "object",
          "description": "The complete clip transition, as add_clip_transition takes it: its ID, unused in the document; fromNodeId, the clip that ends at the cut; toNodeId, the clip that starts there, a sibling of it; durationUs; effect; and easing, {\"kind\":\"linear\"} for a constant speed or another easing as set_transition_easing describes.",
          "properties": {
            "fromNodeId": {
              "type": "string",
              "description": "The clip that ends at the cut.",
              "minLength": 1
            },
            "toNodeId": {
              "type": "string",
              "description": "The clip that starts at the cut, a sibling of the other.",
              "minLength": 1
            },
            "durationUs": {
              "type": "integer",
              "description": "How long the transition lasts, in integer microseconds, at least 1.",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "fromNodeId",
            "toNodeId",
            "durationUs"
          ]
        },
        "alignment": {
          "type": "string",
          "description": "Where the transition lies against the cut: start (it starts at the cut; the outgoing clip lasts durationUs longer), center (it is centred on the cut; the incoming clip starts half of it earlier, rounded down, and the outgoing one lasts the rest longer), or end (it ends at the cut; the incoming clip starts durationUs earlier).",
          "enum": [
            "start",
            "center",
            "end"
          ]
        }
      },
      "required": [
        "transition",
        "alignment"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "freeze_frame",
    "description": "Holds the frame a video node shows at atUs for holdUs, as a freeze frame: a video clip at speed \"x0\" that shows that one frame of its source, silent. mode overwrite puts the freeze frame in the place of the part of the clip from atUs to atUs + holdUs, cutting the clip at both times; nothing moves, and atUs + holdUs is at most the clip's end. mode insert cuts the clip at atUs, puts the freeze frame between the two halves, and moves the second half holdUs later, so the clip ends holdUs later; no other clip moves, and the second half may then overlap what follows it on its layer. newClipIds are two different IDs unused in the document: the first names the freeze frame, the second the part of the clip after it (not made when an overwrite reaches the clip's end). The freeze frame keeps the clip's position, size, fit, crop, effects, and animations, copied and renamed as split_clip copies them; set_clip_speed with a multiplier such as \"x1\" or \"x0.5\" plays it again. It is one step: all or nothing, and one undo reverts it. A video that is heard (volume above 0) is cut only at a multiple of 125 microseconds from its start. Times are integer microseconds of the time of the clip's scene (1 second is 1000000). Refused with invalid-argument, unknown-clip, unsupported-node for anything but a video node, time-outside-clip when atUs is not strictly inside the clip or an overwrite would reach past its end, split-not-exact, id-in-use, and whatever split_clip, move_clip, add_node, set_clip_reverse, set_clip_speed, and set_video_source refuse; the error of a refused step names the index of its call. Returns the edited document and the IDs it created.\n\nExample arguments: {\"clipId\":\"node-video\",\"atUs\":3000000,\"holdUs\":2000000,\"mode\":\"insert\",\"newClipIds\":[\"node-video-freeze\",\"node-video-after\"]}",
    "inputSchema": {
      "type": "object",
      "description": "Holds the frame a video node shows at atUs for holdUs, as a freeze frame, in one step (D82.9).",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a video node, a child of a group included.",
          "minLength": 1
        },
        "atUs": {
          "type": "integer",
          "description": "The time of the frame held, strictly between the start and the end of the clip, in integer microseconds of the time of the clip's scene; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "holdUs": {
          "type": "integer",
          "description": "How long the frame is held, in integer microseconds, at least 1.",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "string",
          "description": "overwrite: the freeze frame takes the place of the part of the clip from atUs to atUs + holdUs, which must end at the latest where the clip ends, and nothing moves; insert: the clip is cut at atUs, the freeze frame goes between the halves, and the second half moves holdUs later.",
          "enum": [
            "overwrite",
            "insert"
          ]
        },
        "newClipIds": {
          "type": "array",
          "description": "Two different IDs unused in the document: the first names the freeze frame, the second the part of the clip after it (not made when an overwrite reaches the clip's end). The animations and effects of each are renamed after it, as split_clip does.",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "clipId",
        "atUs",
        "holdUs",
        "mode",
        "newClipIds"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "check_custom_html",
    "description": "Checks one Custom HTML element of the current document and changes nothing. It reads its html for what the sandbox refuses or the managed clock does not drive — network requests and loaded resources (network), setTimeout and setInterval (timer), the document timeline and event time stamps (wall-clock), storage and cookies (storage), and navigation, links, and forms (navigation) — each with the offset and the text it matched; and where the host can render, it renders the element alone at sampled times of its lifetime twice, the second time in the reverse order, and reports a time it did not answer (no-acknowledgement), a document it navigated to (navigated), a frame that differs between the two renders (frames-differ, the mark of state kept from frame to frame or read from a clock it does not drive), and any other failure (render-failed). Returns the findings, and the render report or null when the host renders nothing. Call it after set_custom_html, and fix every finding before relying on the element. Refused with unknown-node when the document has no node of that ID, and with unsupported-node when the node is no Custom HTML.\n\nExample arguments: {\"nodeId\":\"node-custom-html\"}",
    "inputSchema": {
      "type": "object",
      "description": "The element to check.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a Custom HTML node.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "run_transaction",
    "description": "Applies several edit tools in order as one step: all of them or none, and one undo reverts them all. Each call names an edit tool of this catalogue (not describe_document or run_transaction) and passes that tool's arguments; a later call sees the document the earlier ones produced. When one call is refused, nothing changes, and the error names the index of that call. Returns the edited document and the IDs the calls created.\n\nExample arguments: {\"calls\":[{\"name\":\"set_node_position\",\"arguments\":{\"nodeId\":\"node-title\",\"position\":{\"x\":120,\"y\":240}}},{\"name\":\"set_node_opacity\",\"arguments\":{\"nodeId\":\"node-title\",\"opacity\":0.5}}]}",
    "inputSchema": {
      "type": "object",
      "description": "The edit tool calls to apply as one step.",
      "properties": {
        "calls": {
          "type": "array",
          "description": "The calls, in the order they are applied; at least one.",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "One call of an edit tool.",
            "properties": {
              "name": {
                "type": "string",
                "description": "The name of an edit tool of this catalogue.",
                "enum": [
                  "set_node_position",
                  "set_node_opacity",
                  "set_text_content",
                  "add_node",
                  "remove_node",
                  "duplicate_node",
                  "reorder_node",
                  "set_node_scale",
                  "set_node_size",
                  "set_node_color",
                  "set_text_font_size",
                  "set_text_font",
                  "set_image_asset",
                  "add_asset",
                  "remove_asset",
                  "add_animation",
                  "remove_animation",
                  "set_opacity_keyframe",
                  "set_position_keyframe",
                  "set_scale_keyframe",
                  "add_keyframe",
                  "remove_keyframe",
                  "move_keyframe",
                  "set_keyframe_easing",
                  "set_keyframe_value",
                  "set_node_lifetime",
                  "set_node_fit",
                  "set_node_focus",
                  "set_node_rotation",
                  "set_node_origin",
                  "set_node_crop",
                  "set_node_corner_radius",
                  "set_video_asset",
                  "set_video_source",
                  "set_video_volume",
                  "add_audio_clip",
                  "remove_audio_clip",
                  "set_clip_volume",
                  "set_clip_fades",
                  "set_clip_source",
                  "add_scene",
                  "remove_scene",
                  "duplicate_scene",
                  "reorder_scene",
                  "set_scene_duration",
                  "move_node_to_scene",
                  "add_scene_audio_clip",
                  "move_clip",
                  "trim_clip_start",
                  "trim_clip_end",
                  "split_clip",
                  "join_clips",
                  "set_clip_speed",
                  "set_clip_reverse",
                  "add_scene_transition",
                  "add_clip_transition",
                  "remove_transition",
                  "set_transition_duration",
                  "set_transition_effect",
                  "set_transition_easing",
                  "set_caption_words",
                  "set_caption_word",
                  "set_caption_style",
                  "set_text_style",
                  "set_shape_geometry",
                  "set_shape_fill",
                  "set_shape_stroke",
                  "set_shape_trim",
                  "set_blend_mode",
                  "set_node_mask",
                  "set_node_matte",
                  "add_text_animation",
                  "remove_text_animation",
                  "set_text_animation",
                  "set_caption_highlight",
                  "set_caption_page_animation",
                  "add_effect",
                  "remove_effect",
                  "reorder_effect",
                  "set_effect",
                  "set_safe_area",
                  "add_template_input",
                  "remove_template_input",
                  "set_template_input",
                  "add_template_binding",
                  "remove_template_binding",
                  "add_template_condition",
                  "remove_template_condition",
                  "add_template_repeat",
                  "remove_template_repeat",
                  "add_definition",
                  "remove_definition",
                  "convert_to_definition",
                  "expand_instance",
                  "set_instance_input",
                  "clear_instance_input",
                  "replace_definition",
                  "set_custom_html"
                ]
              },
              "arguments": {
                "type": "object",
                "description": "The arguments of that tool, exactly as its own input schema states."
              }
            },
            "required": [
              "name",
              "arguments"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "calls"
      ],
      "additionalProperties": false
    }
  }
]
