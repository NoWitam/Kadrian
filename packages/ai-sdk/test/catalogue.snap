[
  {
    "name": "describe_document",
    "description": "Describes the current document and changes nothing. Returns the canvas size in composition pixels, fps, and durationUs; every scene in the order they play, with its ID, its startUs in the composition (derived: the sum of the durations before it), its durationUs, its audio clips in scene time, and its nodes from the bottom layer to the top, each with its ID, type, parentId, layer (0 is the bottom), startUs and durationUs in integer microseconds of the time of its scene, its stored fields (position, scale, opacity, animations with their keyframes, text, colour, and so on; the html of a Custom HTML element is left out), and a group's children; and the declared assets and the composition's clips, in composition time, where a video or audio asset also states its sourceDurationUs, the length of its source in integer microseconds, when the host knows it, and a video its soundDurationUs, the length of its sound, or null when it has none. Call it before editing to learn the IDs that other tools take.\n\nExample arguments: {}",
    "inputSchema": {
      "type": "object",
      "description": "No arguments.",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_position",
    "description": "Moves one node to an absolute base position: x from the left edge, y from the top edge, of the canvas, or of its group for a node inside a group. Lengths and coordinates are composition pixels, rounded to integers. A position animation of the node adds its offsets on top of this base. Refused with unknown-node when no node has the ID, unsupported-node for a node without a position (the background), and invalid-result when the document cannot hold the position. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"position\":{\"x\":120,\"y\":240}}",
    "inputSchema": {
      "type": "object",
      "description": "Moves one node to an absolute base position.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node to move. A node without a position, such as the background, is refused.",
          "minLength": 1
        },
        "position": {
          "type": "object",
          "description": "The node's new base position, absolute, in composition pixels. A position animation adds its offsets on top of it.",
          "properties": {
            "x": {
              "type": "number",
              "description": "Distance from the left edge, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity (2.5 becomes 3, -2.5 becomes -2), and -0 becomes 0."
            },
            "y": {
              "type": "number",
              "description": "Distance from the top edge, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity (2.5 becomes 3, -2.5 becomes -2), and -0 becomes 0."
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "position"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_opacity",
    "description": "Sets one node's base opacity, from 0 (transparent) to 1 (opaque) inclusive. An opacity animation of the node multiplies it. Refused with invalid-argument outside 0 to 1, unknown-node when no node has the ID, and unsupported-node for a node without an opacity (the background). The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"opacity\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets one node's base opacity.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. A node without an opacity, such as the background, is refused.",
          "minLength": 1
        },
        "opacity": {
          "type": "number",
          "description": "The base opacity, from 0 (transparent) to 1 (opaque) inclusive; a fraction is kept as it is, and -0 becomes 0. An opacity animation multiplies it.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "nodeId",
        "opacity"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_content",
    "description": "Replaces the text of one text node, exactly as given: nothing is trimmed, and line breaks (\\n) are kept. Refused with unknown-node when no node has the ID and unsupported-node for a node that is not a text. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"text\":\"Hello\"}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces the text of one text node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a text node. Any other node is refused.",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "description": "The new text, exactly as given: nothing is trimmed or normalised, and line breaks are kept."
        }
      },
      "required": [
        "nodeId",
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_node",
    "description": "Inserts one complete node into a scene, or into a group, at a layer index: 0 is the bottom layer and the length of the list the top. The node is given exactly as the document stores it, with every field of its type (describe_document shows the stored fields of existing nodes): an ID unused in the document, its type (text, image, video, captions, group, or custom-html), startUs and durationUs, position, scale, rotation, origin, opacity, animations, and its own fields. A group takes text, image, and video nodes only. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. A video must sample inside its source. Refused with unknown-parent, unsupported-node when the parent takes no children, index-out-of-range, id-in-use with the IDs already taken, and invalid-result when the node is not one the document can hold; a video also with media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"parentId\":\"scene-main\",\"index\":4,\"node\":{\"id\":\"node-subtitle\",\"type\":\"text\",\"startUs\":1000000,\"durationUs\":4000000,\"position\":{\"x\":90,\"y\":400},\"scale\":{\"x\":1,\"y\":1},\"rotation\":0,\"origin\":{\"x\":0,\"y\":0},\"opacity\":1,\"animations\":[],\"text\":\"Made with Kadrion\",\"fontAssetId\":\"asset-font\",\"fontSize\":64,\"color\":\"#ffffff\",\"style\":{\"stroke\":{\"kind\":\"none\"},\"shadow\":{\"kind\":\"none\"},\"box\":{\"kind\":\"none\"}},\"textAnimations\":[]}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete node, with its animations and children, into a list.",
      "properties": {
        "parentId": {
          "type": "string",
          "description": "The ID of the scene, or of a group, whose list receives the node. A group takes image and text nodes only.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The node's index in that list after the insertion, from 0 (the bottom layer) to the list's length (the top).",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "node": {
          "type": "object",
          "description": "The complete node as the document stores it, with every ID of its subtree chosen by the caller and unused in the document, and its animations in its own `animations` array."
        }
      },
      "required": [
        "parentId",
        "index",
        "node"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_node",
    "description": "Removes one node together with its animations and, for a group, its children. Refused with unknown-node when no node has the ID and invalid-result when the document would no longer be valid without it. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-custom-html\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a node with its animations and, for a group, its children.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "duplicate_node",
    "description": "Copies one node, with its animations and children, into the same list directly above the original. The copy takes newNodeId; a child at index i of the copy becomes <newNodeId>-c<i>, an animation <newNodeId>-a-<property>, a text animation at index t <newNodeId>-t<t>. Refused with unknown-node, id-in-use when an ID of the copy is taken, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"newNodeId\":\"node-title-copy\"}",
    "inputSchema": {
      "type": "object",
      "description": "Copies a node, with its animations and children, directly above it.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node.",
          "minLength": 1
        },
        "newNodeId": {
          "type": "string",
          "description": "The ID of the copy, unused in the document. Every other ID of the copy derives from it: a child at index i becomes `<newNodeId>-c<i>`, an animation `<newNodeId>-a-<property>`, a text animation at index t `<newNodeId>-t<t>`, and an animation of that child `<newNodeId>-c<i>-a-<property>` (a text animation `<newNodeId>-c<i>-t<t>`).",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "nodeId",
        "newNodeId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "reorder_node",
    "description": "Moves one node to another index of its own list, which changes the layer order: 0 is the bottom layer and the length of the list minus 1 the top. It never moves a node into or out of a group. Refused with unknown-node and index-out-of-range. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"index\":1}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a node within its own list, which changes the layer order.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The node's index in its own list after the move, from 0 (the bottom layer) to the list's length minus 1 (the top).",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_scale",
    "description": "Sets one node's base scale about its origin point (the top-left corner unless set_node_origin moved it): 1 is the natural size, from 0 to 1000 on each axis. A scale animation of the node multiplies it. Refused with invalid-argument outside 0 to 1000, unknown-node, and unsupported-node for a node without a scale (the background). The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"scale\":{\"x\":1.5,\"y\":1.5}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets one node's base scale.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. A node without a scale, such as the background, is refused.",
          "minLength": 1
        },
        "scale": {
          "type": "object",
          "description": "The node's new base scale about its own origin. A scale animation multiplies it.",
          "properties": {
            "x": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive, kept as it is; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            },
            "y": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive, kept as it is; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "scale"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_size",
    "description": "Sets the width and height of an image, a video, or a Custom HTML element, from 1 to 1000000 each. Lengths and coordinates are composition pixels, rounded to integers. A text has no size; change its font size instead. Refused with invalid-argument for a size outside the range after rounding, unknown-node, and unsupported-node for any other node. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"width\":480,\"height\":270}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the size of an image, a video, or a Custom HTML element.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images, videos, and Custom HTML elements have a size.",
          "minLength": 1
        },
        "width": {
          "type": "number",
          "description": "The width, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity, and -0 becomes 0; the document takes 1 to 1 000 000, and a rounded value outside that range is refused."
        },
        "height": {
          "type": "number",
          "description": "The height, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity, and -0 becomes 0; the document takes 1 to 1 000 000, and a rounded value outside that range is refused."
        }
      },
      "required": [
        "nodeId",
        "width",
        "height"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_color",
    "description": "Sets the colour of a text or a background, as # and six hexadecimal digits (sRGB), stored in lower case. A color animation of the node replaces it while the animation is sampled. Refused with invalid-argument for short forms, names, or alpha, unknown-node, and unsupported-node for a node without a colour. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"color\":\"#ffcc00\"}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the colour of a text or a background.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only texts and backgrounds have a colour.",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "description": "An sRGB colour as `#` and six hexadecimal digits, in either case; it is stored in lower case. Short forms, names, and alpha are refused.",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "nodeId",
        "color"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_font_size",
    "description": "Sets the font size of a text, from 1 to 1000000. Lengths and coordinates are composition pixels, rounded to integers. Refused with invalid-argument outside the range after rounding, unknown-node, and unsupported-node for a node that is not a text. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"fontSize\":96}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the font size of a text.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only texts have a font size.",
          "minLength": 1
        },
        "fontSize": {
          "type": "number",
          "description": "The font size, in composition pixels. A fraction is rounded to an integer, halves towards +Infinity, and -0 becomes 0; the document takes 1 to 1 000 000, and a rounded value outside that range is refused."
        }
      },
      "required": [
        "nodeId",
        "fontSize"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_font",
    "description": "Points a text or captions node at another font asset that the document declares (add one with add_asset first). Refused with unknown-node, unsupported-node for a node that is neither a text nor captions, unknown-asset, and asset-type-mismatch when the asset is not a font. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"fontAssetId\":\"asset-font-bold\"}",
    "inputSchema": {
      "type": "object",
      "description": "Points a text or captions at another font asset of the document.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only texts and captions have a font.",
          "minLength": 1
        },
        "fontAssetId": {
          "type": "string",
          "description": "The ID of a font asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId",
        "fontAssetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_image_asset",
    "description": "Points an image node at another image asset that the document declares; the node keeps its size. Refused with unknown-node, unsupported-node for a node that is not an image, unknown-asset, and asset-type-mismatch when the asset is not an image. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"assetId\":\"asset-photo\"}",
    "inputSchema": {
      "type": "object",
      "description": "Points an image at another image asset of the document; its size stays.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images have an image asset.",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "description": "The ID of an image asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId",
        "assetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_asset",
    "description": "Declares an image, audio, font, or video asset at an index of the document's assets, under an unused ID and the SHA-256 of its exact bytes. Declare only assets whose bytes the host has: the host must supply them whenever the document is loaded, even while nothing uses the asset. Refused with id-in-use and index-out-of-range. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"asset\":{\"id\":\"asset-photo\",\"type\":\"image\",\"contentHash\":\"sha256:2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae\"},\"index\":3}",
    "inputSchema": {
      "type": "object",
      "description": "Declares an asset, pinned by the hash of its exact bytes. The host must then supply those bytes whenever the document is loaded, even while nothing uses the asset.",
      "properties": {
        "asset": {
          "type": "object",
          "description": "The asset as the document stores it.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The ID of the asset, unused in the document.",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "type": {
              "type": "string",
              "description": "The kind of the asset.",
              "enum": [
                "image",
                "audio",
                "font",
                "video"
              ]
            },
            "contentHash": {
              "type": "string",
              "description": "The algorithm, a colon, and the lower-case hex digest of the exact bytes.",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "type",
            "contentHash"
          ],
          "additionalProperties": false
        },
        "index": {
          "type": "integer",
          "description": "The asset's index in the document's assets after the insertion, from 0 to their number.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "asset",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_asset",
    "description": "Removes an asset that nothing uses. Refused with unknown-asset, and with asset-in-use, whose details list the IDs of its users: point them at another asset or remove them first. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"assetId\":\"asset-photo\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes an asset that nothing uses; an asset in use is refused with its users.",
      "properties": {
        "assetId": {
          "type": "string",
          "description": "The ID of an asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "assetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_animation",
    "description": "Adds one complete animation to a node, at an index of its animations: an ID unused in the document; the property, which the node must not animate yet (position, scale, opacity, rotation, or origin on every node but a background; size, crop, and cornerRadius on an image or a video; color on a text, captions, or a background, which has no other animation); and at least two keyframes in ascending time, each {timeUs, value, easing}, where the easing says how the value moves from this keyframe to the next one ({\"kind\":\"linear\"} for a constant speed; the easing of the last keyframe is never read). A position value is an offset {x, y} in pixels added to the base position, a scale value factors {x, y} multiplied with the base scale, an opacity value a factor from 0 to 1. The value depends on the property of the animation: rotation, a number of degrees added to the node's rotation; origin, {\"x\":…,\"y\":…} integers in per mille (-1000 to 1000) added to the node's origin; size, {\"width\":…,\"height\":…} in composition pixels (rounded) that replaces the node's size; color, \"#rrggbb\" that replaces the node's colour; crop, {\"top\":…,\"right\":…,\"bottom\":…,\"left\":…} integers in per mille that replaces the node's crop; cornerRadius, composition pixels (rounded) that replace the node's corner radius. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with unknown-node, duplicate-animation-target, index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-custom-html\",\"index\":0,\"animation\":{\"id\":\"anim-html-opacity\",\"property\":\"opacity\",\"keyframes\":[{\"timeUs\":0,\"value\":0,\"easing\":{\"kind\":\"ease-out\"}},{\"timeUs\":1000000,\"value\":1,\"easing\":{\"kind\":\"linear\"}}]}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete animation into a node's animations.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. The background has no animations.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The animation's index in the node's animations after the insertion.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "animation": {
          "type": "object",
          "description": "The complete animation as the document stores it: its ID, unused in the document; its property, which the node must not animate already; and its keyframes, each with its time, its value, and its easing."
        }
      },
      "required": [
        "nodeId",
        "index",
        "animation"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_animation",
    "description": "Removes one animation with all its keyframes; the node keeps its base values. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes one animation with all its keyframes.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        }
      },
      "required": [
        "animationId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_opacity_keyframe",
    "description": "Sets the opacity factor (0 to 1) of an opacity animation at a time: replaces the value of the keyframe at that time, or inserts one. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation and animation-property-mismatch when the animation does not animate opacity. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"timeUs\":5000000,\"opacity\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the keyframe at a time of an opacity animation, inserting it when none is there.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document. It must animate opacity.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "opacity": {
          "type": "number",
          "description": "The opacity factor, from 0 to 1 inclusive, kept as it is; -0 becomes 0.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "opacity"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_position_keyframe",
    "description": "Sets the offset {x, y} of a position animation at a time, added to the node's base position: replaces the value of the keyframe at that time, or inserts one. Lengths and coordinates are composition pixels, rounded to integers. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation and animation-property-mismatch when the animation does not animate position. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-group-position\",\"timeUs\":5000000,\"offset\":{\"x\":40,\"y\":200}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the keyframe at a time of a position animation, inserting it when none is there.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document. It must animate position.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "object",
          "description": "The offset added to the node's base position, in composition pixels; each coordinate is rounded to an integer, halves towards +Infinity, and -0 becomes 0.",
          "properties": {
            "x": {
              "type": "number",
              "description": "The horizontal offset."
            },
            "y": {
              "type": "number",
              "description": "The vertical offset."
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "offset"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_scale_keyframe",
    "description": "Sets the factors {x, y} of a scale animation at a time, from 0 to 1000, multiplied with the node's base scale: replaces the value of the keyframe at that time, or inserts one. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation and animation-property-mismatch when the animation does not animate scale. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-image-scale\",\"timeUs\":5000000,\"factor\":{\"x\":1.1,\"y\":1.1}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the keyframe at a time of a scale animation, inserting it when none is there.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document. It must animate scale.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "factor": {
          "type": "object",
          "description": "The factors multiplied with the node's base scale.",
          "properties": {
            "x": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            },
            "y": {
              "type": "number",
              "description": "A factor from 0 to 1000 inclusive; -0 becomes 0.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "factor"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_keyframe",
    "description": "Inserts one keyframe given exactly as the document stores it, {timeUs, value, easing}, into an animation, at the place its time gives it; the value must fit the animated property. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, keyframe-exists when the time is taken, and invalid-result for a value of the wrong form. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"keyframe\":{\"timeUs\":9000000,\"value\":0.5,\"easing\":{\"kind\":\"linear\"}}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a keyframe given as exact data at the place its time gives it; its value is judged by the document.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        },
        "keyframe": {
          "type": "object",
          "description": "The keyframe as the document stores it: its time, which must be free, its value, and its easing.",
          "properties": {
            "timeUs": {
              "type": "integer",
              "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "timeUs"
          ]
        }
      },
      "required": [
        "animationId",
        "keyframe"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_keyframe",
    "description": "Removes the keyframe at a time from an animation. An animation keeps at least two keyframes; remove the whole animation instead. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, unknown-keyframe, and too-few-keyframes. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"timeUs\":5000000}",
    "inputSchema": {
      "type": "object",
      "description": "Removes the keyframe at a time; refused when the animation would keep fewer keyframes than the document allows.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "animationId",
        "timeUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_keyframe",
    "description": "Moves the keyframe at timeUs of an animation to toTimeUs, keeping its value and its easing. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, unknown-keyframe, and keyframe-exists when toTimeUs is taken. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-title-opacity\",\"timeUs\":7500000,\"toTimeUs\":6000000}",
    "inputSchema": {
      "type": "object",
      "description": "Gives the keyframe at a time another time, which must be free.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toTimeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "toTimeUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_keyframe_easing",
    "description": "Sets how the value of an animation moves from the keyframe at a time to the next keyframe; the value stays the same at every keyframe. An easing is an object with its kind: {\"kind\":\"linear\"} (a constant speed), {\"kind\":\"hold\"} (the value stays until the next keyframe, then jumps), {\"kind\":\"ease-in\"} (starts slowly), {\"kind\":\"ease-out\"} (slows down at the end), {\"kind\":\"ease-in-out\"} (both), {\"kind\":\"cubic-bezier\",\"x1\":0.34,\"y1\":1.56,\"x2\":0.64,\"y2\":1} (the curve of CSS cubic-bezier(); x1 and x2 from 0 to 1, y1 and y2 from -1 to 2, where a y outside 0 to 1 overshoots and the value is held within the range of its property), or {\"kind\":\"steps\",\"count\":4,\"position\":\"end\"} (count equal jumps, 1 to 1000, at the end or the start of each interval, as CSS steps()). A keyframe that set_opacity_keyframe, set_position_keyframe, or set_scale_keyframe inserts takes the easing of the keyframe before it, or linear; call this afterwards, in the same transaction, to change it. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, unknown-keyframe, and invalid-result for an easing the document cannot hold. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-group-position\",\"timeUs\":0,\"easing\":{\"kind\":\"cubic-bezier\",\"x1\":0.34,\"y1\":1.56,\"x2\":0.64,\"y2\":1}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces how the value moves from the keyframe at a time to the next one; the easing of the last keyframe is kept but never read.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "easing": {
          "type": "object",
          "description": "The complete new easing. An easing is an object with its kind: {\"kind\":\"linear\"} (a constant speed), {\"kind\":\"hold\"} (the value stays until the next keyframe, then jumps), {\"kind\":\"ease-in\"} (starts slowly), {\"kind\":\"ease-out\"} (slows down at the end), {\"kind\":\"ease-in-out\"} (both), {\"kind\":\"cubic-bezier\",\"x1\":0.34,\"y1\":1.56,\"x2\":0.64,\"y2\":1} (the curve of CSS cubic-bezier(); x1 and x2 from 0 to 1, y1 and y2 from -1 to 2, where a y outside 0 to 1 overshoots and the value is held within the range of its property), or {\"kind\":\"steps\",\"count\":4,\"position\":\"end\"} (count equal jumps, 1 to 1000, at the end or the start of each interval, as CSS steps())."
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "easing"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_keyframe_value",
    "description": "Sets the value of an animation of rotation, origin, size, color, crop, or cornerRadius at a time: replaces the value of the keyframe at that time, or inserts one, eased as the keyframe before it. The value depends on the property of the animation: rotation, a number of degrees added to the node's rotation; origin, {\"x\":…,\"y\":…} integers in per mille (-1000 to 1000) added to the node's origin; size, {\"width\":…,\"height\":…} in composition pixels (rounded) that replaces the node's size; color, \"#rrggbb\" that replaces the node's colour; crop, {\"top\":…,\"right\":…,\"bottom\":…,\"left\":…} integers in per mille that replaces the node's crop; cornerRadius, composition pixels (rounded) that replace the node's corner radius. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Use describe_document to read the IDs of animations and the times of their keyframes. Refused with unknown-animation, use-typed-command for an animation of opacity, position, or scale (use set_opacity_keyframe, set_position_keyframe, or set_scale_keyframe), invalid-argument for a value of the wrong form, and invalid-result for a value outside the range of the property. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animationId\":\"anim-image-rotation\",\"timeUs\":1000000,\"value\":360}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the keyframe at a time of an animation of rotation, origin, size, color, crop, or cornerRadius, inserting it when none is there.",
      "properties": {
        "animationId": {
          "type": "string",
          "description": "The ID of an animation of the document. Opacity, position, and scale have their own keyframe commands.",
          "minLength": 1
        },
        "timeUs": {
          "type": "integer",
          "description": "A scene time in integer microseconds from the start of the scene of the node; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "value": {
          "description": "The keyframe value. The value depends on the property of the animation: rotation, a number of degrees added to the node's rotation; origin, {\"x\":…,\"y\":…} integers in per mille (-1000 to 1000) added to the node's origin; size, {\"width\":…,\"height\":…} in composition pixels (rounded) that replaces the node's size; color, \"#rrggbb\" that replaces the node's colour; crop, {\"top\":…,\"right\":…,\"bottom\":…,\"left\":…} integers in per mille that replaces the node's crop; cornerRadius, composition pixels (rounded) that replace the node's corner radius.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "animationId",
        "timeUs",
        "value"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_lifetime",
    "description": "Sets when a node is shown: from startUs, for durationUs (at least 1). Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. The part after the end of the composition is cut. It moves no keyframe: keyframe times stay composition times. A video keeps its sourceStartUs, so its lifetime must fit inside its source. Refused with unknown-node, invalid-result, and for a video media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"startUs\":1000000,\"durationUs\":5000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets when a node is shown: from startUs, for durationUs, in the time of its scene. It moves no keyframe of the node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Every node has a lifetime, the background included.",
          "minLength": 1
        },
        "startUs": {
          "type": "integer",
          "description": "The scene time from which the node is active, in integer microseconds from the start of its scene; it may lie at or after the end of the scene, and it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationUs": {
          "type": "integer",
          "description": "How long the node is active, in integer microseconds, at least 1; whatever lies past the end of its scene is cut, and it is never rounded.",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "startUs",
        "durationUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_fit",
    "description": "Sets how the picture of an image or a video meets the box of its node: fill stretches it to the box, contain shows all of it inside the box, cover fills the box and crops; contain and cover keep the aspect ratio and place the picture by its focus (set_node_focus), the centre by default. Refused with invalid-argument for another fit, unknown-node, and unsupported-node for a node that is neither an image nor a video. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"fit\":\"cover\"}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how the picture of an image or a video meets the box of its node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images and videos have a fit.",
          "minLength": 1
        },
        "fit": {
          "type": "string",
          "description": "fill stretches the picture to the box; contain shows all of it inside the box; cover fills the box and crops. contain and cover keep the aspect ratio and place the picture by its focus, the centre unless set_node_focus moved it.",
          "enum": [
            "fill",
            "contain",
            "cover"
          ]
        }
      },
      "required": [
        "nodeId",
        "fit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_focus",
    "description": "Sets the focus point of an image or a video: the point of its picture that its fit keeps in place, as integers in per mille of the picture, x of its width from the left edge and y of its height from the top edge; 500, 500 is the centre. The point lies at the same fraction of the box, so under cover it chooses which part is cropped away and always stays in frame, under contain it moves the picture towards that side of its bars, and under fill, where the picture is the box, it changes nothing. It is not animated. Refused with invalid-argument for a coordinate that is not an integer from 0 to 1000, unknown-node, and unsupported-node for a node that is neither an image nor a video. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"focus\":{\"x\":500,\"y\":250}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets which point of the picture of an image or a video stays in its box.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images and videos have a focus.",
          "minLength": 1
        },
        "focus": {
          "type": "object",
          "description": "The focus point, in per mille of the picture: the point at x per mille of its width and y per mille of its height lies at the same fraction of the box. 500, 500 is the centre.",
          "properties": {
            "x": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the width of the picture, from its left edge.",
              "minimum": 0,
              "maximum": 1000
            },
            "y": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the height of the picture, from its top edge.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "focus"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_rotation",
    "description": "Sets a node's base rotation about its origin point, in degrees, positive clockwise, from -360000 to 360000: several turns are allowed for a spin, and a whole number of turns is no rotation. It is applied after the scale and before the position, and a rotation animation of the node adds to it. Refused with invalid-argument outside the range, unknown-node, and unsupported-node for a background. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"rotation\":15}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the rotation of a node about its origin point, in degrees.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Every node but a background has a rotation.",
          "minLength": 1
        },
        "rotation": {
          "type": "number",
          "description": "Degrees, positive clockwise, from -360000 to 360000; several turns are allowed, and a whole number of turns is no rotation. Never rounded; -0 becomes 0.",
          "minimum": -360000,
          "maximum": 360000
        }
      },
      "required": [
        "nodeId",
        "rotation"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_origin",
    "description": "Sets the point of a node's box that its scale and rotation are about, as integers in per mille of the box: 0, 0 is the top-left corner and 500, 500 the centre; a group's box is the canvas, a text's box the box of its lines. The position still places the top-left corner, so the node does not move while it is neither rotated nor scaled; to keep a rotated or scaled node in place, set its position in the same transaction. An origin animation of the node adds to it. Refused with invalid-argument for a coordinate that is not an integer from 0 to 1000, unknown-node, and unsupported-node for a background. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"origin\":{\"x\":500,\"y\":500}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the point of a node's box that its scale and rotation are about; the position stays that of the top-left corner.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Every node but a background has an origin; a group's box is the canvas.",
          "minLength": 1
        },
        "origin": {
          "type": "object",
          "description": "The origin, in per mille of the box: 0, 0 is the top-left corner and 500, 500 the centre.",
          "properties": {
            "x": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the width of the box, from its left edge.",
              "minimum": 0,
              "maximum": 1000
            },
            "y": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the height of the box, from its top edge.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "origin"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_crop",
    "description": "Sets what is cut away of the picture of an image or a video before it is fitted to its box, as integer insets in per mille of the sides of the picture from its top, right, bottom, and left edge; the rest is then fitted and focused as if it were the whole picture. Two opposite insets add up to at most 999. A crop animation of the node replaces it. Refused with invalid-argument for an inset that is not an integer from 0 to 1000, unknown-node, unsupported-node for a node that is neither an image nor a video, and invalid-result when two opposite insets leave nothing. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"crop\":{\"top\":100,\"right\":0,\"bottom\":100,\"left\":0}}",
    "inputSchema": {
      "type": "object",
      "description": "Sets what is cut away of the picture of an image or a video before it is fitted to its box.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images and videos have a crop.",
          "minLength": 1
        },
        "crop": {
          "type": "object",
          "description": "Insets from each edge of the picture, in per mille of its sides; two opposite insets add up to at most 999.",
          "properties": {
            "top": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the height, from the top edge.",
              "minimum": 0,
              "maximum": 1000
            },
            "right": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the width, from the right edge.",
              "minimum": 0,
              "maximum": 1000
            },
            "bottom": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the height, from the bottom edge.",
              "minimum": 0,
              "maximum": 1000
            },
            "left": {
              "type": "integer",
              "description": "An integer from 0 to 1000, per mille of the width, from the left edge.",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeId",
        "crop"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_node_corner_radius",
    "description": "Sets the radius of the four corners of an image or a video, in composition pixels; 0 is square, and a radius above half a side is reduced as CSS does. Lengths and coordinates are composition pixels, rounded to integers. A cornerRadius animation of the node replaces it. Refused with invalid-argument, unknown-node, unsupported-node for a node that is neither an image nor a video, and invalid-result outside 0 to 1000000 after rounding. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-image\",\"cornerRadius\":24}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the radius of the corners of an image or a video.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only images and videos have a corner radius.",
          "minLength": 1
        },
        "cornerRadius": {
          "type": "number",
          "description": "Composition pixels, rounded to an integer, halves towards +Infinity; 0 is square, and a radius above half a side is reduced as CSS does."
        }
      },
      "required": [
        "nodeId",
        "cornerRadius"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_video_asset",
    "description": "Points a video node at another video asset that the document declares (add one with add_asset first); its source start, size, and fit stay. The part of the source the node samples must lie inside the new video: describe_document reports a video's sourceDurationUs when the host knows it. Refused with unknown-node, unsupported-node for a node that is not a video, unknown-asset, asset-type-mismatch when the asset is not a video, media-facts-missing when the host does not know the video's duration, and source-range-exceeded when the node would sample past its end. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-video\",\"assetId\":\"asset-clip\"}",
    "inputSchema": {
      "type": "object",
      "description": "Points a video at another video asset of the document; its source start, size, and fit stay.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only videos have a video asset.",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "description": "The ID of a video asset the document declares.",
          "minLength": 1
        }
      },
      "required": [
        "nodeId",
        "assetId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_video_source",
    "description": "Sets the source time a video node shows at the start of its lifetime; it then plays at speed 1. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Source times count from the video's first frame. The node samples sourceStartUs up to sourceStartUs plus the part of its lifetime inside its scene, which must lie inside the video: describe_document reports its sourceDurationUs when the host knows it. To trim the start of a clip by d, add d to startUs and sourceStartUs and subtract it from durationUs in one transaction. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not a video, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-video\",\"sourceStartUs\":2000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the source time a video shows at the start of its lifetime; speed is 1.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only videos have a source.",
          "minLength": 1
        },
        "sourceStartUs": {
          "type": "integer",
          "description": "The source time shown at the start of the lifetime, in integer microseconds from the first frame of the video; it is never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "sourceStartUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_video_volume",
    "description": "Sets how loud the sound of a video node is heard: a linear factor of the amplitude from 0 (silent) to 1 (the source as it is); it never amplifies. A video above 0 is heard from the source time it shows, and its asset must then have exactly one audio stream that starts with its picture, long enough for what is heard: describe_document reports a video's soundDurationUs when the host knows it, null when it has no sound. Refused with invalid-argument outside 0 to 1, unknown-node, unsupported-node for a node that is not a video, media-facts-missing when the host does not know the video's sound, and source-range-exceeded when the node would hear past its end or the video has no sound. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-video\",\"volume\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how loud the sound of a video is heard; 0 is silent.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of the node. Only videos have a volume.",
          "minLength": 1
        },
        "volume": {
          "type": "number",
          "description": "The linear factor of the amplitude, from 0 (silent) to 1 (the source as it is) inclusive; it never amplifies. A fraction is kept as it is, and -0 becomes 0.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "nodeId",
        "volume"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_audio_clip",
    "description": "Adds one complete audio clip at an index of the document's clips; every clip is heard, mixed by adding, whatever the order. The clip is given exactly as the document stores it: an ID unused in the document, type \"audio\", the ID of an audio asset the document declares (add one with add_asset first), startUs and durationUs (at least 1) in composition time, sourceStartUs (the source time heard at startUs; speed is 1), volume from 0 to 1, and fadeInUs and fadeOutUs, linear, which together take at most durationUs. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. The part after the end of the composition is cut; the source must be long enough for the part that is heard: describe_document reports an audio asset's sourceDurationUs when the host knows it. Refused with index-out-of-range, id-in-use, invalid-result, media-facts-missing when the host does not know the asset's duration, and source-range-exceeded when the clip would hear past its end. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":1,\"clip\":{\"id\":\"clip-voice\",\"type\":\"audio\",\"assetId\":\"asset-audio\",\"startUs\":2000000,\"durationUs\":3000000,\"sourceStartUs\":500000,\"volume\":0.8,\"fadeInUs\":250000,\"fadeOutUs\":1000000}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete audio clip into the document's clips.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The clip's index in the document's clips after the insertion, from 0 to their number. Clips are mixed whatever their order.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clip": {
          "type": "object",
          "description": "The complete clip as the document stores it: its ID, unused in the document; type audio; the ID of an audio asset; startUs and durationUs in composition time; sourceStartUs; volume; fadeInUs and fadeOutUs."
        }
      },
      "required": [
        "index",
        "clip"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_audio_clip",
    "description": "Removes one audio clip, of the composition's clips or of a scene's; its asset stays declared. Refused with unknown-clip. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes one audio clip.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        }
      },
      "required": [
        "clipId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_volume",
    "description": "Sets the volume of one audio clip: a linear factor of the amplitude from 0 (silent) to 1 (the source as it is); it never amplifies. Refused with invalid-argument outside 0 to 1 and unknown-clip. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"volume\":0.5}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the volume of one audio clip; 0 is silent.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        },
        "volume": {
          "type": "number",
          "description": "The linear factor of the amplitude, from 0 (silent) to 1 (the source as it is) inclusive; it never amplifies. A fraction is kept as it is, and -0 becomes 0.",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "clipId",
        "volume"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_fades",
    "description": "Sets the linear fade-in and fade-out of one audio clip: the clip rises from silence to its volume over the first fadeInUs of its lifetime and falls back to silence over the last fadeOutUs, counted in its whole lifetime even where its scene or the composition cuts it. 0 is no fade, and both together take at most the clip's durationUs. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, and invalid-result when the fades exceed the duration. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"fadeInUs\":500000,\"fadeOutUs\":2000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets the linear fade-in and fade-out of one audio clip.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        },
        "fadeInUs": {
          "type": "integer",
          "description": "How long the clip rises from silence to its volume at its start, in integer microseconds of the lifetime of the clip, 0 for none; it is never rounded, and -0 becomes 0. Both fades together take at most the clip's durationUs.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fadeOutUs": {
          "type": "integer",
          "description": "How long the clip falls from its volume to silence at its end, in integer microseconds of the lifetime of the clip, 0 for none; it is never rounded, and -0 becomes 0. Both fades together take at most the clip's durationUs.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "fadeInUs",
        "fadeOutUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_source",
    "description": "Points one audio clip at an audio asset the document declares, which may be the one it has, and sets the source time heard at the clip's start; it then plays at speed 1 and keeps its lifetime. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Source times count from the first sample. To move a clip in time, run remove_audio_clip and add_audio_clip in one transaction. The part heard must lie inside the source: describe_document reports an audio asset's sourceDurationUs when the host knows it. Refused with invalid-argument, unknown-clip, unknown-asset, asset-type-mismatch when the asset is not audio, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"assetId\":\"asset-audio\",\"sourceStartUs\":1000000}",
    "inputSchema": {
      "type": "object",
      "description": "Points one audio clip at an audio asset and the source time it plays from; its lifetime stays.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of an audio clip of the document.",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "description": "The ID of an audio asset the document declares; it may be the one it has.",
          "minLength": 1
        },
        "sourceStartUs": {
          "type": "integer",
          "description": "The source time heard at the start of the clip, in integer microseconds from the first sample; it is never rounded, and -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "assetId",
        "sourceStartUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_scene",
    "description": "Inserts one complete scene at an index of the sequence. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, less the duration of a transition between them, and the composition's durationUs is the sum of the scenes' durations less those of the scene transitions, which every scene command keeps. A command that would break a transition — remove or move one of its scenes or nodes, or shorten one so that it no longer fits — is refused with transition-in-use and the IDs of those transitions: remove them first, in the same transaction. The scene is given exactly as the document stores it: an ID unused in the document, durationUs (at least 1), its nodes from the bottom layer to the top (each as add_node takes one), and its audio clips (each as add_scene_audio_clip takes one), every ID unused in the document. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with index-out-of-range, id-in-use with the IDs already taken, and invalid-result when the scene is not one the document can hold; a scene with video or sound also with media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":1,\"scene\":{\"id\":\"scene-outro\",\"durationUs\":3000000,\"nodes\":[{\"id\":\"node-outro-background\",\"type\":\"background\",\"startUs\":0,\"durationUs\":3000000,\"color\":\"#000000\",\"animations\":[]}],\"clips\":[],\"transitions\":[]}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete scene into the sequence; the composition's durationUs grows by the scene's.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The scene's index in the sequence after the insertion, from 0 (the first scene) to the number of scenes (after the last).",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scene": {
          "type": "object",
          "description": "The complete scene as the document stores it: its ID, durationUs, nodes, and clips, every ID of it chosen by the caller and unused in the document, every time in it scene time."
        }
      },
      "required": [
        "index",
        "scene"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_scene",
    "description": "Removes one scene with its nodes and clips; its assets stay declared. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, less the duration of a transition between them, and the composition's durationUs is the sum of the scenes' durations less those of the scene transitions, which every scene command keeps. A command that would break a transition — remove or move one of its scenes or nodes, or shorten one so that it no longer fits — is refused with transition-in-use and the IDs of those transitions: remove them first, in the same transaction. Every later scene starts earlier by the removed scene's duration. Refused with unknown-scene, and last-scene for the only scene of the document. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-outro\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a scene with its nodes and clips; the composition's durationUs shrinks by the scene's. The last scene cannot be removed.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        }
      },
      "required": [
        "sceneId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "duplicate_scene",
    "description": "Copies one scene, with its nodes, animations, and clips, directly after it. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, less the duration of a transition between them, and the composition's durationUs is the sum of the scenes' durations less those of the scene transitions, which every scene command keeps. A command that would break a transition — remove or move one of its scenes or nodes, or shorten one so that it no longer fits — is refused with transition-in-use and the IDs of those transitions: remove them first, in the same transaction. The copy's IDs derive from newSceneId: the node at index i becomes <newSceneId>-n<i>, its child at index j <newSceneId>-n<i>-c<j>, an animation <owner>-a-<property>, and the clip at index k <newSceneId>-k<k>. Refused with invalid-argument for an ID not of the document's form, unknown-scene, id-in-use with the derived IDs already taken, and invalid-result; a scene with video or sound also with media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-main\",\"newSceneId\":\"scene-again\"}",
    "inputSchema": {
      "type": "object",
      "description": "Copies a scene, with its nodes and clips, directly after it; the composition's durationUs grows by the scene's.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "newSceneId": {
          "type": "string",
          "description": "The ID of the copy, unused in the document. Every other ID of the copy derives from it: the node at index i becomes `<newSceneId>-n<i>`, its child at index j `<newSceneId>-n<i>-c<j>`, an animation `<owner>-a-<property>`, a text animation at index t `<owner>-t<t>`, and the clip at index k `<newSceneId>-k<k>`.",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "sceneId",
        "newSceneId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "reorder_scene",
    "description": "Moves one scene to another index of the sequence: 0 is the first scene. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, less the duration of a transition between them, and the composition's durationUs is the sum of the scenes' durations less those of the scene transitions, which every scene command keeps. A command that would break a transition — remove or move one of its scenes or nodes, or shorten one so that it no longer fits — is refused with transition-in-use and the IDs of those transitions: remove them first, in the same transaction. Nothing inside the scene moves, since its times are its own. Refused with unknown-scene and index-out-of-range. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-outro\",\"index\":0}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a scene to another place in the sequence; nothing inside it moves.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The scene's index in the sequence after the move, from 0 (the first) to the number of scenes minus 1 (the last).",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sceneId",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_scene_duration",
    "description": "Sets how long one scene lasts. Scenes play one after another in their order; a scene has no start of its own, it starts where the scene before it ends, less the duration of a transition between them, and the composition's durationUs is the sum of the scenes' durations less those of the scene transitions, which every scene command keeps. A command that would break a transition — remove or move one of its scenes or nodes, or shorten one so that it no longer fits — is refused with transition-in-use and the IDs of those transitions: remove them first, in the same transaction. Every later scene starts earlier or later by the change, and whatever in the scene lies past its new end is cut; nothing moves inside it. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-scene, invalid-result when the composition would last too long, and, when a video or sound would then be heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-main\",\"durationUs\":8000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how long a scene lasts; the composition's durationUs changes by the same amount, and every later scene starts that much earlier or later.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "durationUs": {
          "type": "integer",
          "description": "The new duration of the scene, in integer microseconds, at least 1; never rounded. What lies past it in the scene is cut.",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sceneId",
        "durationUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_node_to_scene",
    "description": "Moves one node of a scene, with its animations and, for a group, its children, into the nodes of a scene at a layer index: 0 is the bottom layer. Its startUs, durationUs, and keyframe times stay the same scene times, so it plays at the same moment of its new scene. Within its own scene it acts as reorder_node. A child of a group moves only with its group. Refused with unknown-node, unsupported-node for a child of a group, unknown-scene, index-out-of-range, and, when a video would then be seen or heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"sceneId\":\"scene-outro\",\"index\":1}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a node of a scene's own list, with its animations and children, into the list of a scene; its times stay the same scene times.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a node of a scene, not a child of a group.",
          "minLength": 1
        },
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The node's index in the nodes of that scene after the move, from 0 (the bottom layer) to their number (the top), or their number minus 1 within its own scene.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodeId",
        "sceneId",
        "index"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_scene_audio_clip",
    "description": "Adds one complete audio clip at an index of a scene's clips, in the time of that scene: it moves with its scene, which cuts it at its end. The clip is given as add_audio_clip takes one: an ID unused in the document, type \"audio\", the ID of an audio asset, startUs and durationUs in scene time, sourceStartUs, volume from 0 to 1, fadeInUs and fadeOutUs. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. The source must be long enough for the part that is heard: describe_document reports an audio asset's sourceDurationUs when the host knows it. Refused with unknown-scene, index-out-of-range, id-in-use, invalid-result, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-main\",\"index\":0,\"clip\":{\"id\":\"clip-scene-voice\",\"type\":\"audio\",\"assetId\":\"asset-audio\",\"startUs\":1000000,\"durationUs\":2000000,\"sourceStartUs\":0,\"volume\":1,\"fadeInUs\":0,\"fadeOutUs\":500000}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete audio clip into a scene's clips, in scene time.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The clip's index in the scene's clips after the insertion, from 0 to their number. Clips are mixed whatever their order.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clip": {
          "type": "object",
          "description": "The complete clip as the document stores it: its ID, unused in the document; type audio; the ID of an audio asset; startUs and durationUs in scene time; sourceStartUs; volume; fadeInUs and fadeOutUs."
        }
      },
      "required": [
        "sceneId",
        "index",
        "clip"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_clip",
    "description": "Moves one clip — a node of any type, or an audio clip — to a new start, keeping its duration and, for a video or an audio clip, its source: it plays the same, only earlier or later. A node's keyframes and a captions node's words move with it, and a group's children with theirs, so its animation keeps its place in the clip; set_node_lifetime is the command that changes when a node is shown without moving keyframes. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, invalid-result when a keyframe or a child would leave the times of the document, and, when a video or sound would then be seen or heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"startUs\":1000000}",
    "inputSchema": {
      "type": "object",
      "description": "Moves a clip to a new start, keeping its duration and its source; a node's keyframes, and a group's children with theirs, move by the same amount.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "startUs": {
          "type": "integer",
          "description": "The new start of the clip. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "startUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "trim_clip_start",
    "description": "Moves the start of one clip and keeps its end, as dragging the left edge on a timeline: startUs becomes the given time, durationUs changes by the opposite amount, and a video's or an audio clip's sourceStartUs moves by the same amount, so what remains plays exactly where it did. No keyframe moves, and an audio clip's fades stay at its edges. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, time-outside-clip when the start would reach the end, source-range-exceeded when the source would start before its first instant or run past its end, invalid-result when the fades no longer fit, and media-facts-missing. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"clip-audio\",\"startUs\":2000000}",
    "inputSchema": {
      "type": "object",
      "description": "Moves the start of a clip and keeps its end; a video's or an audio clip's sourceStartUs moves by the same amount, so what remains plays where it did.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "startUs": {
          "type": "integer",
          "description": "The new start of the clip, before its end. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "startUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "trim_clip_end",
    "description": "Moves the end of one clip and keeps its start, as dragging the right edge on a timeline: durationUs becomes endUs minus startUs. No keyframe moves. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, time-outside-clip when the end would reach the start, invalid-result when an audio clip's fades no longer fit, and, when a video or sound would then be seen or heard further, media-facts-missing and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"endUs\":6000000}",
    "inputSchema": {
      "type": "object",
      "description": "Moves the end of a clip and keeps its start.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "endUs": {
          "type": "integer",
          "description": "The new end of the clip, exclusive, after its start. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "clipId",
        "endUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "split_clip",
    "description": "Cuts one clip at atUs into two that meet there, as a razor on a timeline: the first keeps its ID and ends at atUs, the second gets newClipId, starts at atUs, and is placed directly after the first (for a node, the layer right above it). A video or audio clip's second half continues its source where the first stops. Every animation is copied to the second half unchanged, as <newClipId>-a-<property>, and every text animation as <newClipId>-t<t>, one of phase in as an accent at the start of the whole, so both halves look exactly like the whole; a text with a text animation of phase out is refused with split-not-exact. A group is not split. A clip that is heard (an audio clip, or a video above volume 0) is split only at a multiple of 125 microseconds from its start and outside its fades, so the halves sound exactly like the whole; the first half then has no fade-out and the second no fade-in. join_clips undoes it. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-clip, unsupported-node for a group, time-outside-clip when atUs is not strictly inside the clip, split-not-exact, id-in-use with the IDs already taken, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"atUs\":5000000,\"newClipId\":\"node-title-tail\"}",
    "inputSchema": {
      "type": "object",
      "description": "Cuts a clip into two that meet at atUs; the second half is placed directly after the first.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The stable ID of a clip: a node of any type, a child of a group included, or an audio clip of the composition or of a scene.",
          "minLength": 1
        },
        "atUs": {
          "type": "integer",
          "description": "The time of the cut, strictly between the start and the end of the clip. In integer microseconds of the time of the clip's scene, or composition time for a composition clip; never rounded. -0 becomes 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "newClipId": {
          "type": "string",
          "description": "The ID of the second half, unused in the document. Each copied animation becomes `<newClipId>-a-<property>`, and the text animation at index t `<newClipId>-t<t>`.",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "clipId",
        "atUs",
        "newClipId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "join_clips",
    "description": "Joins two halves of a split back into one clip: nextClipId must be directly after clipId in the same list, start where it ends, and be exactly what split_clip would make of the joined clip (same fields, its source continuing, its animations those of the first under its own ID). The joined clip keeps clipId and the second is removed. A clip is named by its ID: a node (a child of a group included) or an audio clip of the composition or of a scene; to move a clip to another layer use reorder_node, to another scene move_node_to_scene. A change that would break a clip transition is refused with transition-in-use and its ID. Refused with unknown-clip, unsupported-node for a group, clips-not-joinable, invalid-result, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"clipId\":\"node-title\",\"nextClipId\":\"node-title-tail\"}",
    "inputSchema": {
      "type": "object",
      "description": "Joins two halves of a split back into one clip.",
      "properties": {
        "clipId": {
          "type": "string",
          "description": "The ID of the first half.",
          "minLength": 1
        },
        "nextClipId": {
          "type": "string",
          "description": "The ID of the second half: directly after the first in the same list, exactly as split_clip made it.",
          "minLength": 1
        }
      },
      "required": [
        "clipId",
        "nextClipId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_scene_transition",
    "description": "Adds a transition on the boundary between a scene and the scene directly after it: during durationUs both play, the outgoing one in its last durationUs and the incoming one in its first, combined by the effect — crossfade, fade-through-color with a colour, slide, wipe, or push with a direction (left, right, up, down), zoom with a fromScale, or iris with a center. Every later scene starts durationUs earlier and the composition's durationUs shrinks by as much; no time inside a scene moves. A boundary takes at most one transition. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with index-out-of-range, id-in-use, and invalid-result when the scenes are not adjacent, the boundary has a transition already, or the transition does not fit its scenes. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":0,\"transition\":{\"id\":\"transition-outro\",\"fromSceneId\":\"scene-main\",\"toSceneId\":\"scene-outro\",\"durationUs\":500000,\"effect\":{\"kind\":\"crossfade\"},\"easing\":{\"kind\":\"linear\"}}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a transition on the boundary between two adjacent scenes: the incoming scene starts durationUs earlier and overlaps the end of the outgoing one, and the composition's durationUs shrinks by as much.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The transition's index in the composition's transitions after the insertion, from 0 to their number; their order has no meaning.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transition": {
          "type": "object",
          "description": "The complete transition as the document stores it: its ID, unused in the document; fromSceneId, the outgoing scene; toSceneId, the scene directly after it; durationUs, at most the duration of either scene; and effect. An effect is an object with its kind, the same for scene and clip transitions: {\"kind\":\"crossfade\"} (the incoming side fades in over the outgoing one), {\"kind\":\"fade-through-color\",\"color\":\"#rrggbb\"} (the outgoing side fades out to the colour, then the incoming one fades in from it), {\"kind\":\"slide\",\"direction\":\"left\"|\"right\"|\"up\"|\"down\"} (the incoming side slides in, moving in its direction), {\"kind\":\"wipe\",\"direction\":…} (an edge moving in its direction uncovers the incoming side), {\"kind\":\"push\",\"direction\":…} (the incoming side slides in and pushes the outgoing one out the other way), {\"kind\":\"zoom\",\"fromScale\":0.5} (the incoming side fades in while it scales from fromScale, 0 to 16, to its size about the centre of the frame), or {\"kind\":\"iris\",\"center\":{\"x\":500,\"y\":500}} (a circle opens from a point given in per mille of the frame, integers 0 to 1000). The frame of a clip transition is the canvas, in the space of the two nodes' parent; between clips, the colour of fade-through-color covers the frame directly below the lower clip, and when the outgoing clip lies above the incoming one, a slide moves it out, a wipe and an iris cut it away, and a crossfade and a zoom fade it out, so the incoming clip is uncovered."
        }
      },
      "required": [
        "index",
        "transition"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_clip_transition",
    "description": "Adds a transition between two clips of one layer of a scene — two children of one parent, neither a background — whose lifetimes already overlap by exactly durationUs: the outgoing node ends durationUs after the incoming one starts. During the overlap the effect combines them in the frame of the canvas — crossfade, fade-through-color, slide, wipe, push, zoom, or iris, as for scenes; nothing moves in time. Make the overlap first with move_clip, trim_clip_start, or trim_clip_end, or call add_clip_transition_at_cut for two clips that meet end to end. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with unknown-scene, index-out-of-range, id-in-use, and invalid-result when the nodes are not siblings of this scene, a background, or do not overlap by exactly durationUs. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"sceneId\":\"scene-main\",\"index\":0,\"transition\":{\"id\":\"transition-title\",\"fromNodeId\":\"node-title\",\"toNodeId\":\"node-custom-html\",\"durationUs\":500000,\"effect\":{\"kind\":\"crossfade\"},\"easing\":{\"kind\":\"linear\"}}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a transition between two clips of one layer of a scene, two children of one parent whose lifetimes already overlap by exactly its durationUs; nothing moves.",
      "properties": {
        "sceneId": {
          "type": "string",
          "description": "The stable ID of a scene of the document.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The transition's index in the scene's transitions after the insertion, from 0 to their number; their order has no meaning.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transition": {
          "type": "object",
          "description": "The complete transition as the document stores it: its ID, unused in the document; fromNodeId, the outgoing node, which ends durationUs after the incoming one starts; toNodeId, the incoming node; durationUs; and effect. An effect is an object with its kind, the same for scene and clip transitions: {\"kind\":\"crossfade\"} (the incoming side fades in over the outgoing one), {\"kind\":\"fade-through-color\",\"color\":\"#rrggbb\"} (the outgoing side fades out to the colour, then the incoming one fades in from it), {\"kind\":\"slide\",\"direction\":\"left\"|\"right\"|\"up\"|\"down\"} (the incoming side slides in, moving in its direction), {\"kind\":\"wipe\",\"direction\":…} (an edge moving in its direction uncovers the incoming side), {\"kind\":\"push\",\"direction\":…} (the incoming side slides in and pushes the outgoing one out the other way), {\"kind\":\"zoom\",\"fromScale\":0.5} (the incoming side fades in while it scales from fromScale, 0 to 16, to its size about the centre of the frame), or {\"kind\":\"iris\",\"center\":{\"x\":500,\"y\":500}} (a circle opens from a point given in per mille of the frame, integers 0 to 1000). The frame of a clip transition is the canvas, in the space of the two nodes' parent; between clips, the colour of fade-through-color covers the frame directly below the lower clip, and when the outgoing clip lies above the incoming one, a slide moves it out, a wipe and an iris cut it away, and a crossfade and a zoom fade it out, so the incoming clip is uncovered."
        }
      },
      "required": [
        "sceneId",
        "index",
        "transition"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_transition",
    "description": "Removes a scene or clip transition. Without a scene transition the incoming scene starts where the outgoing one ends again: every later scene starts durationUs later and the composition grows by as much. Without a clip transition the two clips stay where they are and simply overlap. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Refused with unknown-transition. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"transitionId\":\"transition-outro\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a transition. A scene transition's duration is given back: the incoming scene starts that much later, and the composition's durationUs grows by as much. A clip transition's clips stay where they are.",
      "properties": {
        "transitionId": {
          "type": "string",
          "description": "The stable ID of a scene transition or a clip transition of the document.",
          "minLength": 1
        }
      },
      "required": [
        "transitionId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_transition_duration",
    "description": "Sets how long a transition lasts. A longer scene transition makes the incoming scene, and every later one, start earlier, and the composition shorter, by the change. A longer clip transition makes the outgoing clip last longer by the change, so that it still ends durationUs after the incoming one starts: a video then shows more of its source. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-transition, invalid-result when it would not fit its sides, media-facts-missing, and source-range-exceeded. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"transitionId\":\"transition-outro\",\"durationUs\":1000000}",
    "inputSchema": {
      "type": "object",
      "description": "Sets how long a transition lasts. For a scene transition, the incoming scene and every later one start earlier or later by the change, and the composition's durationUs changes by the opposite amount. For a clip transition, the outgoing clip's durationUs changes by the same amount, so that it still ends durationUs after the incoming clip starts.",
      "properties": {
        "transitionId": {
          "type": "string",
          "description": "The stable ID of a scene transition or a clip transition of the document.",
          "minLength": 1
        },
        "durationUs": {
          "type": "integer",
          "description": "The new duration of the transition, in integer microseconds, at least 1; at most the duration of either side, and the transitions into and out of one side together at most its duration.",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "transitionId",
        "durationUs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_transition_effect",
    "description": "Replaces how a transition combines its two sides with a complete effect: {\"kind\":\"crossfade\"}, {\"kind\":\"fade-through-color\",\"color\":\"#000000\"}, {\"kind\":\"slide\",\"direction\":\"left\"}, {\"kind\":\"wipe\",\"direction\":\"up\"}, {\"kind\":\"push\",\"direction\":\"right\"}, {\"kind\":\"zoom\",\"fromScale\":0.5}, or {\"kind\":\"iris\",\"center\":{\"x\":500,\"y\":500}}; directions are left, right, up, and down, the way the incoming side moves. Scene and clip transitions take the same effects. No time changes. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Refused with unknown-transition and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"transitionId\":\"transition-outro\",\"effect\":{\"kind\":\"wipe\",\"direction\":\"left\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces how a transition combines its two sides; no time changes.",
      "properties": {
        "transitionId": {
          "type": "string",
          "description": "The stable ID of a scene transition or a clip transition of the document.",
          "minLength": 1
        },
        "effect": {
          "type": "object",
          "description": "The complete new effect. An effect is an object with its kind, the same for scene and clip transitions: {\"kind\":\"crossfade\"} (the incoming side fades in over the outgoing one), {\"kind\":\"fade-through-color\",\"color\":\"#rrggbb\"} (the outgoing side fades out to the colour, then the incoming one fades in from it), {\"kind\":\"slide\",\"direction\":\"left\"|\"right\"|\"up\"|\"down\"} (the incoming side slides in, moving in its direction), {\"kind\":\"wipe\",\"direction\":…} (an edge moving in its direction uncovers the incoming side), {\"kind\":\"push\",\"direction\":…} (the incoming side slides in and pushes the outgoing one out the other way), {\"kind\":\"zoom\",\"fromScale\":0.5} (the incoming side fades in while it scales from fromScale, 0 to 16, to its size about the centre of the frame), or {\"kind\":\"iris\",\"center\":{\"x\":500,\"y\":500}} (a circle opens from a point given in per mille of the frame, integers 0 to 1000). The frame of a clip transition is the canvas, in the space of the two nodes' parent; between clips, the colour of fade-through-color covers the frame directly below the lower clip, and when the outgoing clip lies above the incoming one, a slide moves it out, a wipe and an iris cut it away, and a crossfade and a zoom fade it out, so the incoming clip is uncovered."
        }
      },
      "required": [
        "transitionId",
        "effect"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_transition_easing",
    "description": "Sets how the progress of a transition's effect moves through its overlap: ease-in-out, for example, starts and ends the effect gently; a curve that overshoots is held within the two ends of each motion, and fade-through-color eases each of its halves. An easing is an object with its kind: {\"kind\":\"linear\"} (a constant speed), {\"kind\":\"hold\"} (the value stays until the next keyframe, then jumps), {\"kind\":\"ease-in\"} (starts slowly), {\"kind\":\"ease-out\"} (slows down at the end), {\"kind\":\"ease-in-out\"} (both), {\"kind\":\"cubic-bezier\",\"x1\":0.34,\"y1\":1.56,\"x2\":0.64,\"y2\":1} (the curve of CSS cubic-bezier(); x1 and x2 from 0 to 1, y1 and y2 from -1 to 2, where a y outside 0 to 1 overshoots and the value is held within the range of its property), or {\"kind\":\"steps\",\"count\":4,\"position\":\"end\"} (count equal jumps, 1 to 1000, at the end or the start of each interval, as CSS steps()). No time changes. A scene transition overlaps two adjacent scenes: the incoming scene starts durationUs before the outgoing one ends, so the composition is that much shorter, and at most two scenes play at once. A clip transition overlaps two clips of one layer, two children of one parent, whose lifetimes overlap by exactly its durationUs; it moves nothing. A transition is at most as long as either side, and the two transitions of one side together at most as long as it. describe_document lists the transitions. Refused with unknown-transition and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"transitionId\":\"transition-outro\",\"easing\":{\"kind\":\"ease-in-out\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces how the progress of a transition moves through its overlap; no time changes.",
      "properties": {
        "transitionId": {
          "type": "string",
          "description": "The stable ID of a scene transition or a clip transition of the document.",
          "minLength": 1
        },
        "easing": {
          "type": "object",
          "description": "The complete new easing. An easing is an object with its kind: {\"kind\":\"linear\"} (a constant speed), {\"kind\":\"hold\"} (the value stays until the next keyframe, then jumps), {\"kind\":\"ease-in\"} (starts slowly), {\"kind\":\"ease-out\"} (slows down at the end), {\"kind\":\"ease-in-out\"} (both), {\"kind\":\"cubic-bezier\",\"x1\":0.34,\"y1\":1.56,\"x2\":0.64,\"y2\":1} (the curve of CSS cubic-bezier(); x1 and x2 from 0 to 1, y1 and y2 from -1 to 2, where a y outside 0 to 1 overshoots and the value is held within the range of its property), or {\"kind\":\"steps\",\"count\":4,\"position\":\"end\"} (count equal jumps, 1 to 1000, at the end or the start of each interval, as CSS steps())."
        }
      },
      "required": [
        "transitionId",
        "easing"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_caption_words",
    "description": "Replaces every word of a captions node with a new list, as for a new transcription: each word {text, startUs, durationUs}, in the order they are spoken, each starting no earlier than the one before it ends; text is at least one character and no white space. A captions node shows timed words in a style: the runtime breaks them into lines of at most maxLineLength characters and every maxLines lines into a page, from the document alone; a page is shown from its first word until the next page starts, and the word being spoken takes highlightColor. Words are in scene time, like keyframes. describe_document shows the words and the style; a word is addressed by its index in words, from 0. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not captions, and invalid-result when a word is not one the document can hold or two words overlap. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-captions\",\"words\":[{\"text\":\"Made\",\"startUs\":0,\"durationUs\":300000},{\"text\":\"with\",\"startUs\":300000,\"durationUs\":200000},{\"text\":\"Kadrion\",\"startUs\":500000,\"durationUs\":600000}]}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces every word of a captions node, as a new transcription.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a captions node.",
          "minLength": 1
        },
        "words": {
          "type": "array",
          "description": "Every word of the node, in the order they are spoken; an empty list shows nothing. A word is {text, startUs, durationUs}: text is at least one character and no white space; startUs is the scene time, in integer microseconds, at which it is spoken, and durationUs how long, at least 1. A word starts no earlier than the word before it ends. Words are in scene time, like keyframes: moving the node moves them, trimming it does not.",
          "items": {
            "type": "object",
            "description": "One word, as the document stores it."
          }
        }
      },
      "required": [
        "nodeId",
        "words"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_caption_word",
    "description": "Replaces one word of a captions node with a complete word {text, startUs, durationUs}: a corrected text, a new timing, or both; it must still start no earlier than the word before it ends and end no later than the next one starts. A captions node shows timed words in a style: the runtime breaks them into lines of at most maxLineLength characters and every maxLines lines into a page, from the document alone; a page is shown from its first word until the next page starts, and the word being spoken takes highlightColor. Words are in scene time, like keyframes. describe_document shows the words and the style; a word is addressed by its index in words, from 0. Times are integer microseconds (1 second is 1000000), never rounded: a node's lifetime, a keyframe, and a scene's clip are in the time of its scene, from 0 at the scene's start; the composition's own clips are in composition time. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not captions, index-out-of-range, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-captions\",\"index\":2,\"word\":{\"text\":\"Kadrion\",\"startUs\":500000,\"durationUs\":600000}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces one word of a captions node: its text, its timing, or both.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a captions node.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The index of the word in the node's words, from 0.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "word": {
          "type": "object",
          "description": "The complete new word. A word is {text, startUs, durationUs}: text is at least one character and no white space; startUs is the scene time, in integer microseconds, at which it is spoken, and durationUs how long, at least 1. A word starts no earlier than the word before it ends. Words are in scene time, like keyframes: moving the node moves them, trimming it does not."
        }
      },
      "required": [
        "nodeId",
        "index",
        "word"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_caption_style",
    "description": "Replaces the style of a captions node with a complete style {fontSize, lineHeight, color, highlightColor, align, verticalAlign, maxLineLength, maxLines}: its size and colours, where its lines lie in its box, and how many characters fit on a line and lines on a page, which changes how the words are grouped. No word and no time changes. A captions node shows timed words in a style: the runtime breaks them into lines of at most maxLineLength characters and every maxLines lines into a page, from the document alone; a page is shown from its first word until the next page starts, and the word being spoken takes highlightColor. Words are in scene time, like keyframes. describe_document shows the words and the style; a word is addressed by its index in words, from 0. Lengths and coordinates are composition pixels, rounded to integers. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not captions, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-captions\",\"style\":{\"fontSize\":64,\"lineHeight\":80,\"color\":\"#ffffff\",\"highlightColor\":\"#ffd400\",\"align\":\"center\",\"verticalAlign\":\"bottom\",\"maxLineLength\":24,\"maxLines\":2}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces how a captions node shows its words; no word and no time changes.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a captions node.",
          "minLength": 1
        },
        "style": {
          "type": "object",
          "description": "The complete new style: {fontSize, lineHeight, color, highlightColor, align, verticalAlign, maxLineLength, maxLines}. fontSize and lineHeight are integer composition pixels; color and highlightColor lowercase #rrggbb, the second for the word being spoken; align is left, center, or right; verticalAlign top, middle, or bottom; maxLineLength the most characters of a line, 1 to 1000, a space between two words counting as one; maxLines the most lines of a page, 1 to 100."
        }
      },
      "required": [
        "nodeId",
        "style"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_style",
    "description": "Replaces how a text node is drawn besides its font, size, and colour, with a complete style {stroke, shadow, box}; each part is {\"kind\":\"none\"} or: stroke {\"kind\":\"outside\", color, width}, an outline of width pixels (1 to 1000) drawn outside every glyph and under its fill; shadow {\"kind\":\"drop\", color, opacity, offset: {x, y}, blur}, a shadow of the glyphs and their outline moved by offset pixels (-1000 to 1000) and blurred by blur pixels (0 to 1000); box {\"kind\":\"solid\", color, opacity, padding, cornerRadius}, a filled box behind the text that reaches padding pixels beyond its lines on every side, with rounded corners, without moving the text. Colours are lowercase #rrggbb, opacities 0 to 1, lengths integers. Refused with invalid-argument, unknown-node, unsupported-node for a node that is not a text, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"style\":{\"stroke\":{\"kind\":\"outside\",\"color\":\"#000000\",\"width\":4},\"shadow\":{\"kind\":\"drop\",\"color\":\"#000000\",\"opacity\":0.6,\"offset\":{\"x\":4,\"y\":4},\"blur\":8},\"box\":{\"kind\":\"none\"}}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces the outline, the shadow, and the box of a text node.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a text node.",
          "minLength": 1
        },
        "style": {
          "type": "object",
          "description": "The complete style: {stroke, shadow, box}, each {kind: \"none\"} or: stroke {kind: \"outside\", color, width} for an outline of width pixels (1 to 1000) outside every glyph; shadow {kind: \"drop\", color, opacity, offset: {x, y}, blur} for a shadow moved by offset pixels (-1000 to 1000) and blurred by blur pixels (0 to 1000); box {kind: \"solid\", color, opacity, padding, cornerRadius} for a filled box behind the text, padding pixels beyond its lines on every side, with rounded corners. Colours are lowercase #rrggbb, opacities 0 to 1, and lengths integers."
        }
      },
      "required": [
        "nodeId",
        "style"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_text_animation",
    "description": "Animates the letters, words, or lines of a text node one after another, at an index of its text animations: {id, unit, phase, staggerUs, order, tracks}. unit is \"letter\" (a character as a reader sees it, an emoji or an accented letter included; white space is no letter), \"word\" (a run without white space), or \"line\" (a line of the text as written that holds a word). Every fragment runs the same tracks in its own time, which starts staggerUs (integer microseconds) after the fragment before it in the order: phase {\"kind\":\"in\"} starts the first fragment at the node's startUs, {\"kind\":\"out\"} ends the last fragment's last keyframe at the node's end, {\"kind\":\"accent\", startUs} starts the first at that scene time, which moves with the node. order is {\"kind\":\"forward\"}, {\"kind\":\"backward\"}, {\"kind\":\"center\"} (from the middle outwards), {\"kind\":\"edges\"} (from both ends inwards), or {\"kind\":\"random\", seed} (an unsigned 32-bit integer; the same seed gives the same order). tracks are at least one, at most one per property: {property, keyframes} with property \"opacity\" (factor 0 to 1), \"offset\" ({x, y} integer pixels from the fragment's place), \"scale\" ({x, y} factors about its centre), \"rotation\" (degrees about its centre), or \"color\" (#rrggbb that replaces the text's colour), and at least two keyframes {timeUs, value, easing} in ascending time, timeUs in the fragment's own time from 0. Before its first keyframe a fragment holds the first value, after its last the last, so an entrance usually starts at opacity 0. Several text animations combine in their order: opacities and scales multiply, offsets and rotations add, the last colour wins. A text with a text animation is drawn in fragments for its whole lifetime, without kerning between them. Refused with unknown-node, unsupported-node for a node that is not a text, index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"nodeId\":\"node-title\",\"index\":0,\"animation\":{\"id\":\"text-title-in\",\"unit\":\"letter\",\"phase\":{\"kind\":\"in\"},\"staggerUs\":50000,\"order\":{\"kind\":\"forward\"},\"tracks\":[{\"property\":\"opacity\",\"keyframes\":[{\"timeUs\":0,\"value\":0,\"easing\":{\"kind\":\"ease-out\"}},{\"timeUs\":300000,\"value\":1,\"easing\":{\"kind\":\"linear\"}}]},{\"property\":\"offset\",\"keyframes\":[{\"timeUs\":0,\"value\":{\"x\":0,\"y\":40},\"easing\":{\"kind\":\"ease-out\"}},{\"timeUs\":300000,\"value\":{\"x\":0,\"y\":0},\"easing\":{\"kind\":\"linear\"}}]}]}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a complete text animation into a text node's text animations.",
      "properties": {
        "nodeId": {
          "type": "string",
          "description": "The stable ID of a text node.",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "description": "The text animation's index in the node's text animations after the insertion.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "animation": {
          "type": "object",
          "description": "The complete text animation, its ID unused in the document. A text animation is {id, unit, phase, staggerUs, order, tracks}: unit \"letter\", \"word\", or \"line\"; phase {kind: \"in\"} (the first fragment starts at the node's start), {kind: \"out\"} (the last fragment ends at the node's end), or {kind: \"accent\", startUs} (the first fragment starts at that scene time); staggerUs the integer microseconds between two fragments that follow each other; order {kind: \"forward\"}, {kind: \"backward\"}, {kind: \"center\"}, {kind: \"edges\"}, or {kind: \"random\", seed} with an unsigned 32-bit integer seed; tracks at least one, at most one per property, each {property, keyframes} with property \"opacity\" (a factor 0 to 1), \"offset\" ({x, y} integer pixels added), \"scale\" ({x, y} factors about the fragment's centre), \"rotation\" (degrees added, about its centre), or \"color\" (#rrggbb that replaces the text's colour), and at least two keyframes {timeUs, value, easing} in ascending time, timeUs in the fragment's own time from 0."
        }
      },
      "required": [
        "nodeId",
        "index",
        "animation"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_text_animation",
    "description": "Removes one text animation of a text node with all its tracks; a text left without text animations is drawn in one piece again. Refused with unknown-animation when no text animation has the ID and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"textAnimationId\":\"text-title-in\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes one text animation with all its tracks.",
      "properties": {
        "textAnimationId": {
          "type": "string",
          "description": "The ID of a text animation of the document.",
          "minLength": 1
        }
      },
      "required": [
        "textAnimationId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_text_animation",
    "description": "Replaces a text animation with a complete new one of the same ID, as add_text_animation describes it: its unit, phase, staggerUs, order, and tracks. Refused with unknown-animation when no text animation has its id, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"animation\":{\"id\":\"text-title-in\",\"unit\":\"word\",\"phase\":{\"kind\":\"in\"},\"staggerUs\":120000,\"order\":{\"kind\":\"center\"},\"tracks\":[{\"property\":\"scale\",\"keyframes\":[{\"timeUs\":0,\"value\":{\"x\":0,\"y\":0},\"easing\":{\"kind\":\"ease-out\"}},{\"timeUs\":400000,\"value\":{\"x\":1,\"y\":1},\"easing\":{\"kind\":\"linear\"}}]}]}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces the text animation with the same ID.",
      "properties": {
        "animation": {
          "type": "object",
          "description": "The complete new text animation; its id names the text animation it replaces. A text animation is {id, unit, phase, staggerUs, order, tracks}: unit \"letter\", \"word\", or \"line\"; phase {kind: \"in\"} (the first fragment starts at the node's start), {kind: \"out\"} (the last fragment ends at the node's end), or {kind: \"accent\", startUs} (the first fragment starts at that scene time); staggerUs the integer microseconds between two fragments that follow each other; order {kind: \"forward\"}, {kind: \"backward\"}, {kind: \"center\"}, {kind: \"edges\"}, or {kind: \"random\", seed} with an unsigned 32-bit integer seed; tracks at least one, at most one per property, each {property, keyframes} with property \"opacity\" (a factor 0 to 1), \"offset\" ({x, y} integer pixels added), \"scale\" ({x, y} factors about the fragment's centre), \"rotation\" (degrees added, about its centre), or \"color\" (#rrggbb that replaces the text's colour), and at least two keyframes {timeUs, value, easing} in ascending time, timeUs in the fragment's own time from 0."
        }
      },
      "required": [
        "animation"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_template_input",
    "description": "Inserts an input into the template: {id, type, ...constraints, default}, with an ID unused in the document. A text has minLength and maxLength in code points, a number minimum and maximum, a boolean, a color (lowercase #rrggbb), an image, video, or audio only a default content hash, and a list minItems, maxItems, fields ({key, type, ...constraints}, no list among them), and a default whose items each list one {key, type, value} per field in their order; the default meets the constraints. Nothing reads a new input until a binding does; a boolean or a list is read by no binding yet. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into the {{inputId}} placeholders of the text of a text node, or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with index-out-of-range, id-in-use, and invalid-result when the input is not one the document can hold. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":0,\"input\":{\"id\":\"headline\",\"type\":\"text\",\"minLength\":1,\"maxLength\":40,\"default\":\"Kadrion\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts an input into the template section of the document.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The input's index in the template's inputs after the insertion, from 0 to their number.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input": {
          "type": "object",
          "description": "The complete input as the document stores it, with an ID unused in the document. An input is {id, type, ...constraints, default}: a text {minLength, maxLength} in code points, a number {minimum, maximum}, a boolean, a color (lowercase #rrggbb), an image, video, or audio (the default a content hash, sha256: and 64 hex digits), or a list {minItems, maxItems, fields, default}: each field {key, type, ...constraints} of a type other than list, and each item of the default a list with one {key, type, value} for each field, in their order. The default meets the constraints."
        }
      },
      "required": [
        "index",
        "input"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_template_input",
    "description": "Removes an input of the template. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into the {{inputId}} placeholders of the text of a text node, or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with unknown-input, and input-in-use with the IDs of the bindings that still use it, a placeholder included: remove them first, in the same transaction. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"inputId\":\"headline\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes an input that no binding and no placeholder uses.",
      "properties": {
        "inputId": {
          "type": "string",
          "description": "The stable ID of an input of the template.",
          "minLength": 1
        }
      },
      "required": [
        "inputId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_template_input",
    "description": "Replaces an input with a complete new one of the same ID — new constraints, a new default, or both — and writes its default into every property and asset bound to it, so that the preview shows it. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into the {{inputId}} placeholders of the text of a text node, or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with invalid-argument when input.id is not inputId, unknown-input, and invalid-result when the input is not one the document can hold or no longer fits its bindings. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"inputId\":\"headline\",\"input\":{\"id\":\"headline\",\"type\":\"text\",\"minLength\":1,\"maxLength\":40,\"default\":\"Launch day\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Replaces an input with a complete new one of the same ID, and writes its default into every property and asset bound to it.",
      "properties": {
        "inputId": {
          "type": "string",
          "description": "The stable ID of an input of the template.",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "description": "The complete new input, with the same ID. An input is {id, type, ...constraints, default}: a text {minLength, maxLength} in code points, a number {minimum, maximum}, a boolean, a color (lowercase #rrggbb), an image, video, or audio (the default a content hash, sha256: and 64 hex digits), or a list {minItems, maxItems, fields, default}: each field {key, type, ...constraints} of a type other than list, and each item of the default a list with one {key, type, value} for each field, in their order. The default meets the constraints."
        }
      },
      "required": [
        "inputId",
        "input"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_template_binding",
    "description": "Inserts a binding: {id, kind: \"property\", nodeId, property: \"text\" or \"color\", inputId}, {id, kind: \"placeholders\", nodeId}, {id, kind: \"asset\", assetId, inputId}, {id, kind: \"item-property\", nodeId, property, inputId, key}, or {id, kind: \"item-asset\", assetId, inputId, key}, with an ID unused in the document. The target of an input binding must already hold the input's default (set it first, in the same transaction); a text with placeholders names text or number inputs, or {{list.key}} text or number fields of a list that repeats the node; an item binding reads a field of a list whose repeat holds its node, or every use of its asset; and at most one binding writes a target. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into the {{inputId}} placeholders of the text of a text node, or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":0,\"binding\":{\"id\":\"bind-headline\",\"kind\":\"property\",\"nodeId\":\"node-title\",\"property\":\"text\",\"inputId\":\"headline\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a binding from an input to a property, the placeholders of a text, or an asset.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The binding's index in the template's bindings after the insertion, from 0 to their number; their order has no meaning.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "binding": {
          "type": "object",
          "description": "The complete binding as the document stores it, with an ID unused in the document. A binding is {id, kind: \"property\", nodeId, property, inputId} — the text of a text node takes a text input, the color of a text or a background a color input —, {id, kind: \"placeholders\", nodeId} — every {{inputId}} in the text of a text node stands for a text or number input, and inside a repeat over a list every {{list.key}} for a text or number field of the item —, {id, kind: \"asset\", assetId, inputId} — an image, video, or audio asset takes the content hash of an input of its type —, {id, kind: \"item-property\", nodeId, property, inputId, key} — inside a repeat over the list inputId, the text or color of the node takes the field key of the item of its copy —, or {id, kind: \"item-asset\", assetId, inputId, key} — an asset used only inside a repeat over the list becomes one asset per item, with the content hash of the field key. A property or asset bound to an input holds its default; at most one binding writes a target."
        }
      },
      "required": [
        "index",
        "binding"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_template_binding",
    "description": "Removes a binding; its property, text, or asset keeps the value it holds. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into the {{inputId}} placeholders of the text of a text node, or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with unknown-binding. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"bindingId\":\"bind-headline\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a binding; its target keeps the value it holds.",
      "properties": {
        "bindingId": {
          "type": "string",
          "description": "The stable ID of a binding of the template.",
          "minLength": 1
        }
      },
      "required": [
        "bindingId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_template_condition",
    "description": "Inserts a condition: {id, test: \"empty\" or \"not-empty\", targetId, inputId} for a text or list input, {id, test: \"true\" or \"false\", targetId, inputId} for a boolean, {id, test: \"equal-text\", targetId, inputId, value} for a text, or {id, test: \"equal-number\", targetId, inputId, value} for a number, with an ID unused in the document; targetId names a scene or a node. The template shows the target as it stands; an instantiation removes it, with everything in it and every transition that names it, when the test does not hold. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into the {{inputId}} placeholders of the text of a text node, or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":0,\"condition\":{\"id\":\"when-title\",\"test\":\"true\",\"targetId\":\"node-title\",\"inputId\":\"show-title\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a condition: its scene or node is kept only while its test of an input holds.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The condition's index in the template's conditions after the insertion, from 0 to their number; their order has no meaning.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "condition": {
          "type": "object",
          "description": "The complete condition as the document stores it, with an ID unused in the document. A condition is {id, test, targetId, inputId} with test \"empty\" or \"not-empty\" (a text or list input), \"true\" or \"false\" (a boolean input), or {id, test: \"equal-text\", targetId, inputId, value: a text} or {id, test: \"equal-number\", targetId, inputId, value: a number}; targetId names a scene or a node. When a test does not hold, instantiation removes the target with everything in it and every transition that names it; every condition of a target must hold."
        }
      },
      "required": [
        "index",
        "condition"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_template_condition",
    "description": "Removes a condition; its target is kept whatever the inputs. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into the {{inputId}} placeholders of the text of a text node, or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with unknown-condition. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"conditionId\":\"when-title\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a condition; its target is kept whatever the inputs.",
      "properties": {
        "conditionId": {
          "type": "string",
          "description": "The stable ID of a condition of the template.",
          "minLength": 1
        }
      },
      "required": [
        "conditionId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_template_repeat",
    "description": "Inserts a repeat: {id, duration: \"target\", targetId, inputId}, every copy as long as the target, or {id, duration: \"field\", targetId, inputId, key}, every copy as long as the number field key of its item names in microseconds, with an ID unused in the document; inputId names a list input and targetId a scene or a node. An instantiation replaces the target by one copy per item, in their order and one after the other, with IDs <id>--<index>: a scene copy follows the scene before it, a node copy starts where the one before it ends, its keyframes and words moved with it; transitions into a repeated scene meet its first copy and those out of it its last. A target is repeated once at most and never inside another repeated one, a repeated node is no side of a clip transition, and no ID of the document may have the form of a copy's. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into the {{inputId}} placeholders of the text of a text node, or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with index-out-of-range, id-in-use, and invalid-result. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"index\":0,\"repeat\":{\"id\":\"each-title\",\"duration\":\"target\",\"targetId\":\"node-title\",\"inputId\":\"people\"}}",
    "inputSchema": {
      "type": "object",
      "description": "Inserts a repeat: its scene or node is copied once for each item of a list.",
      "properties": {
        "index": {
          "type": "integer",
          "description": "The repeat's index in the template's repeats after the insertion, from 0 to their number; their order has no meaning.",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repeat": {
          "type": "object",
          "description": "The complete repeat as the document stores it, with an ID unused in the document. A repeat is {id, duration: \"target\", targetId, inputId} — every copy lasts the durationUs of the target — or {id, duration: \"field\", targetId, inputId, key} — every copy lasts the microseconds a number field of its item names; inputId names a list input, targetId a scene or a node. Instantiation replaces the target by one copy for each item, one after the other, with IDs <id>--<index>; a target is repeated once at most, never inside another repeated one, and a repeated node is no side of a clip transition."
        }
      },
      "required": [
        "index",
        "repeat"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_template_repeat",
    "description": "Removes a repeat; its target is shown once, as it stands. A template is a composition with inputs a host fills: instantiateTemplate makes a composition from it and their values, and the preview shows it with the defaults. A binding writes an input into a property of a node (the text of a text, the color of a text or a background), into the {{inputId}} placeholders of the text of a text node, or into an asset (its content hash), and inside a repeat over a list an item binding writes a field of the item of each copy; a property or asset bound to an input always holds its default. A condition keeps a scene or a node only while its test of an input holds; a repeat makes one copy of a scene or a node per item of a list, one after the other, with IDs <id>--<index>. Another command that changes a bound property, removes a bound node, a scene or node named by a condition or repeat, or a bound asset, spoils the placeholders of a bound text, or moves an item-bound node out of its repeat is refused with binding-in-use and the IDs of the bindings, conditions, or repeats: set the input with set_template_input instead, or remove them first. describe_document shows the template section. Refused with unknown-repeat, and invalid-result while an item binding or a {{list.key}} placeholder still needs it: remove those first, in the same transaction. The edit goes through the host's command bus, as the same edit in the editor does: the result is validated in full, a refused call changes nothing, and the host can undo it. Returns the edited document and the IDs the call created.\n\nExample arguments: {\"repeatId\":\"each-title\"}",
    "inputSchema": {
      "type": "object",
      "description": "Removes a repeat; its target is shown once, as it stands.",
      "properties": {
        "repeatId": {
          "type": "string",
          "description": "The stable ID of a repeat of the template.",
          "minLength": 1
        }
      },
      "required": [
        "repeatId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_clip_transition_at_cut",
    "description": "Adds a transition between two clips of one layer that meet end to end — the outgoing clip ends exactly where the incoming one starts — and makes their overlap in the same step: alignment start lets the outgoing clip last durationUs longer, end lets the incoming clip start durationUs earlier, and center does half of each (the incoming clip starts half of durationUs earlier, rounded down). A video or audio then shows more of its source; no keyframe moves. It is one step: all or nothing, and one undo reverts it. Refused with invalid-argument, unknown-node, not-a-cut when the clips do not meet in one scene, no-room-at-cut when the incoming clip would start before its scene, source-range-exceeded and media-facts-missing when a video lacks source at the cut, and whatever add_clip_transition, trim_clip_start, or trim_clip_end refuse; the error of a refused step names the index of its call. Returns the edited document and the IDs it created.\n\nExample arguments: {\"transition\":{\"id\":\"transition-cut\",\"fromNodeId\":\"node-title\",\"toNodeId\":\"node-custom-html\",\"durationUs\":500000,\"effect\":{\"kind\":\"push\",\"direction\":\"left\"}},\"alignment\":\"center\"}",
    "inputSchema": {
      "type": "object",
      "description": "Adds a transition between two clips of one layer that meet end to end, and makes their overlap in the same step.",
      "properties": {
        "transition": {
          "type": "object",
          "description": "The complete clip transition, as add_clip_transition takes it: its ID, unused in the document; fromNodeId, the clip that ends at the cut; toNodeId, the clip that starts there, a sibling of it; durationUs; and effect.",
          "properties": {
            "fromNodeId": {
              "type": "string",
              "description": "The clip that ends at the cut.",
              "minLength": 1
            },
            "toNodeId": {
              "type": "string",
              "description": "The clip that starts at the cut, a sibling of the other.",
              "minLength": 1
            },
            "durationUs": {
              "type": "integer",
              "description": "How long the transition lasts, in integer microseconds, at least 1.",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "fromNodeId",
            "toNodeId",
            "durationUs"
          ]
        },
        "alignment": {
          "type": "string",
          "description": "Where the transition lies against the cut: start (it starts at the cut; the outgoing clip lasts durationUs longer), center (it is centred on the cut; the incoming clip starts half of it earlier, rounded down, and the outgoing one lasts the rest longer), or end (it ends at the cut; the incoming clip starts durationUs earlier).",
          "enum": [
            "start",
            "center",
            "end"
          ]
        }
      },
      "required": [
        "transition",
        "alignment"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "run_transaction",
    "description": "Applies several edit tools in order as one step: all of them or none, and one undo reverts them all. Each call names an edit tool of this catalogue (not describe_document or run_transaction) and passes that tool's arguments; a later call sees the document the earlier ones produced. When one call is refused, nothing changes, and the error names the index of that call. Returns the edited document and the IDs the calls created.\n\nExample arguments: {\"calls\":[{\"name\":\"set_node_position\",\"arguments\":{\"nodeId\":\"node-title\",\"position\":{\"x\":120,\"y\":240}}},{\"name\":\"set_node_opacity\",\"arguments\":{\"nodeId\":\"node-title\",\"opacity\":0.5}}]}",
    "inputSchema": {
      "type": "object",
      "description": "The edit tool calls to apply as one step.",
      "properties": {
        "calls": {
          "type": "array",
          "description": "The calls, in the order they are applied; at least one.",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "One call of an edit tool.",
            "properties": {
              "name": {
                "type": "string",
                "description": "The name of an edit tool of this catalogue.",
                "enum": [
                  "set_node_position",
                  "set_node_opacity",
                  "set_text_content",
                  "add_node",
                  "remove_node",
                  "duplicate_node",
                  "reorder_node",
                  "set_node_scale",
                  "set_node_size",
                  "set_node_color",
                  "set_text_font_size",
                  "set_text_font",
                  "set_image_asset",
                  "add_asset",
                  "remove_asset",
                  "add_animation",
                  "remove_animation",
                  "set_opacity_keyframe",
                  "set_position_keyframe",
                  "set_scale_keyframe",
                  "add_keyframe",
                  "remove_keyframe",
                  "move_keyframe",
                  "set_keyframe_easing",
                  "set_keyframe_value",
                  "set_node_lifetime",
                  "set_node_fit",
                  "set_node_focus",
                  "set_node_rotation",
                  "set_node_origin",
                  "set_node_crop",
                  "set_node_corner_radius",
                  "set_video_asset",
                  "set_video_source",
                  "set_video_volume",
                  "add_audio_clip",
                  "remove_audio_clip",
                  "set_clip_volume",
                  "set_clip_fades",
                  "set_clip_source",
                  "add_scene",
                  "remove_scene",
                  "duplicate_scene",
                  "reorder_scene",
                  "set_scene_duration",
                  "move_node_to_scene",
                  "add_scene_audio_clip",
                  "move_clip",
                  "trim_clip_start",
                  "trim_clip_end",
                  "split_clip",
                  "join_clips",
                  "add_scene_transition",
                  "add_clip_transition",
                  "remove_transition",
                  "set_transition_duration",
                  "set_transition_effect",
                  "set_transition_easing",
                  "set_caption_words",
                  "set_caption_word",
                  "set_caption_style",
                  "set_text_style",
                  "add_text_animation",
                  "remove_text_animation",
                  "set_text_animation",
                  "add_template_input",
                  "remove_template_input",
                  "set_template_input",
                  "add_template_binding",
                  "remove_template_binding",
                  "add_template_condition",
                  "remove_template_condition",
                  "add_template_repeat",
                  "remove_template_repeat"
                ]
              },
              "arguments": {
                "type": "object",
                "description": "The arguments of that tool, exactly as its own input schema states."
              }
            },
            "required": [
              "name",
              "arguments"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "calls"
      ],
      "additionalProperties": false
    }
  }
]
