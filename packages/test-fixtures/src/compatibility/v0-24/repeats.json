              "type": "color",
              "value": "#12b76a"
            },
            {
              "key": "portrait",
              "type": "image",
              "value": "sha256:9b0906ce8964add6530e7f7ab5058cc1e7c588b1b4dd88729637b72186556da2"
            },
            {
              "key": "durationUs",
              "type": "number",
              "value": 1200000
            }
          ]
        ]
      }
    ],
    "bindings": [
      {
        "id": "bind-title",
        "kind": "placeholders",
        "nodeId": "intro-title"
      },
      {
        "id": "bind-accent",
        "kind": "item-property",
        "nodeId": "person-background",
        "property": "color",
        "inputId": "people",
        "key": "accent"
      },
      {
        "id": "bind-name",
        "kind": "placeholders",
        "nodeId": "person-name"
      },
      {
        "id": "bind-portrait",
        "kind": "item-asset",
        "assetId": "asset-portrait",
        "inputId": "people",
        "key": "portrait"
      },
      {
        "id": "bind-credit",
        "kind": "placeholders",
        "nodeId": "credit-line"
      }
    ],
    "conditions": [
      {
        "id": "when-intro",
        "test": "true",
        "targetId": "scene-intro",
        "inputId": "show-intro"
      },
      {
        "id": "when-no-one",
        "test": "empty",
        "targetId": "credits-empty",
        "inputId": "people"
      },
      {
        "id": "when-stars",
        "test": "equal-text",
        "targetId": "credits-stars",
        "inputId": "mood",
        "value": "stars"
      }
    ],
    "repeats": [
      {
        "id": "repeat-person",
        "duration": "field",
        "targetId": "scene-person",
        "inputId": "people",
        "key": "durationUs"
      },
      {
        "id": "repeat-credit",
        "duration": "target",
        "targetId": "credit-line",
        "inputId": "people"
      }
