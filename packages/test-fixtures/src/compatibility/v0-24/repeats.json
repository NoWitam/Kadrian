        "default": "Kadrion"
      },
      {
        "id": "show-intro",
        "type": "boolean",
        "default": true
      },
      {
        "id": "mood",
        "type": "text",
        "minLength": 0,
        "maxLength": 10,
        "default": "stars"
      },
      {
        "id": "people",
        "type": "list",
        "minItems": 0,
        "maxItems": 20,
        "fields": [
          {
            "key": "name",
            "type": "text",
            "minLength": 1,
            "maxLength": 24
          },
          {
            "key": "accent",
            "type": "color"
          },
          {
            "key": "portrait",
            "type": "image"
          },
          {
            "key": "durationUs",
            "type": "number",
            "minimum": 100000,
            "maximum": 10000000
          }
        ],
